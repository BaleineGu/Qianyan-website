---
import { siteConfig } from '@/data/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import InquiryModal from '@/components/InquiryModal.astro';
import FloatingActions from '@/components/FloatingActions.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  immersiveBackground?: boolean;
  homePage?: boolean;
}

const {
  title,
  description,
  overlayHeader = false,
  immersiveBackground = false,
  homePage = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const pageDescription = description ?? siteConfig.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <style is:global>
      /* Switzer is not bundled locally; Inter is the documented fallback */
      :root {
        --font-display: Inter, 'Helvetica Neue', Arial, sans-serif;
        --font-mono: 'IBM Plex Mono', 'Geist Mono', SFMono-Regular, Consolas, monospace;
      }
      body {
        font-family: var(--font-display);
      }
      .label-small,
      .font-mono {
        font-family: var(--font-mono);
      }
    </style>
  </head>
  <body class:list={['site-body min-h-screen flex flex-col text-ink antialiased', immersiveBackground && 'has-immersive-bg', homePage && 'is-home-page']}>
    {immersiveBackground ? <div class="site-immersive-bg" aria-hidden="true"></div> : null}
    <div class="site-page-shell flex flex-col flex-1 min-h-screen">
      <Header overlay={overlayHeader} />
      <main class="flex-1"><slot /></main>
      <Footer />
      <InquiryModal />
      <FloatingActions />
    </div>
  </body>
</html>
