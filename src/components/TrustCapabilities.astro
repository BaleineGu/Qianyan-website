---
import type { TrustItem } from '@/types/halo';
interface Props { items: TrustItem[]; markets?: string[] }
const { items, markets = [] } = Astro.props;
---
<section class="py-20 lg:py-28">
  <div class="section-container">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-900 mb-3">B2B Trust & Factory Capabilities</h2>
      <p class="text-lg text-gray-600">Practical engineering, customization, and export logistics for procurement teams.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
      {items.map((item) => (
        <div class="border-t-2 border-brand-500 pt-6">
          <h3 class="text-xl font-bold text-brand-900 mb-3">{item.title}</h3>
          <p class="text-gray-600 leading-relaxed">{item.description}</p>
        </div>
      ))}
    </div>
    {markets.length > 0 && (
      <div class="bg-brand-900 text-white p-8">
        <h3 class="text-lg font-bold mb-4">Target Markets</h3>
        <p class="text-gray-300">{markets.join(' · ')}</p>
      </div>
    )}
  </div>
</section>
