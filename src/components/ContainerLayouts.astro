---
import type { ContainerLayoutSize } from '@/types/halo';

interface Props {
  sizes: ContainerLayoutSize[];
}

const { sizes } = Astro.props;
---

<section class="py-20 lg:py-28 bg-white">
  <div class="section-container">
    <div class="text-center max-w-4xl mx-auto mb-12 lg:mb-16">
      <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-extrabold text-brand-900 tracking-wide uppercase mb-3">
        Container House – Various Sizes &amp; Real Layouts
      </h2>
      <p class="text-lg text-gray-600">
        Real project cases · Practical layouts · Customizable solutions
      </p>
    </div>

    <div class="flex flex-col gap-8 lg:gap-10">
      {
        sizes.map((size) => (
          <div class="flex flex-col xl:flex-row xl:items-stretch gap-5 lg:gap-6 border border-gray-100 bg-gray-50/60 p-4 sm:p-5">
            {/* Spec label */}
            <div class="xl:w-[180px] shrink-0 flex items-start">
              <div class="bg-brand-900 text-white px-4 py-3 text-center font-extrabold text-xl tracking-wide w-full">
                {size.label}
              </div>
            </div>

            {/* Floor plan */}
            <div class="xl:w-[320px] shrink-0 overflow-hidden bg-white border border-gray-200 min-h-[160px]">
              {size.floorPlan ? (
                <img
                  src={size.floorPlan}
                  alt={`${size.label} floor plan`}
                  class="w-full h-full object-contain"
                  loading="lazy"
                />
              ) : null}
            </div>

            {/* Interior photos */}
            <div class="flex-1 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4">
              {size.interiorPhotos?.length
                ? size.interiorPhotos.map((photo) => (
                    <div
                      class="interior-photo aspect-[4/3] overflow-hidden bg-white border border-gray-200 cursor-zoom-in"
                      data-preview-src={photo}
                    >
                      <img
                        src={photo}
                        alt={`${size.label} interior`}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  ))
                : [0, 1, 2].map(() => (
                    <div
                      class="aspect-[4/3] bg-white border-2 border-dashed border-gray-300"
                      aria-hidden="true"
                    />
                  ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div
  id="interior-photo-preview"
  class="interior-photo-preview fixed z-[100] pointer-events-none bg-white border border-gray-200 shadow-2xl p-1"
  aria-hidden="true"
>
  <img id="interior-photo-preview-img" src="" alt="" class="block max-w-full max-h-full object-contain" />
</div>

<style>
  .interior-photo-preview {
    opacity: 0;
    transform: scale(0.72);
    transform-origin: center center;
    visibility: hidden;
    transition:
      opacity 0.28s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.28s;
  }

  .interior-photo-preview.is-visible {
    opacity: 1;
    transform: scale(1);
    visibility: visible;
    transition:
      opacity 0.28s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .interior-photo-preview {
      transition: none;
    }
  }
</style>

<script>
  const preview = document.getElementById('interior-photo-preview');
  const previewImg = document.getElementById('interior-photo-preview-img') as HTMLImageElement | null;
  const MARGIN = 16;

  function positionPreview(target: HTMLElement) {
    if (!preview) return;
    const rect = target.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const maxW = Math.min(720, vw * 0.5);
    const maxH = vh * 0.8;
    preview.style.maxWidth = `${maxW}px`;
    preview.style.maxHeight = `${maxH}px`;
    if (previewImg) {
      previewImg.style.maxWidth = `${maxW - 8}px`;
      previewImg.style.maxHeight = `${maxH - 8}px`;
    }

    const pw = preview.offsetWidth;
    const ph = preview.offsetHeight;

    // Prefer right side of the hovered photo; fall back to left.
    let left = rect.right + MARGIN;
    if (left + pw > vw - MARGIN) {
      left = rect.left - MARGIN - pw;
    }
    if (left < MARGIN) {
      left = Math.max(MARGIN, Math.min(vw - pw - MARGIN, rect.right + MARGIN));
    }

    let top = rect.top + rect.height / 2 - ph / 2;
    top = Math.max(MARGIN, Math.min(vh - ph - MARGIN, top));

    preview.style.left = `${left}px`;
    preview.style.top = `${top}px`;
  }

  function showPreview(el: HTMLElement) {
    const src = el.dataset.previewSrc;
    if (!src || !preview || !previewImg) return;

    previewImg.src = src;
    preview.setAttribute('aria-hidden', 'false');

    const placeAndReveal = () => {
      requestAnimationFrame(() => {
        positionPreview(el);
        requestAnimationFrame(() => {
          preview.classList.add('is-visible');
        });
      });
    };

    if (previewImg.complete) {
      placeAndReveal();
    } else {
      previewImg.onload = placeAndReveal;
    }
  }

  function hidePreview() {
    if (!preview) return;
    preview.classList.remove('is-visible');
    preview.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll<HTMLElement>('.interior-photo').forEach((el) => {
    el.addEventListener('mouseenter', () => showPreview(el));
    el.addEventListener('mouseleave', hidePreview);
  });
</script>

