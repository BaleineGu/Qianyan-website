---
import type { ContainerLayoutSize } from '@/types/halo';

interface Props {
  sizes: ContainerLayoutSize[];
}

const { sizes } = Astro.props;
const defaultId = sizes[0]?.id ?? '';
---

<section class="py-section-sm lg:py-section-md bg-surface-2" data-header-theme="light">
  <div class="section-container">
    <div class="text-center max-w-[912px] mx-auto mb-8 lg:mb-10">
      <h2 class="heading-h2 text-ink mb-3">
        Container Homes—Various Sizes and Customizable Layouts
      </h2>
      <p class="text-large text-ink-soft">
        Real project cases · Practical layouts · Customizable solutions
      </p>
    </div>

    <div
      class="layout-tabs flex flex-wrap justify-center gap-2 sm:gap-3 mb-8 lg:mb-10"
      role="tablist"
      aria-label="Container sizes"
    >
      {
        sizes.map((size, index) => (
          <button
            type="button"
            role="tab"
            id={`layout-tab-${size.id}`}
            class:list={[
              'layout-tab px-5 sm:px-6 py-2.5 rounded-helios-sm text-h6 font-medium transition-colors',
              index === 0
                ? 'bg-surface-dark text-ink-on-dark is-active'
                : 'bg-surface-1 text-ink border border-ink-hairline hover:border-ink-faint',
            ]}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`layout-panel-${size.id}`}
            data-layout-tab={size.id}
            tabindex={index === 0 ? 0 : -1}
          >
            {size.label}
          </button>
        ))
      }
    </div>

    <div class="layout-panels">
      {
        sizes.map((size, index) => {
          const photos = [
            size.floorPlan
              ? { src: size.floorPlan, alt: `${size.label} floor plan`, contain: true }
              : null,
            ...(size.interiorPhotos?.map((photo, i) => ({
              src: photo,
              alt: `${size.label} interior ${i + 1}`,
              contain: false,
            })) ?? []),
          ].filter(Boolean) as { src: string; alt: string; contain: boolean }[];

          while (photos.length < 4) {
            photos.push({ src: '', alt: '', contain: false });
          }

          return (
            <div
              id={`layout-panel-${size.id}`}
              role="tabpanel"
              aria-labelledby={`layout-tab-${size.id}`}
              class:list={['layout-panel', index !== 0 && 'hidden']}
              data-layout-panel={size.id}
              hidden={index !== 0}
            >
              <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:gap-5 rounded-helios-md bg-surface-1 p-3 sm:p-5">
                {photos.slice(0, 4).map((photo) =>
                  photo.src ? (
                    <div class="aspect-[4/3] overflow-hidden bg-surface-2 rounded-helios-sm border border-ink-hairline">
                      <img
                        src={photo.src}
                        alt={photo.alt}
                        class:list={[
                          'w-full h-full',
                          photo.contain ? 'object-contain' : 'object-cover',
                        ]}
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div
                      class="aspect-[4/3] bg-surface-2 border border-dashed border-ink-hairline rounded-helios-sm"
                      aria-hidden="true"
                    />
                  ),
                )}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script define:vars={{ defaultId }}>
  const tabs = Array.from(document.querySelectorAll('[data-layout-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-layout-panel]'));

  function activate(id) {
    tabs.forEach((tab) => {
      const active = tab.getAttribute('data-layout-tab') === id;
      tab.classList.toggle('is-active', active);
      tab.classList.toggle('bg-surface-dark', active);
      tab.classList.toggle('text-ink-on-dark', active);
      tab.classList.toggle('bg-surface-1', !active);
      tab.classList.toggle('text-ink', !active);
      tab.classList.toggle('border', !active);
      tab.classList.toggle('border-ink-hairline', !active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('tabindex', active ? '0' : '-1');
    });

    panels.forEach((panel) => {
      const active = panel.getAttribute('data-layout-panel') === id;
      panel.classList.toggle('hidden', !active);
      if (active) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-layout-tab');
      if (id) activate(id);
    });
  });

  if (defaultId) activate(defaultId);
</script>
