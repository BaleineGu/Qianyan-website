<section
  class="folding-section py-section-sm lg:py-section-md bg-surface-3"
  data-header-theme="light"
  aria-labelledby="folding-steps-heading"
>
  <div class="section-container immersive-panel">
    <div class="text-center max-w-[912px] mx-auto mb-6 lg:mb-8">
      <h2 id="folding-steps-heading" class="section-heading text-center uppercase tracking-[0.06em]">
        Steps for Folding the Wing-Expandable Container House
      </h2>
    </div>

    <div class="folding-video-wrap rounded-helios-md overflow-hidden border border-ink-hairline">
      <video
        class="w-full h-auto block"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        aria-label="Steps for folding the wing-expandable container house"
      >
        <source src="/images/features/expandable-folding-process.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<style>
  .folding-video-wrap {
    background: #000;
    aspect-ratio: 16 / 9;
  }

  .folding-video-wrap video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
