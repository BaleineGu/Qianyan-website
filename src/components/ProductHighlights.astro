---
const slides = [
  {
    image: '/images/features/folding-process/step-1.png',
    alt: 'Double-wing container house in flat pack state',
  },
  {
    image: '/images/features/folding-process/step-2.png',
    alt: 'Workers folding the side panel of the container house',
  },
  {
    image: '/images/features/folding-process/step-3.png',
    alt: 'Workers lifting the wall panel during assembly',
  },
  {
    image: '/images/features/folding-process/step-4.png',
    alt: 'Double-wing container house side wing being positioned',
  },
  {
    image: '/images/features/folding-process/step-5.png',
    alt: 'Finished expandable double-wing container house',
  },
];

/** Clone ends so loop sliding never shows empty sides */
const trackSlides = [slides[slides.length - 1], ...slides, slides[0]];
---

<section
  class="py-section-sm lg:py-section-md bg-surface-3"
  data-header-theme="light"
  aria-label="Double-wing container house folding process"
>
  <div class="section-container">
    <div class="text-center max-w-[912px] mx-auto mb-6 sm:mb-8">
      <h2 class="text-[clamp(1rem,2.2vw,1.75rem)] font-medium tracking-[0.06em] uppercase text-ink">
        Double-Wing Container House Folding Process
      </h2>
    </div>

    <div id="folding-carousel" class="folding-carousel relative">
      <div class="folding-viewport relative overflow-hidden rounded-helios-md">
        <div id="folding-track" class="folding-track flex items-stretch will-change-transform">
          {
            trackSlides.map((slide, index) => (
              <div class="folding-slide shrink-0" data-track-index={index}>
                <div class="folding-slide__frame overflow-hidden rounded-helios-md bg-surface-2 border border-ink-hairline aspect-[16/9] sm:aspect-[2/1]">
                  <img
                    src={slide.image}
                    alt={slide.alt}
                    class="w-full h-full object-cover object-center"
                    loading={index <= 1 ? 'eager' : 'lazy'}
                    draggable="false"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <button
        id="folding-prev"
        type="button"
        class="absolute left-1 sm:left-2 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-dark/85 text-ink-on-dark backdrop-blur-sm flex items-center justify-center hover:bg-surface-dark transition-colors"
        aria-label="Previous photo"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        id="folding-next"
        type="button"
        class="absolute right-1 sm:right-2 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-dark/85 text-ink-on-dark backdrop-blur-sm flex items-center justify-center hover:bg-surface-dark transition-colors"
        aria-label="Next photo"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div class="mt-5 flex justify-center gap-2">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class:list={[
                'folding-dot h-2 rounded-full transition-all duration-helios',
                index === 0 ? 'is-active bg-surface-dark w-6' : 'bg-ink-faint w-2',
              ]}
              data-index={index}
              aria-label={`Go to photo ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .folding-viewport {
    padding-inline: 9%;
  }

  .folding-track {
    gap: 1rem;
    transition: none;
  }

  .folding-slide {
    width: 100%;
  }

  .folding-slide__frame {
    opacity: 0.5;
    transform: scale(0.94);
  }

  .folding-slide.is-active .folding-slide__frame {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script define:vars={{ totalSlides: slides.length }}>
  const track = document.getElementById('folding-track');
  const slideEls = Array.from(document.querySelectorAll('.folding-slide'));
  const dots = Array.from(document.querySelectorAll('.folding-dot'));
  // Track indices: 0 = clone(last), 1..N = real, N+1 = clone(first)
  let index = 1;

  function gapPx() {
    if (!track) return 16;
    const styles = getComputedStyle(track);
    return Number.parseFloat(styles.columnGap || styles.gap) || 16;
  }

  function step() {
    if (!slideEls[0]) return 0;
    return slideEls[0].getBoundingClientRect().width + gapPx();
  }

  function realIndex() {
    if (index === 0) return totalSlides - 1;
    if (index === totalSlides + 1) return 0;
    return index - 1;
  }

  function updateDots() {
    const real = realIndex();
    dots.forEach((dot, i) => {
      const active = i === real;
      dot.classList.toggle('is-active', active);
      dot.classList.toggle('bg-surface-dark', active);
      dot.classList.toggle('w-6', active);
      dot.classList.toggle('bg-ink-faint', !active);
      dot.classList.toggle('w-2', !active);
    });
  }

  function updateActive() {
    slideEls.forEach((el, i) => {
      el.classList.toggle('is-active', i === index);
    });
  }

  function setTransform() {
    if (!track) return;
    track.style.transition = 'none';
    track.style.transform = `translate3d(${-index * step()}px, 0, 0)`;
  }

  function goTo(nextIndex) {
    if (!track) return;
    index = nextIndex;

    if (index === 0) {
      index = totalSlides;
    } else if (index === totalSlides + 1) {
      index = 1;
    }

    updateActive();
    updateDots();
    setTransform();
  }

  document.getElementById('folding-prev')?.addEventListener('click', () => goTo(index - 1));
  document.getElementById('folding-next')?.addEventListener('click', () => goTo(index + 1));

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const targetReal = Number(dot.dataset.index);
      if (targetReal === realIndex()) return;
      goTo(targetReal + 1);
    });
  });

  window.addEventListener('resize', () => setTransform());

  updateActive();
  updateDots();
  setTransform();
</script>
