---
const slides = [
  {
    image: '/images/features/folding-process/step-1.png',
    alt: 'Double-wing container house in flat pack state',
  },
  {
    image: '/images/features/folding-process/step-2.png',
    alt: 'Workers folding the side panel of the container house',
  },
  {
    image: '/images/features/folding-process/step-3.png',
    alt: 'Workers lifting the wall panel during assembly',
  },
  {
    image: '/images/features/folding-process/step-4.png',
    alt: 'Double-wing container house side wing being positioned',
  },
  {
    image: '/images/features/folding-process/step-5.png',
    alt: 'Finished expandable double-wing container house',
  },
];
---

<section
  class="py-section-sm lg:py-section-md bg-surface-3"
  data-header-theme="light"
  aria-label="Double-wing container house folding process"
>
  <div class="section-container">
    <div class="text-center max-w-[912px] mx-auto mb-6 sm:mb-8">
      <h2 class="text-[clamp(1rem,2.2vw,1.75rem)] font-medium tracking-[0.06em] uppercase text-ink">
        Double-Wing Container House Folding Process
      </h2>
    </div>

    <div
      id="folding-carousel"
      class="relative overflow-hidden rounded-helios-md bg-surface-2 border border-ink-hairline"
    >
      <div class="relative w-full">
        {
          slides.map((slide, index) => (
            <div
              class:list={[
                'folding-slide',
                index === 0 ? 'relative z-10' : 'absolute inset-0 z-0 opacity-0',
              ]}
              data-index={index}
            >
              <img
                src={slide.image}
                alt={slide.alt}
                class="w-full h-auto block object-contain object-center"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))
        }
      </div>

      <button
        id="folding-prev"
        type="button"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-dark/80 text-ink-on-dark backdrop-blur-sm flex items-center justify-center hover:bg-surface-dark transition-colors"
        aria-label="Previous photo"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        id="folding-next"
        type="button"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-dark/80 text-ink-on-dark backdrop-blur-sm flex items-center justify-center hover:bg-surface-dark transition-colors"
        aria-label="Next photo"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div class="absolute bottom-3 sm:bottom-4 left-0 right-0 z-20 flex justify-center gap-2">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class:list={[
                'folding-dot h-2 rounded-full transition-all duration-helios',
                index === 0 ? 'bg-surface-dark w-6' : 'bg-surface-dark/35 w-2',
              ]}
              data-index={index}
              aria-label={`Go to photo ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script define:vars={{ totalSlides: slides.length }}>
  let current = 0;
  const slideEls = document.querySelectorAll('.folding-slide');
  const dotEls = document.querySelectorAll('.folding-dot');

  function goTo(index) {
    const prev = current;
    current = (index + totalSlides) % totalSlides;

    slideEls[prev]?.classList.add('absolute', 'inset-0', 'z-0', 'opacity-0');
    slideEls[prev]?.classList.remove('relative', 'z-10');

    slideEls[current]?.classList.remove('absolute', 'inset-0', 'z-0', 'opacity-0');
    slideEls[current]?.classList.add('relative', 'z-10');

    dotEls[prev]?.classList.remove('bg-surface-dark', 'w-6');
    dotEls[prev]?.classList.add('bg-surface-dark/35', 'w-2');
    dotEls[current]?.classList.remove('bg-surface-dark/35', 'w-2');
    dotEls[current]?.classList.add('bg-surface-dark', 'w-6');
  }

  document.getElementById('folding-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('folding-next')?.addEventListener('click', () => goTo(current + 1));
  dotEls.forEach((dot) => {
    dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
  });
</script>
