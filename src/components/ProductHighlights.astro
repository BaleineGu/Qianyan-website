---
const slides = [
  {
    image: '/images/features/folding-process/step-1.png',
    alt: 'Double-wing container house in flat pack state',
    caption: 'Closed Compact Container',
  },
  {
    image: '/images/features/folding-process/step-2.png',
    alt: 'Workers folding the side panel of the container house',
    caption: 'Both wings open upwards',
  },
  {
    image: '/images/features/folding-process/step-3.png',
    alt: 'Workers lifting the wall panel during assembly',
    caption: 'The inner double wings lay down flat',
  },
  {
    image: '/images/features/folding-process/step-4.png',
    alt: 'Double-wing container house side wing being positioned',
    caption: 'Interior Alignment & Installation',
  },
  {
    image: '/images/features/folding-process/step-5.png',
    alt: 'Finished expandable double-wing container house',
    caption: 'Fully Expanded & Ready',
  },
];
---

<section
  class="folding-section min-h-[88svh] h-[88svh] flex flex-col bg-surface-3"
  data-header-theme="light"
  aria-label="Double-wing container house folding process"
>
  <div class="flex flex-col flex-1 min-h-0 w-full px-4 sm:px-6 lg:px-8 py-5 sm:py-6 lg:py-8">
    <div class="text-center max-w-[912px] mx-auto mb-3 sm:mb-4 shrink-0">
      <h2 class="section-heading text-center uppercase tracking-[0.06em]">
        Double-Wing Container House Folding Process
      </h2>
    </div>

    <div id="folding-gallery" class="folding-gallery flex-1 min-h-0 min-w-0">
      <div class="folding-gallery__media min-w-0 min-h-[240px] overflow-hidden rounded-helios-md border border-ink-hairline bg-surface-3">
        {
          slides.map((slide, index) => (
            <img
              src={slide.image}
              alt={slide.alt}
              class:list={[
                'folding-gallery__image',
                index === 0 ? 'is-active' : 'hidden',
              ]}
              data-folding-image={index}
              loading={index === 0 ? 'eager' : 'lazy'}
              draggable="false"
            />
          ))
        }

        <nav
          class="folding-gallery__nav flex flex-row lg:flex-col lg:justify-between gap-2 sm:gap-3 overflow-x-auto lg:overflow-visible bg-surface-1 border border-ink-hairline p-3 sm:p-4 lg:p-5"
          aria-label="Folding process steps"
        >
          {
            slides.map((slide, index) => (
              <button
                type="button"
                class:list={[
                  'folding-gallery__item group flex items-center gap-2.5 sm:gap-3 w-full text-left shrink-0 lg:shrink-0',
                  index === 0 && 'is-active',
                ]}
                data-folding-tab={index}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={`Show step ${index + 1}: ${slide.caption}`}
              >
                <span class="folding-gallery__num shrink-0 inline-flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 rounded-sm bg-surface-3 text-[13px] sm:text-sm font-medium text-ink tabular-nums">
                  {index + 1}.
                </span>
                <span class="folding-gallery__label text-[13px] sm:text-[15px] leading-snug text-ink-soft whitespace-nowrap lg:whitespace-normal">
                  {slide.caption}
                </span>
              </button>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  .folding-gallery__media {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .folding-gallery__image {
    position: absolute;
    inset: 0;
    display: none;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .folding-gallery__image.is-active {
    display: block;
  }

  .folding-gallery__nav {
    position: absolute;
    z-index: 10;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    max-width: 100%;
    border-radius: 12px;
  }

  @media (min-width: 1024px) {
    .folding-gallery__nav {
      top: 1.25rem;
      right: 1.25rem;
      bottom: 1.25rem;
      left: auto;
      width: min(330px, 32%);
      max-width: 330px;
    }
  }

  .folding-gallery__item {
    padding: 0.7rem 0.75rem;
    border: 1px dashed transparent;
    border-radius: 4px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .folding-gallery__item:hover .folding-gallery__label {
    color: rgb(22 21 20);
  }

  .folding-gallery__item.is-active {
    border-color: rgb(22 21 20 / 0.85);
    background: rgb(255 255 255);
  }

  .folding-gallery__item.is-active .folding-gallery__label {
    color: rgb(22 21 20);
    font-weight: 500;
  }

  .folding-gallery__item.is-active .folding-gallery__num {
    background: rgb(22 21 20);
    color: rgb(255 255 255);
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll('[data-folding-tab]'));
  const images = Array.from(document.querySelectorAll('[data-folding-image]'));

  function activate(index) {
    tabs.forEach((tab) => {
      const active = Number(tab.getAttribute('data-folding-tab')) === index;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    images.forEach((image) => {
      const active = Number(image.getAttribute('data-folding-image')) === index;
      image.classList.toggle('is-active', active);
      image.classList.toggle('hidden', !active);
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const index = Number(tab.getAttribute('data-folding-tab'));
      if (Number.isNaN(index)) return;
      activate(index);
    });
  });
</script>
