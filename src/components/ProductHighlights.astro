---
const slides = [
  {
    image: '/images/features/folding-process/step-1.png',
    alt: 'Double-wing container house in flat pack state',
  },
  {
    image: '/images/features/folding-process/step-2.png',
    alt: 'Workers folding the side panel of the container house',
  },
  {
    image: '/images/features/folding-process/step-3.png',
    alt: 'Workers lifting the wall panel during assembly',
  },
  {
    image: '/images/features/folding-process/step-4.png',
    alt: 'Double-wing container house side wing being positioned',
  },
  {
    image: '/images/features/folding-process/step-5.png',
    alt: 'Finished expandable double-wing container house',
  },
];
---

<section
  class="py-section-sm lg:py-section-md bg-surface-3"
  data-header-theme="light"
  aria-label="Double-wing container house folding process"
>
  <div class="section-container">
    <div class="text-center max-w-[912px] mx-auto mb-6 sm:mb-8">
      <h2 class="text-[clamp(1rem,2.2vw,1.75rem)] font-medium tracking-[0.06em] uppercase text-ink">
        Double-Wing Container House Folding Process
      </h2>
    </div>

    <div id="folding-carousel" class="folding-stack relative mx-auto max-w-[980px] px-2 sm:px-6 pb-4 sm:pb-8">
      <div class="folding-stack__stage relative w-full aspect-[16/10] sm:aspect-[2/1] pr-[12%] pb-[10%]">
        {
          slides.map((slide, index) => (
            <article
              class="folding-card absolute inset-0 overflow-hidden rounded-helios-md bg-surface-2 border border-ink-hairline shadow-[0_12px_40px_rgb(22_21_20_/_0.12)]"
              data-index={index}
              style={`--i: ${index}`}
            >
              <img
                src={slide.image}
                alt={slide.alt}
                class="w-full h-full object-cover object-center"
                loading={index === 0 ? 'eager' : 'lazy'}
                draggable="false"
              />
            </article>
          ))
        }
      </div>

      <button
        id="folding-prev"
        type="button"
        class="absolute left-0 sm:-left-2 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-dark/85 text-ink-on-dark backdrop-blur-sm flex items-center justify-center hover:bg-surface-dark transition-colors"
        aria-label="Previous photo"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </button>
      <button
        id="folding-next"
        type="button"
        class="absolute right-0 sm:-right-2 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-surface-dark/85 text-ink-on-dark backdrop-blur-sm flex items-center justify-center hover:bg-surface-dark transition-colors"
        aria-label="Next photo"
      >
        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </button>

      <div class="mt-5 flex justify-center gap-2">
        {
          slides.map((_, index) => (
            <button
              type="button"
              class:list={[
                'folding-dot h-2 rounded-full transition-all duration-helios',
                index === 0 ? 'is-active bg-surface-dark w-6' : 'bg-ink-faint w-2',
              ]}
              data-index={index}
              aria-label={`Go to photo ${index + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .folding-stack__stage {
    perspective: 1200px;
  }

  .folding-card {
    transform-origin: center center;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.45s ease,
      filter 0.45s ease,
      box-shadow 0.45s ease;
    will-change: transform, opacity;
  }

  .folding-card[data-pos='0'] {
    z-index: 5;
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: none;
    box-shadow: 0 16px 48px rgb(22 21 20 / 0.16);
    pointer-events: auto;
  }

  .folding-card[data-pos='1'] {
    z-index: 4;
    opacity: 1;
    transform: translate3d(4.5%, 3.5%, -40px) scale(0.94);
    filter: brightness(0.96);
    pointer-events: none;
  }

  .folding-card[data-pos='2'] {
    z-index: 3;
    opacity: 1;
    transform: translate3d(9%, 7%, -80px) scale(0.88);
    filter: brightness(0.92);
    pointer-events: none;
  }

  .folding-card[data-pos='3'] {
    z-index: 2;
    opacity: 0.92;
    transform: translate3d(13.5%, 10.5%, -120px) scale(0.82);
    filter: brightness(0.88);
    pointer-events: none;
  }

  .folding-card[data-pos='4'],
  .folding-card[data-pos='-1'] {
    z-index: 1;
    opacity: 0;
    transform: translate3d(-8%, 2%, -20px) scale(0.96);
    pointer-events: none;
  }

  .folding-dot.is-active {
    background-color: var(--color-surface-dark, #161514);
    width: 1.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .folding-card {
      transition: none;
    }
  }
</style>

<script define:vars={{ totalSlides: slides.length }}>
  let current = 0;
  const cards = Array.from(document.querySelectorAll('.folding-card'));
  const dots = Array.from(document.querySelectorAll('.folding-dot'));

  function render() {
    cards.forEach((card, index) => {
      let pos = (index - current + totalSlides) % totalSlides;
      if (pos > 3) pos = -1;
      card.setAttribute('data-pos', String(pos));
    });

    dots.forEach((dot, index) => {
      const active = index === current;
      dot.classList.toggle('is-active', active);
      dot.classList.toggle('bg-surface-dark', active);
      dot.classList.toggle('w-6', active);
      dot.classList.toggle('bg-ink-faint', !active);
      dot.classList.toggle('w-2', !active);
    });
  }

  function goTo(index) {
    current = (index + totalSlides) % totalSlides;
    render();
  }

  document.getElementById('folding-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('folding-next')?.addEventListener('click', () => goTo(current + 1));
  dots.forEach((dot) => {
    dot.addEventListener('click', () => goTo(Number(dot.dataset.index)));
  });

  render();
</script>
