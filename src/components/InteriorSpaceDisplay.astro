---
---

<section
  class="py-section-sm lg:py-section-md bg-surface-2"
  aria-labelledby="interior-space-heading"
  data-header-theme="light"
>
  <div class="section-container immersive-panel">
    <h2 id="interior-space-heading" class="section-heading text-center mb-8 lg:mb-10">
      RANGE OF APPLICATIONS
    </h2>
    <div class="applications-grid">
      <div class="applications-grid__item">
        <img src="/images/applications/camp-site.png" alt="Container camp site in mountainous terrain" loading="lazy" />
        <p class="applications-grid__label">Engineering and temporary rescue</p>
      </div>
      <div class="applications-grid__item">
        <img src="/images/applications/modern-home.png" alt="Modern container home with deck" loading="lazy" />
      </div>
      <div class="applications-grid__item is-capsule">
        <img src="/images/applications/hillside-capsule.png" alt="Hillside capsule container house" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .applications-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .applications-grid__item {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(22, 21, 20, 0.12);
    background: #ffffff;
    cursor: pointer;
  }

  .applications-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.62;
    transition: opacity 280ms ease;
  }

  .applications-grid__item:hover img,
  .applications-grid__item:focus-within img {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .applications-grid__item img {
      transition: none;
    }
  }

  .applications-grid__item.is-capsule img {
    object-fit: cover;
    object-position: 62% 40%;
  }

  .applications-grid__label {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 33.333%;
    margin: 0;
    padding: clamp(0.65rem, 2vw, 1rem) clamp(0.75rem, 2.5vw, 1.25rem);
    color: #ffffff;
    font-size: clamp(0.95rem, 1.8vw, 1.2rem);
    line-height: 1.35;
    font-weight: 600;
    text-align: center;
    text-wrap: balance;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }
</style>
