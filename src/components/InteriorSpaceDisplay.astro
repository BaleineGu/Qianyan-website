---
interface InteriorPhoto {
  src: string;
  alt: string;
}

interface Props {
  photos: InteriorPhoto[];
}

const { photos } = Astro.props;

const midpoint = Math.ceil(photos.length / 2);
const topRow = photos.slice(0, midpoint);
const bottomRow = photos.slice(midpoint);
---

<section
  class="py-section-sm lg:py-section-md bg-surface-2 overflow-hidden"
  aria-labelledby="interior-space-heading"
  data-header-theme="light"
>
  <div class="section-container mb-8 lg:mb-10 immersive-panel">
    <h2 id="interior-space-heading" class="section-heading text-center">
      RANGE OF APPLICATIONS
    </h2>
  </div>

  <div class="interior-carousel-shell relative section-container immersive-panel">
    <button
      type="button"
      id="interior-prev"
      class="interior-nav-btn interior-nav-btn--prev"
      aria-label="Scroll interior photos left"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <div class="interior-marquee-stack flex flex-col gap-4 sm:gap-5 lg:gap-6 px-12 sm:px-14">
      {
        [
          { row: topRow, trackId: 'interior-track-top' },
          { row: bottomRow, trackId: 'interior-track-bottom' },
        ].map(({ row, trackId }) =>
          row.length > 0 ? (
            <div class="interior-marquee-viewport">
              <div id={trackId} class="interior-marquee-track">
                {
                  [...row, ...row].map((photo, index) => (
                    <div class="interior-marquee-card">
                      <img
                        src={photo.src}
                        alt={index < row.length ? photo.alt : ''}
                        class="w-full h-full object-cover"
                        loading="lazy"
                        draggable="false"
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          ) : null,
        )
      }
    </div>

    <button
      type="button"
      id="interior-next"
      class="interior-nav-btn interior-nav-btn--next"
      aria-label="Scroll interior photos right"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
  </div>

  <div class="section-container mt-10 lg:mt-14 immersive-panel">
    <div class="applications-grid">
      <div class="applications-grid__item">
        <img src="/images/applications/camp-site.png" alt="Container camp site in mountainous terrain" loading="lazy" />
      </div>
      <div class="applications-grid__item">
        <img src="/images/applications/modern-home.png" alt="Modern container home with deck" loading="lazy" />
      </div>
      <div class="applications-grid__item">
        <img src="/images/applications/hillside-capsule.png" alt="Hillside capsule container house" loading="lazy" />
      </div>
    </div>
  </div>
</section>

<style>
  .interior-carousel-shell {
    --interior-card-w: clamp(220px, 28vw, 360px);
    --interior-gap: clamp(0.5rem, 1.2vw, 1rem);
  }

  .interior-marquee-viewport {
    overflow: hidden;
    width: 100%;
  }

  .interior-marquee-track {
    display: flex;
    width: max-content;
    gap: var(--interior-gap);
    will-change: transform;
  }

  .interior-marquee-card {
    width: var(--interior-card-w);
    aspect-ratio: 4 / 3;
    flex: none;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(22, 21, 20, 0.12);
    background: #ffffff;
  }

  .interior-nav-btn {
    position: absolute;
    top: 50%;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(22, 21, 20, 0.16);
    background: #ffffff;
    color: #161514;
    box-shadow: 0 4px 16px rgba(22, 21, 20, 0.08);
    transform: translateY(-50%);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .interior-nav-btn:hover {
    background: #f7f6f4;
    border-color: rgba(22, 21, 20, 0.28);
  }

  .interior-nav-btn--prev {
    left: 0;
  }

  .interior-nav-btn--next {
    right: 0;
  }

  .applications-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .applications-grid__item {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(22, 21, 20, 0.12);
    background: #ffffff;
  }

  .applications-grid__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>

<script>
  const tracks = [
    document.getElementById('interior-track-top'),
    document.getElementById('interior-track-bottom'),
  ].filter((track): track is HTMLElement => track instanceof HTMLElement);

  if (tracks.length > 0) {
    const states = tracks.map((track) => ({
      track,
      setCount: track.children.length / 2,
      index: 0,
    }));

    const gap = (track: HTMLElement) => {
      const style = getComputedStyle(track);
      return parseFloat(style.columnGap || style.gap || '16') || 16;
    };

    const step = (track: HTMLElement) => {
      const first = track.children[0] as HTMLElement | undefined;
      return first ? first.offsetWidth + gap(track) : 300;
    };

    let animating = false;

    const applyAll = (animate: boolean) => {
      states.forEach(({ track, index }) => {
        track.style.transition = animate ? 'transform 0.45s ease' : 'none';
        track.style.transform = `translateX(${-index * step(track)}px)`;
      });
    };

    const normalizeAll = () => {
      states.forEach((state) => {
        if (state.index >= state.setCount) {
          state.index -= state.setCount;
        }
      });
      applyAll(false);
    };

    const go = (dir: number) => {
      if (animating) return;
      animating = true;

      if (dir < 0 && states.every((state) => state.index === 0)) {
        states.forEach((state) => {
          state.index = state.setCount;
        });
        applyAll(false);
        void tracks[0]?.offsetWidth;
      }

      states.forEach((state) => {
        state.index += dir;
      });
      applyAll(true);

      window.setTimeout(() => {
        normalizeAll();
        animating = false;
      }, 480);
    };

    let timer: ReturnType<typeof setInterval> | null = null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const stopAuto = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };

    const startAuto = () => {
      if (prefersReducedMotion) return;
      stopAuto();
      timer = setInterval(() => go(1), 2000);
    };

    document.getElementById('interior-prev')?.addEventListener('click', () => {
      go(-1);
      startAuto();
    });

    document.getElementById('interior-next')?.addEventListener('click', () => {
      go(1);
      startAuto();
    });

    const shell = document.querySelector('.interior-carousel-shell');
    shell?.addEventListener('mouseenter', stopAuto);
    shell?.addEventListener('mouseleave', startAuto);
    window.addEventListener('resize', () => applyAll(false));

    applyAll(false);
    startAuto();
  }
</script>
