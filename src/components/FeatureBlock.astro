---
import type { FeatureBlock } from '@/types/halo';

interface Props {
  block: FeatureBlock;
}

const { block } = Astro.props;
const isImageLeft = block.imagePosition === 'left';
---

<section class="py-20 lg:py-28">
  <div class="section-container">
    <div
      class:list={[
        'grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center',
        isImageLeft ? '' : '',
      ]}
    >
      <div class:list={[isImageLeft ? 'lg:order-1' : 'lg:order-2']}>
        <img
          src={block.image}
          alt=""
          class="w-full h-72 sm:h-80 lg:h-96 object-cover rounded-2xl shadow-lg"
          loading="lazy"
        />
      </div>
      <div class:list={[isImageLeft ? 'lg:order-2' : 'lg:order-1']}>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-900 mb-5 leading-tight">
          {block.title}
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed">
          {block.description}
        </p>
      </div>
    </div>
  </div>
</section>
