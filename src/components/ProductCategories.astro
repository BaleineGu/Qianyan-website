---
import type { ProductCategory } from '@/types/halo';
interface Props { categories: ProductCategory[] }
const { categories } = Astro.props;
---
<section class="py-section-sm lg:py-section-md bg-surface-1" data-header-theme="light">
  <div class="section-container">
    <div class="mb-12 lg:mb-16 text-center max-w-[680px] mx-auto">
      <h2 class="heading-h2 text-ink">Next, you will see our products</h2>
    </div>
    <div class="flex flex-col gap-8 lg:gap-12">
      {categories.map((c, index) => {
        const imageLeft = index % 2 === 0;
        return (
          <a
            href={c.href}
            class:list={[
              'group flex flex-col lg:flex-row lg:items-stretch gap-0 overflow-hidden rounded-helios-md bg-surface-2 transition-opacity duration-helios hover:opacity-95',
              !imageLeft && 'lg:flex-row-reverse',
            ]}
          >
            <div class="lg:w-1/2 aspect-[16/10] overflow-hidden shrink-0">
              <img
                src={c.image}
                alt=""
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.06]"
                loading="lazy"
              />
            </div>
            <div class="lg:w-1/2 px-6 py-6 lg:px-10 lg:py-10 flex flex-col justify-center">
              <h3 class="heading-h5 text-ink mb-3">
                {c.name}
              </h3>
              <p class="text-body text-ink-soft">
                {c.description}
              </p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
