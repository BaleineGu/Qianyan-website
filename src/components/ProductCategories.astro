---
import type { ProductCategory } from '@/types/halo';

interface Props {
  categories: ProductCategory[];
}

const { categories } = Astro.props;
const defaultId = categories[0]?.id ?? '';

const tabLabels: Record<string, string> = {
  expandable: 'Expandable Homes',
  capsule: 'Space Capsule',
  'flat-pack': 'Flat Pack',
  folding: 'Folding Houses',
  pools: 'Swimming Pools',
};
---

<section
  class="product-tabs-section bg-surface-1"
  data-header-theme="light"
  data-header-hide="true"
>
  <div class="section-container py-6 sm:py-8 lg:py-10">
    <div class="text-center max-w-[680px] mx-auto mb-3 sm:mb-4">
      <h2 class="section-heading text-center">
        Next, you will see our house.
      </h2>
    </div>

    <div
      class="product-tabs grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-2.5 mb-3 sm:mb-4"
      role="tablist"
      aria-label="Product categories"
    >
      {
        categories.map((c, index) => (
          <button
            type="button"
            role="tab"
            id={`product-tab-${c.id}`}
            class:list={[
              'product-tab w-full px-2 sm:px-3 py-2.5 sm:py-3 lg:py-3.5 rounded-helios-sm text-[clamp(0.8125rem,1.35vw,1.125rem)] font-medium transition-colors text-center leading-tight',
              index === 0
                ? 'bg-surface-dark text-ink-on-dark is-active'
                : 'bg-surface-2 text-ink border border-ink-hairline hover:border-ink-faint',
            ]}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`product-panel-${c.id}`}
            data-product-tab={c.id}
            tabindex={index === 0 ? 0 : -1}
          >
            {tabLabels[c.id] ?? c.name}
          </button>
        ))
      }
    </div>

    <div id="product-panels" class="product-panels relative">
      {
        categories.map((c, index) => (
          <div
            id={`product-panel-${c.id}`}
            role="tabpanel"
            aria-labelledby={`product-tab-${c.id}`}
            class:list={['product-panel h-full', index !== 0 && 'hidden']}
            data-product-panel={c.id}
            hidden={index !== 0}
          >
            <a
              href={c.href}
              class="group grid grid-cols-1 md:grid-cols-[55fr_45fr] md:h-full overflow-hidden rounded-helios-md border border-ink-hairline bg-surface-2"
            >
              <div class="product-panel__media relative isolate min-h-[220px] aspect-[16/10] md:aspect-auto md:min-h-0 md:h-full overflow-hidden bg-surface-3 min-w-0">
                <img
                  src={c.image}
                  alt=""
                  class="product-panel__image absolute inset-0 w-full h-full object-cover object-center"
                  data-master-image={index === 0 ? 'true' : undefined}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="product-panel__copy relative z-10 isolate min-w-0 min-h-0 md:h-full bg-surface-1 px-5 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-7 flex flex-col justify-center overflow-hidden">
                {c.id === 'expandable' ? (
                  <div class="w-full h-full min-h-[200px] flex flex-col gap-2 sm:gap-3">
                    <h3 class="product-panel__title font-medium text-ink leading-tight shrink-0 text-[clamp(1.1rem,1.8vw,1.45rem)]">
                      {c.name}
                    </h3>
                    <div class="flex-1 min-h-0 grid grid-cols-2 grid-rows-2 gap-2 sm:gap-3">
                      <div class="col-start-1 row-start-1 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/expandable-gallery/home-side-01.png"
                          alt="Expandable home bedroom interior"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                      <div class="col-start-2 row-start-1 flex items-center px-2 sm:px-3">
                        <p class="text-[clamp(0.8125rem,1.15vw,1.0625rem)] leading-relaxed text-ink-soft">
                          A wide range of sizes, layouts, and interior styles are available for you to mix and match.
                        </p>
                      </div>
                      <div class="col-start-1 row-start-2 flex items-center px-2 sm:px-3">
                        <p class="text-[clamp(0.8125rem,1.15vw,1.0625rem)] leading-relaxed text-ink-soft">
                          Sturdy and durable, with a lifespan of decades, providing you with the most solid shelter.
                        </p>
                      </div>
                      <div class="col-start-2 row-start-2 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/expandable-gallery/home-side-02.png"
                          alt="Expandable home modular room interior"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </div>
                ) : c.id === 'capsule' ? (
                  <div class="w-full h-full min-h-[200px] flex flex-col gap-2 sm:gap-3">
                    <h3 class="product-panel__title font-medium text-ink leading-tight shrink-0 text-[clamp(1.1rem,1.8vw,1.45rem)]">
                      {c.name}
                    </h3>
                    <div class="flex-1 min-h-0 grid grid-cols-2 grid-rows-2 gap-2 sm:gap-3">
                      <div class="col-start-1 row-start-1 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/capsule-gallery/interior-02.png"
                          alt="Space capsule glass cabin interior"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                      <div class="col-start-2 row-start-1 flex items-center px-2 sm:px-3">
                        <p class="text-[clamp(0.8125rem,1.15vw,1.0625rem)] leading-relaxed text-ink-soft">
                          270° panoramic view—embrace the stars and the sea.
                        </p>
                      </div>
                      <div class="col-start-1 row-start-2 flex items-center px-2 sm:px-3">
                        <p class="text-[clamp(0.8125rem,1.15vw,1.0625rem)] leading-relaxed text-ink-soft">
                          Smart, fully finished delivery—enjoy a luxurious lifestyle from day one.
                        </p>
                      </div>
                      <div class="col-start-2 row-start-2 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/capsule-gallery/interior-01.png"
                          alt="Space capsule living lounge interior"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </div>
                ) : c.id === 'flat-pack' ? (
                  <div class="w-full h-full min-h-[200px] flex flex-col gap-2 sm:gap-3">
                    <h3 class="product-panel__title font-medium text-ink leading-tight shrink-0 text-[clamp(1.1rem,1.8vw,1.45rem)]">
                      {c.name}
                    </h3>
                    <div class="flex-1 min-h-0 grid grid-cols-2 grid-rows-2 gap-2 sm:gap-3">
                      <div class="col-start-1 row-start-1 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/flatpack-gallery/side-01.png"
                          alt="Flat pack container camp housing"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                      <div class="col-start-2 row-start-1 flex items-center px-2 sm:px-3">
                        <p class="text-[clamp(0.8125rem,1.15vw,1.0625rem)] leading-relaxed text-ink-soft">
                          One-stop engineering camp solutions
                        </p>
                      </div>
                      <div class="col-start-1 row-start-2 flex items-center px-2 sm:px-3">
                        <p class="text-[clamp(0.8125rem,1.15vw,1.0625rem)] leading-relaxed text-ink-soft">
                          Versatile commercial space—ready for immediate use.
                        </p>
                      </div>
                      <div class="col-start-2 row-start-2 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/flatpack-gallery/side-02.png"
                          alt="Flat pack container retail shop"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </div>
                ) : c.id === 'folding' ? (
                  <div class="w-full h-full min-h-[200px] flex flex-col gap-2 sm:gap-3">
                    <h3 class="product-panel__title font-medium text-ink leading-tight shrink-0 text-[clamp(1.1rem,1.8vw,1.45rem)]">
                      {c.name}
                    </h3>
                    <div class="flex-1 min-h-0 grid grid-cols-2 grid-rows-2 gap-2 sm:gap-3">
                      <div class="col-start-1 row-start-1 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/folding-gallery/side-01.png"
                          alt="Folding house unit crane lift"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                      <div class="col-start-2 row-start-1 flex items-center px-2 sm:px-3"></div>
                      <div class="col-start-1 row-start-2 flex items-center px-2 sm:px-3"></div>
                      <div class="col-start-2 row-start-2 overflow-hidden rounded-helios-sm border border-ink-hairline bg-surface-3">
                        <img
                          src="/images/products/folding-gallery/side-02.png"
                          alt="Folding house steel frame structure"
                          class="w-full h-full object-cover object-center"
                          loading="lazy"
                        />
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="product-panel__copy-inner w-full" data-fit-copy>
                    <h3 class="product-panel__title font-medium text-ink leading-tight mb-[0.55em]">
                      {c.name}
                    </h3>
                    <p class="product-panel__body leading-[1.65] text-ink-soft">
                      {c.description}
                    </p>
                  </div>
                )}
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .product-panel__title {
    font-size: 1.45em;
  }

  .product-panel__body {
    font-size: 1em;
  }

  .product-panel__copy-inner {
    font-size: 16px;
  }

  .product-panel__image {
    transform: scale(1);
    transform-origin: center center;
    transition: transform 0.45s ease-out;
    will-change: transform;
  }

  .product-panel__media:hover .product-panel__image {
    transform: scale(1.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-panel__image {
      transition: none;
    }

    .product-panel__media:hover .product-panel__image {
      transform: none;
    }
  }
</style>

<script define:vars={{ defaultId }}>
  const tabs = Array.from(document.querySelectorAll('[data-product-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-product-panel]'));
  const panelsRoot = document.getElementById('product-panels');
  const masterImage = document.querySelector('[data-master-image="true"]');

  function syncPanelHeight() {
    if (!panelsRoot || !masterImage) return;

    if (window.innerWidth < 768) {
      panelsRoot.style.height = '';
      return;
    }

    const naturalW = masterImage.naturalWidth;
    const naturalH = masterImage.naturalHeight;
    if (!naturalW || !naturalH) return;

    const totalWidth = panelsRoot.getBoundingClientRect().width;
    const imageWidth = totalWidth * 0.55;
    const height = Math.round(imageWidth * (naturalH / naturalW));
    panelsRoot.style.height = `${height}px`;
  }

  function fitCopy(root = document) {
    const boxes = root.querySelectorAll('.product-panel__copy');
    boxes.forEach((copy) => {
      const panel = copy.closest('[data-product-panel]');
      if (panel?.classList.contains('hidden') || panel?.hasAttribute('hidden')) return;

      const inner = copy.querySelector('[data-fit-copy]');
      if (!(inner instanceof HTMLElement) || !(copy instanceof HTMLElement)) return;

      if (window.innerWidth < 768) {
        inner.style.fontSize = '';
        return;
      }

      const available = (() => {
        const styles = getComputedStyle(copy);
        const padY = Number.parseFloat(styles.paddingTop) + Number.parseFloat(styles.paddingBottom);
        return Math.max(0, copy.clientHeight - padY);
      })();
      if (available < 40) return;

      let low = 11;
      let high = 30;
      let best = low;

      for (let i = 0; i < 16; i += 1) {
        const mid = (low + high) / 2;
        inner.style.fontSize = `${mid}px`;
        if (inner.scrollHeight <= available) {
          best = mid;
          low = mid;
        } else {
          high = mid;
        }
      }

      inner.style.fontSize = `${best.toFixed(2)}px`;
    });
  }

  function layout() {
    syncPanelHeight();
    requestAnimationFrame(() => fitCopy());
  }

  function activate(id) {
    tabs.forEach((tab) => {
      const active = tab.getAttribute('data-product-tab') === id;
      tab.classList.toggle('is-active', active);
      tab.classList.toggle('bg-surface-dark', active);
      tab.classList.toggle('text-ink-on-dark', active);
      tab.classList.toggle('bg-surface-2', !active);
      tab.classList.toggle('text-ink', !active);
      tab.classList.toggle('border', !active);
      tab.classList.toggle('border-ink-hairline', !active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('tabindex', active ? '0' : '-1');
    });

    panels.forEach((panel) => {
      const active = panel.getAttribute('data-product-panel') === id;
      panel.classList.toggle('hidden', !active);
      if (active) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
    });

    requestAnimationFrame(() => fitCopy());
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-product-tab');
      if (id) activate(id);
    });
  });

  if (defaultId) activate(defaultId);

  if (masterImage) {
    if (masterImage.complete) layout();
    else masterImage.addEventListener('load', layout);
  } else {
    layout();
  }

  window.addEventListener('resize', layout);
</script>
