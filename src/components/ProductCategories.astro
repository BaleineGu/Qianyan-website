---
import type { ProductCategory } from '@/types/halo';

interface Props {
  categories: ProductCategory[];
}

const { categories } = Astro.props;

const categoryLabels: Record<string, string> = {
  expandable: 'Expandable',
  capsule: 'Capsule',
  'flat-pack': 'Flat Pack',
  folding: 'Folding',
  pools: 'Pool',
};
---

<section
  class="product-tabs-section bg-surface-1"
  data-header-theme="light"
  aria-labelledby="product-category-heading"
>
  <div class="section-container py-6 sm:py-8 lg:py-10">
    <div class="text-center max-w-[680px] mx-auto mb-6 sm:mb-8">
      <h2 id="product-category-heading" class="section-heading text-center">
        Product Category
      </h2>
    </div>

    <div class="product-showcase">
      {
        categories.map((c, index) => (
          <a href={c.href} class="product-showcase__card group">
            <img
              src={c.image}
              alt=""
              class="product-showcase__image"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <div class="product-showcase__overlay" aria-hidden="true" />
            <div class="product-showcase__meta">
              <div class="product-showcase__info">
                <span class="product-showcase__label">{categoryLabels[c.id] ?? 'Product'}</span>
                <h3 class="product-showcase__title">{c.name}</h3>
              </div>
              <span class="product-showcase__cta">
                See Project
                <span class="product-showcase__cta-plus" aria-hidden="true">+</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .product-showcase {
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .product-showcase__card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    min-height: clamp(16rem, 42vw, 28rem);
    overflow: hidden;
    border-radius: 0;
    text-decoration: none;
    color: inherit;
    background: #111;
  }

  .product-showcase__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 700ms ease;
  }

  .product-showcase__card:hover .product-showcase__image {
    transform: scale(1.04);
  }

  .product-showcase__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.28) 0%, transparent 45%);
    pointer-events: none;
  }

  .product-showcase__meta {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0;
  }

  .product-showcase__info {
    max-width: min(72%, 36rem);
    padding: clamp(1rem, 2.2vw, 1.75rem) clamp(1.1rem, 2.4vw, 2rem);
    background: #ffffff;
  }

  .product-showcase__label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: clamp(0.7rem, 1vw, 0.8rem);
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #9a9a9a;
    font-weight: 500;
  }

  .product-showcase__title {
    margin: 0;
    font-size: clamp(1.05rem, 2.1vw, 1.65rem);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-weight: 800;
    color: #111111;
  }

  .product-showcase__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    padding: clamp(0.85rem, 1.6vw, 1.2rem) clamp(1rem, 2vw, 1.5rem);
    background: #ffffff;
    font-size: clamp(0.7rem, 1vw, 0.8rem);
    line-height: 1.2;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: #9a9a9a;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .product-showcase__card:hover .product-showcase__cta {
    color: #111111;
  }

  .product-showcase__cta-plus {
    font-size: 1.05em;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-showcase__image,
    .product-showcase__cta {
      transition: none;
    }

    .product-showcase__card:hover .product-showcase__image {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .product-showcase__card {
      aspect-ratio: 4 / 5;
      min-height: 22rem;
    }

    .product-showcase__meta {
      flex-direction: column;
      align-items: stretch;
    }

    .product-showcase__info {
      max-width: none;
    }

    .product-showcase__cta {
      justify-content: space-between;
    }
  }
</style>
