---
import type { ProductCategory } from '@/types/halo';

interface Props {
  categories: ProductCategory[];
}

const { categories } = Astro.props;
const defaultId = categories[0]?.id ?? '';

const tabLabels: Record<string, string> = {
  expandable: 'Expandable Homes',
  capsule: 'Space Capsule',
  'flat-pack': 'Flat Pack',
  folding: 'Folding Houses',
  pools: 'Swimming Pools',
};
---

<section
  class="product-tabs-section bg-surface-1"
  data-header-theme="light"
  data-header-hide="true"
>
  <div class="section-container py-6 sm:py-8 lg:py-10">
    <div class="text-center max-w-[680px] mx-auto mb-3 sm:mb-4">
      <h2 class="section-heading text-center">
        Next, you will see our house.
      </h2>
    </div>

    <div
      class="product-tabs grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-2.5 mb-3 sm:mb-4"
      role="tablist"
      aria-label="Product categories"
    >
      {
        categories.map((c, index) => (
          <button
            type="button"
            role="tab"
            id={`product-tab-${c.id}`}
            class:list={[
              'product-tab w-full px-2 sm:px-3 py-2.5 sm:py-3 lg:py-3.5 rounded-helios-sm text-[clamp(0.8125rem,1.35vw,1.125rem)] font-medium transition-colors text-center leading-tight',
              index === 0
                ? 'bg-surface-dark text-ink-on-dark is-active'
                : 'bg-surface-2 text-ink border border-ink-hairline hover:border-ink-faint',
            ]}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`product-panel-${c.id}`}
            data-product-tab={c.id}
            tabindex={index === 0 ? 0 : -1}
          >
            {tabLabels[c.id] ?? c.name}
          </button>
        ))
      }
    </div>

    <div id="product-panels" class="product-panels relative">
      {
        categories.map((c, index) => (
          <div
            id={`product-panel-${c.id}`}
            role="tabpanel"
            aria-labelledby={`product-tab-${c.id}`}
            class:list={['product-panel h-full', index !== 0 && 'hidden']}
            data-product-panel={c.id}
            hidden={index !== 0}
          >
            <a
              href={c.href}
              class="group grid grid-cols-1 md:grid-cols-[55fr_45fr] md:h-full overflow-hidden rounded-helios-md bg-surface-2 transition-opacity duration-helios hover:opacity-95"
            >
              <div class="product-panel__media relative min-h-[220px] aspect-[16/10] md:aspect-auto md:min-h-0 md:h-full overflow-hidden bg-surface-2 min-w-0">
                <img
                  src={c.image}
                  alt=""
                  class:list={[
                    'absolute inset-0 w-full h-full',
                    index < 2 ? 'object-contain object-center' : 'object-cover object-center',
                  ]}
                  data-master-image={index === 0 ? 'true' : undefined}
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
              <div class="product-panel__copy min-w-0 min-h-0 md:h-full px-5 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-7 flex flex-col justify-center gap-4 sm:gap-5 overflow-hidden">
                <h3 class="text-[clamp(1.25rem,2.1vw,1.875rem)] font-medium text-ink leading-tight shrink-0">
                  {c.name}
                </h3>
                <p class="text-[clamp(0.9375rem,1.35vw,1.1875rem)] leading-[1.7] text-ink-soft overflow-hidden">
                  {c.description}
                </p>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script define:vars={{ defaultId }}>
  const tabs = Array.from(document.querySelectorAll('[data-product-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-product-panel]'));
  const panelsRoot = document.getElementById('product-panels');
  const masterImage = document.querySelector('[data-master-image="true"]');

  function syncPanelHeight() {
    if (!panelsRoot || !masterImage) return;

    if (window.innerWidth < 768) {
      panelsRoot.style.height = '';
      return;
    }

    const naturalW = masterImage.naturalWidth;
    const naturalH = masterImage.naturalHeight;
    if (!naturalW || !naturalH) return;

    // Content width is 55% image + 45% text; height = imageWidth × ratio
    const totalWidth = panelsRoot.getBoundingClientRect().width;
    const imageWidth = totalWidth * 0.55;
    const height = Math.round(imageWidth * (naturalH / naturalW));
    panelsRoot.style.height = `${height}px`;
  }

  function activate(id) {
    tabs.forEach((tab) => {
      const active = tab.getAttribute('data-product-tab') === id;
      tab.classList.toggle('is-active', active);
      tab.classList.toggle('bg-surface-dark', active);
      tab.classList.toggle('text-ink-on-dark', active);
      tab.classList.toggle('bg-surface-2', !active);
      tab.classList.toggle('text-ink', !active);
      tab.classList.toggle('border', !active);
      tab.classList.toggle('border-ink-hairline', !active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('tabindex', active ? '0' : '-1');
    });

    panels.forEach((panel) => {
      const active = panel.getAttribute('data-product-panel') === id;
      panel.classList.toggle('hidden', !active);
      if (active) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-product-tab');
      if (id) activate(id);
    });
  });

  if (defaultId) activate(defaultId);

  if (masterImage) {
    if (masterImage.complete) syncPanelHeight();
    else masterImage.addEventListener('load', syncPanelHeight);
  }

  window.addEventListener('resize', syncPanelHeight);
</script>
