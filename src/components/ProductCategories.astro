---
import type { ProductCategory } from '@/types/halo';

interface Props {
  categories: ProductCategory[];
}

const { categories } = Astro.props;
const defaultId = categories[0]?.id ?? '';

const tabLabels: Record<string, string> = {
  expandable: 'Expandable Homes',
  capsule: 'Space Capsule',
  'flat-pack': 'Flat Pack',
  folding: 'Folding Houses',
  pools: 'Swimming Pools',
};
---

<section
  class="product-tabs-section h-svh max-h-svh flex flex-col bg-surface-1 overflow-hidden"
  data-header-theme="light"
>
  <div class="section-container flex flex-col flex-1 min-h-0 py-5 sm:py-6 lg:py-8">
    <div class="shrink-0 text-center max-w-[680px] mx-auto mb-4 sm:mb-5">
      <h2 class="text-[clamp(1.25rem,2.4vw,2.25rem)] leading-tight font-medium tracking-tight text-ink">
        Next, you will see our products
      </h2>
    </div>

    <div
      class="product-tabs shrink-0 flex flex-wrap justify-center gap-2 sm:gap-2.5 mb-4 sm:mb-5"
      role="tablist"
      aria-label="Product categories"
    >
      {
        categories.map((c, index) => (
          <button
            type="button"
            role="tab"
            id={`product-tab-${c.id}`}
            class:list={[
              'product-tab px-3 sm:px-4 py-1.5 sm:py-2 rounded-helios-sm text-xs sm:text-sm font-medium transition-colors whitespace-nowrap',
              index === 0
                ? 'bg-surface-dark text-ink-on-dark is-active'
                : 'bg-surface-2 text-ink border border-ink-hairline hover:border-ink-faint',
            ]}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`product-panel-${c.id}`}
            data-product-tab={c.id}
            tabindex={index === 0 ? 0 : -1}
          >
            {tabLabels[c.id] ?? c.name}
          </button>
        ))
      }
    </div>

    <div class="product-panels flex-1 min-h-0">
      {
        categories.map((c, index) => (
          <div
            id={`product-panel-${c.id}`}
            role="tabpanel"
            aria-labelledby={`product-tab-${c.id}`}
            class:list={['product-panel h-full min-h-0', index !== 0 && 'hidden']}
            data-product-panel={c.id}
            hidden={index !== 0}
          >
            <a
              href={c.href}
              class="group flex flex-col lg:flex-row lg:items-stretch h-full min-h-0 overflow-hidden rounded-helios-md bg-surface-2 transition-opacity duration-helios hover:opacity-95"
            >
              <div class="lg:w-1/2 min-h-0 flex-1 overflow-hidden shrink-0">
                <img
                  src={c.image}
                  alt=""
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="lg:w-1/2 min-h-0 flex-1 px-5 py-4 sm:px-8 sm:py-6 lg:px-10 lg:py-8 flex flex-col justify-center overflow-auto">
                <h3 class="text-[clamp(1.05rem,1.8vw,1.5rem)] font-medium text-ink mb-2 sm:mb-3">
                  {c.name}
                </h3>
                <p class="text-[clamp(0.8125rem,1.05vw,1rem)] leading-relaxed text-ink-soft">
                  {c.description}
                </p>
              </div>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script define:vars={{ defaultId }}>
  const tabs = Array.from(document.querySelectorAll('[data-product-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-product-panel]'));

  function activate(id) {
    tabs.forEach((tab) => {
      const active = tab.getAttribute('data-product-tab') === id;
      tab.classList.toggle('is-active', active);
      tab.classList.toggle('bg-surface-dark', active);
      tab.classList.toggle('text-ink-on-dark', active);
      tab.classList.toggle('bg-surface-2', !active);
      tab.classList.toggle('text-ink', !active);
      tab.classList.toggle('border', !active);
      tab.classList.toggle('border-ink-hairline', !active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.setAttribute('tabindex', active ? '0' : '-1');
    });

    panels.forEach((panel) => {
      const active = panel.getAttribute('data-product-panel') === id;
      panel.classList.toggle('hidden', !active);
      if (active) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-product-tab');
      if (id) activate(id);
    });
  });

  if (defaultId) activate(defaultId);
</script>
