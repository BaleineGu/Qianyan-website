---
import type { ProductCategory } from '@/types/halo';

interface Props {
  categories: ProductCategory[];
}

const { categories } = Astro.props;

/** Prefer Expandable → Capsule → Flat Pack first (matches site data order). */
const orderedCategories = [...categories].sort((a, b) => {
  const priority = ['expandable', 'capsule', 'flat-pack', 'folding', 'pools'];
  return priority.indexOf(a.id) - priority.indexOf(b.id);
});

const visibleCount = 3;
---

<section
  class="product-tabs-section bg-surface-1"
  data-header-theme="light"
  aria-labelledby="product-category-heading"
>
  <div class="section-container pt-6 sm:pt-8 lg:pt-10 pb-4 sm:pb-5">
    <div class="text-center max-w-[680px] mx-auto">
      <h2 id="product-category-heading" class="section-heading text-center">
        Product Category
      </h2>
    </div>
  </div>

  <div class="product-carousel section-container pb-8 sm:pb-10 lg:pb-12" data-product-carousel>
    <button
      type="button"
      class="product-carousel__nav product-carousel__nav--prev"
      data-carousel-prev
      aria-label="Previous products"
    >
      ‹
    </button>

    <div class="product-carousel__viewport">
      <div class="product-carousel__track" data-carousel-track>
        {
          orderedCategories.map((c, index) => (
            <a
              href={c.href}
              class="product-carousel__card group"
              data-carousel-card
            >
              <img
                src={c.image}
                alt=""
                class="product-carousel__image"
                loading={index < visibleCount ? 'eager' : 'lazy'}
                decoding="async"
              />
              <h3 class="product-carousel__title">{c.name}</h3>
            </a>
          ))
        }
      </div>
    </div>

    <button
      type="button"
      class="product-carousel__nav product-carousel__nav--next"
      data-carousel-next
      aria-label="Next products"
    >
      ›
    </button>
  </div>
</section>

<style>
  .product-carousel {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.5rem, 1.5vw, 1rem);
  }

  .product-carousel__viewport {
    overflow: hidden;
    width: 100%;
    min-width: 0;
    container-type: inline-size;
  }

  .product-carousel__track {
    --carousel-gap: clamp(0.65rem, 1.4vw, 1.15rem);
    display: flex;
    gap: var(--carousel-gap);
    transition: transform 0.45s ease;
    will-change: transform;
  }

  .product-carousel__card {
    position: relative;
    flex: 0 0 calc((100cqw - 2 * var(--carousel-gap)) / 3);
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid rgba(22, 21, 20, 0.12);
    background: #eceae4;
    text-decoration: none;
    color: inherit;
  }

  .product-carousel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.45s ease-out;
  }

  .product-carousel__card:hover .product-carousel__image {
    transform: scale(1.03);
  }

  .product-carousel__title {
    position: absolute;
    left: 50%;
    bottom: 12%;
    z-index: 2;
    margin: 0;
    max-width: calc(100% - 1.5rem);
    transform: translateX(-50%);
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    background: rgba(22, 21, 20, 0.48);
    color: #ffffff;
    font-size: clamp(0.8125rem, 1.35vw, 1.05rem);
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .product-carousel__nav {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(22, 21, 20, 0.16);
    border-radius: 999px;
    background: rgba(247, 245, 240, 0.92);
    color: #161514;
    font-size: 1.5rem;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background 0.2s ease,
      opacity 0.2s ease,
      border-color 0.2s ease;
  }

  .product-carousel__nav:hover:not(:disabled) {
    background: #ffffff;
    border-color: rgba(22, 21, 20, 0.28);
  }

  .product-carousel__nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  @media (max-width: 767px) {
    .product-carousel__card {
      flex-basis: 100cqw;
    }

    .product-carousel__track {
      --carousel-gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-carousel__track,
    .product-carousel__image {
      transition: none;
    }

    .product-carousel__card:hover .product-carousel__image {
      transform: none;
    }
  }
</style>

<script>
  function initProductCarousel(root) {
    const track = root.querySelector('[data-carousel-track]');
    const prevBtn = root.querySelector('[data-carousel-prev]');
    const nextBtn = root.querySelector('[data-carousel-next]');
    const cards = root.querySelectorAll('[data-carousel-card]');
    if (!track || !prevBtn || !nextBtn || cards.length === 0) return;

    const desktopVisible = 3;
    let offset = 0;

    const getVisibleCount = () => (window.matchMedia('(max-width: 767px)').matches ? 1 : desktopVisible);
    const getMaxOffset = () => Math.max(0, cards.length - getVisibleCount());

    const update = () => {
      const maxOffset = getMaxOffset();
      offset = Math.min(offset, maxOffset);
      const card = cards[0];
      const styles = getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
      const step = card.getBoundingClientRect().width + gap;
      track.style.transform = `translateX(-${offset * step}px)`;
      prevBtn.disabled = offset <= 0;
      nextBtn.disabled = offset >= maxOffset;
    };

    prevBtn.addEventListener('click', () => {
      offset = Math.max(0, offset - 1);
      update();
    });

    nextBtn.addEventListener('click', () => {
      offset = Math.min(getMaxOffset(), offset + 1);
      update();
    });

    window.addEventListener('resize', update);
    update();
  }

  document.querySelectorAll('[data-product-carousel]').forEach(initProductCarousel);
</script>
