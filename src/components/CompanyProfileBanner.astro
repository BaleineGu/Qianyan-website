---
const profileText =
  'Hebei Qianyan Metal Products Co., Ltd., located in Hengshui City, Hebei Province, is a modern enterprise integrating design, R&D, production, and export of prefabricated housing. The company\'s main products include expandable container homes, folding houses, space capsule house, and prefabricated container houses, widely used in engineering construction, temporary offices, camp dormitories, tourism and vacation homes, and emergency rescue, etc. Customized solutions can be provided according to project needs.';

const highlights = [
  {
    title: 'Modern Facility',
    description: 'Large-scale modern facility for stable production',
    icon: 'facility',
  },
  {
    title: 'Experienced Team',
    description: 'Professional team with rich industry experience',
    icon: 'team',
  },
  {
    title: 'Export Expertise',
    description: 'Years of export experience to global markets',
    icon: 'export',
  },
  {
    title: 'Customer First',
    description: 'Customer-first service from inquiry to after-sales',
    icon: 'customer',
  },
] as const;

const images = [
  {
    src: '/images/company/profile-1.png',
    alt: 'Integrated House Manufacturing Base factory entrance',
  },
  {
    src: '/images/company/profile-2.png',
    alt: 'Factory yard with modular glass building and warehouse',
  },
  {
    src: '/images/company/profile-3.png',
    alt: 'Factory workshop assembling modular container houses',
  },
];
---

<section class="py-section-sm lg:py-section-md bg-surface-1" aria-label="Company profile" data-header-theme="light">
  <div class="section-container">
    <h2 class="section-heading text-center mb-10 sm:mb-12 lg:mb-14">
      About Us
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 lg:items-stretch">
      <div class="order-2 lg:order-1 min-w-0 w-full flex flex-col justify-center gap-5 sm:gap-6 lg:gap-8 overflow-hidden pr-0 lg:pr-2">
        <h3 class="text-[clamp(1.5rem,2.8vw,2.5rem)] font-medium tracking-tight text-ink leading-tight">
          Company Profile
        </h3>
        <p class="text-[clamp(1rem,1.45vw,1.25rem)] text-ink-soft leading-[1.8]">
          {profileText}
        </p>

        <ul class="profile-highlights" aria-label="Company strengths">
          {
            highlights.map((item) => (
              <li class="profile-highlights__item">
                <span class="profile-highlights__icon" aria-hidden="true">
                  {item.icon === 'facility' && (
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M10 40V14l10-6 8 5v3h10v24H10Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <path d="M18 40V28h8v12" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                      <path d="M14 20h4M14 25h4M28 22h4M28 27h4M28 32h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === 'team' && (
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="24" cy="16" r="5" stroke="currentColor" stroke-width="1.8" />
                      <path d="M12 36c0-5.5 5.4-10 12-10s12 4.5 12 10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      <circle cx="12" cy="18" r="3.5" stroke="currentColor" stroke-width="1.8" />
                      <path d="M6 34c0-3.8 3-7 7-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      <circle cx="36" cy="18" r="3.5" stroke="currentColor" stroke-width="1.8" />
                      <path d="M42 34c0-3.8-3-7-7-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                  )}
                  {item.icon === 'export' && (
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M14 38V12h16l4 4v22H14Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                      <path d="M30 12v4h4" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
                      <path d="M20 30v-6h3v6M25 30v-9h3v9M30 30v-4h3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M19 26l10-7 2 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {item.icon === 'customer' && (
                    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path
                        d="M12 24c0-2 1.5-4 4-4h6l2 3 2-3h6c2.5 0 4 2 4 4v2c0 5-4 9-10 9h-4c-6 0-10-4-10-9v-2Z"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <path d="M18 20c0-3 2.2-5.5 5-5.5h2c2.8 0 5 2.5 5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      <path d="M14 28h20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <div class="profile-highlights__copy">
                  <strong class="profile-highlights__title">{item.title}</strong>
                  <p class="profile-highlights__desc">{item.description}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      {/* 品字形：上 1，下 2 — 右半区 */}
      <div class="order-1 lg:order-2 min-w-0 w-full grid grid-cols-2 gap-3 sm:gap-4">
        <div class="col-span-2 overflow-hidden rounded-helios-md border border-ink-hairline bg-surface-2 aspect-[16/9]">
          <img
            src={images[0].src}
            alt={images[0].alt}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
        <div class="overflow-hidden rounded-helios-md border border-ink-hairline bg-surface-2 aspect-[4/3]">
          <img
            src={images[1].src}
            alt={images[1].alt}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
        <div class="overflow-hidden rounded-helios-md border border-ink-hairline bg-surface-2 aspect-[4/3]">
          <img
            src={images[2].src}
            alt={images[2].alt}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-highlights {
    list-style: none;
    margin: 0;
    padding: 0.75rem 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
    border-top: 1px solid rgba(22, 21, 20, 0.1);
  }

  .profile-highlights__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    min-width: 0;
  }

  .profile-highlights__icon {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    color: #161514;
  }

  .profile-highlights__icon svg {
    width: 100%;
    height: 100%;
  }

  .profile-highlights__copy {
    min-width: 0;
  }

  .profile-highlights__title {
    display: block;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    font-weight: 700;
    color: #161514;
    line-height: 1.3;
  }

  .profile-highlights__desc {
    margin: 0.2rem 0 0;
    font-size: clamp(0.8rem, 1.05vw, 0.9rem);
    line-height: 1.45;
    color: rgba(22, 21, 20, 0.62);
  }

  @media (min-width: 1024px) {
    .profile-highlights {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.15rem 1.5rem;
      padding-top: 1rem;
    }
  }
</style>
