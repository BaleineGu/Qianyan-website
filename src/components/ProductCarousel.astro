---
import type { ProductItem } from '@/types/halo';

interface Props {
  products: ProductItem[];
}

const { products } = Astro.props;
---

<section class="py-20 lg:py-28 bg-gray-50" aria-label="Product showcase">
  <div class="section-container">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-900 mb-3">Our Products</h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Explore the lineup trusted by industry leaders around the globe.
      </p>
    </div>

    <div class="relative">
      <div id="product-track" class="flex gap-6 overflow-hidden">
        {
          products.map((product) => (
            <article class="product-card flex-shrink-0 w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
              <a href={product.href} class="group block bg-white rounded-2xl shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden">
                <div class="aspect-[4/3] overflow-hidden">
                  <img
                    src={product.image}
                    alt={product.name}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
                <div class="p-6">
                  <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider mb-1">
                    {product.tagline}
                  </p>
                  <h3 class="text-xl font-bold text-brand-900 mb-2 group-hover:text-brand-600 transition-colors">
                    {product.name}
                  </h3>
                  <p class="text-sm text-gray-600 leading-relaxed">
                    {product.description}
                  </p>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div class="flex items-center justify-center gap-4 mt-8">
        <button
          id="product-prev"
          class="w-10 h-10 rounded-full border border-gray-300 text-gray-600 hover:border-brand-500 hover:text-brand-500 transition-colors flex items-center justify-center"
          aria-label="Previous products"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
            ></path>
          </svg>
        </button>
        <button
          id="product-next"
          class="w-10 h-10 rounded-full border border-gray-300 text-gray-600 hover:border-brand-500 hover:text-brand-500 transition-colors flex items-center justify-center"
          aria-label="Next products"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ productCount: products.length }}>
  let offset = 0;

  const track = document.getElementById('product-track');
  const cards = document.querySelectorAll('.product-card');

  function getVisibleCount() {
    if (window.innerWidth >= 1024) return 3;
    if (window.innerWidth >= 640) return 2;
    return 1;
  }

  function getMaxOffset() {
    return Math.max(0, productCount - getVisibleCount());
  }

  function updateTrack() {
    if (!track || cards.length === 0) return;

    const cardWidth = cards[0].offsetWidth;
    const gap = 24;
    track.style.transform = `translateX(-${offset * (cardWidth + gap)}px)`;
    track.style.transition = 'transform 0.5s ease';
  }

  document.getElementById('product-prev')?.addEventListener('click', () => {
    offset = Math.max(0, offset - 1);
    updateTrack();
  });

  document.getElementById('product-next')?.addEventListener('click', () => {
    offset = Math.min(getMaxOffset(), offset + 1);
    updateTrack();
  });

  window.addEventListener('resize', () => {
    offset = Math.min(offset, getMaxOffset());
    updateTrack();
  });
</script>

<style>
  #product-track {
    transition: transform 0.5s ease;
  }
</style>
