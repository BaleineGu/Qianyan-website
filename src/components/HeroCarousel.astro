---
import type { HeroSlide } from '@/types/halo';
import { whatsappUrl } from '@/data/site';

interface Props {
  slides: HeroSlide[];
}

const { slides } = Astro.props;
const optimizedSlides = slides.map((slide) => ({
  ...slide,
  mobileImage: slide.image.replace(/\.webp$/, '-mobile.webp'),
}));
---

<section class="relative w-full overflow-hidden" aria-label="Hero carousel" data-header-theme="dark">
  <div id="hero-carousel" class="relative">
    {
      optimizedSlides.map((slide, index) => (
        <div
          class:list={[
            'hero-slide absolute inset-0 transition-opacity duration-700',
            index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0',
          ]}
          data-index={index}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="hero-slide__frame relative w-full min-h-[calc(100svh-56px)] lg:min-h-[952px] flex items-end sm:items-center">
            <picture class="absolute inset-0 w-full h-full">
              <source
                media="(max-width: 767px)"
                srcset={index === 0 ? slide.mobileImage : undefined}
                data-srcset={index === 0 ? undefined : slide.mobileImage}
              />
              <img
                src={index === 0 ? slide.image : undefined}
                data-src={index === 0 ? undefined : slide.image}
                alt={slide.imageAlt ?? ''}
                class="w-full h-full object-cover object-center"
                width="1920"
                height="900"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
                fetchpriority={index === 0 ? 'high' : 'auto'}
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/35 to-black/20 sm:bg-[rgba(22,21,20,0.32)]" />
            <div class="relative z-10 w-full section-container pb-28 pt-24 sm:py-24">
              <div class="max-w-[912px]">
                <h1 class="heading-h1 text-ink-on-dark mb-5">
                  {slide.title}
                </h1>
                <p class="text-[16px] leading-7 text-ink-on-dark-soft mb-8 max-w-[680px] whitespace-pre-line">
                  {slide.subtitle}
                </p>
                <div class="hero-actions flex flex-wrap gap-3">
                  {slide.primaryCta.action === 'inquiry' ? (
                    <button type="button" data-inquiry-open class="btn-primary">
                      {slide.primaryCta.label}
                    </button>
                  ) : (
                    <a href={slide.primaryCta.href} class="btn-primary">
                      {slide.primaryCta.label}
                    </a>
                  )}
                  <a
                    href={slide.secondaryCta.href || whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary-dark"
                  >
                    {slide.secondaryCta.label}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="min-h-[calc(100svh-56px)] lg:min-h-[952px] invisible" aria-hidden="true"></div>
  <div class="absolute bottom-5 sm:bottom-8 left-0 right-0 z-20 section-container">
    <div class="flex items-center gap-3">
      <button id="hero-prev" class="w-10 h-10 rounded-full bg-overlay-glass text-ink-on-dark backdrop-blur-[8px] flex items-center justify-center" aria-label="Previous slide">‹</button>
      <div id="hero-dots" class="flex gap-2">
        {optimizedSlides.map((_, index) => (
          <button
            class="hero-dot grid h-11 min-w-11 place-items-center rounded-full"
            data-index={index}
            aria-label={`Go to slide ${index + 1}`}
          >
            <span
              class:list={[
                'hero-dot__indicator h-2.5 rounded-full transition-all duration-helios',
                index === 0 ? 'bg-ink-on-dark w-8' : 'bg-ink-on-dark-faint w-2.5',
              ]}
              aria-hidden="true"
            />
          </button>
        ))}
      </div>
      <button id="hero-next" class="w-10 h-10 rounded-full bg-overlay-glass text-ink-on-dark backdrop-blur-[8px] flex items-center justify-center" aria-label="Next slide">›</button>
    </div>
  </div>
</section>

<script define:vars={{ totalSlides: slides.length }}>
  let current = 0;
  const slideEls = document.querySelectorAll('.hero-slide');
  const dotEls = document.querySelectorAll('.hero-dot');

  function loadSlide(index) {
    const slide = slideEls[index];
    const source = slide?.querySelector('source[data-srcset]');
    const image = slide?.querySelector('img[data-src]');
    if (source?.dataset.srcset) {
      source.srcset = source.dataset.srcset;
      source.removeAttribute('data-srcset');
    }
    if (image?.dataset.src) {
      image.src = image.dataset.src;
      image.removeAttribute('data-src');
    }
  }

  function goTo(index) {
    const next = (index + totalSlides) % totalSlides;
    const currentIndicator = dotEls[current]?.querySelector('.hero-dot__indicator');
    const nextIndicator = dotEls[next]?.querySelector('.hero-dot__indicator');
    loadSlide(next);
    slideEls[current]?.classList.replace('opacity-100', 'opacity-0');
    slideEls[current]?.classList.replace('z-10', 'z-0');
    slideEls[current]?.setAttribute('aria-hidden', 'true');
    currentIndicator?.classList.remove('bg-ink-on-dark', 'w-8');
    currentIndicator?.classList.add('bg-ink-on-dark-faint', 'w-2.5');
    current = next;
    slideEls[current]?.classList.replace('opacity-0', 'opacity-100');
    slideEls[current]?.classList.replace('z-0', 'z-10');
    slideEls[current]?.setAttribute('aria-hidden', 'false');
    nextIndicator?.classList.remove('bg-ink-on-dark-faint', 'w-2.5');
    nextIndicator?.classList.add('bg-ink-on-dark', 'w-8');
  }
  document.getElementById('hero-prev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('hero-next')?.addEventListener('click', () => goTo(current + 1));
  dotEls.forEach((dot) => dot.addEventListener('click', () => goTo(Number(dot.dataset.index))));
</script>
