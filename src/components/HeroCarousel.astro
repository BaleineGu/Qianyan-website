---
import type { HeroSlide } from '@/types/halo';
import { whatsappUrl } from '@/data/site';

interface Props {
  slides: HeroSlide[];
}

const { slides } = Astro.props;
---

<section class="relative w-full overflow-hidden" aria-label="Hero carousel" data-header-theme="dark">
  <div id="hero-carousel" class="relative">
    {
      slides.map((slide, index) => (
        <div
          class:list={[
            'hero-slide absolute inset-0 transition-opacity duration-700',
            index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0',
          ]}
          data-index={index}
        >
          <div class="relative w-full min-h-[100vh] lg:min-h-[1120px]">
            <img
              src={slide.image}
              alt=""
              class="absolute inset-0 w-full h-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
            <div class="absolute inset-0" style="background: rgba(22, 21, 20, 0.32);" />
            <div class="relative z-10 h-full section-container flex items-center pt-24 sm:pt-28 lg:pt-32 pb-20">
              <div class="max-w-[912px]">
                <h1 class="heading-h1 text-ink-on-dark mb-5">
                  {slide.title}
                </h1>
                <p class="text-large text-ink-on-dark-soft mb-8 max-w-[680px] whitespace-pre-line">
                  {slide.subtitle}
                </p>
                <div class="flex flex-wrap gap-3">
                  {slide.primaryCta.action === 'inquiry' ? (
                    <button type="button" data-inquiry-open class="btn-primary">
                      {slide.primaryCta.label}
                    </button>
                  ) : (
                    <a href={slide.primaryCta.href} class="btn-primary">
                      {slide.primaryCta.label}
                    </a>
                  )}
                  <a
                    href={slide.secondaryCta.href || whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-secondary-dark"
                  >
                    {slide.secondaryCta.label}
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="min-h-[100vh] lg:min-h-[1120px] invisible" aria-hidden="true"></div>
  <div class="absolute bottom-8 left-0 right-0 z-20 section-container">
    <div class="flex items-center gap-3">
      <button id="hero-prev" class="w-10 h-10 rounded-full bg-overlay-glass text-ink-on-dark backdrop-blur-[8px] flex items-center justify-center" aria-label="Previous slide">‹</button>
      <div id="hero-dots" class="flex gap-2">
        {slides.map((_, index) => (
          <button
            class:list={['hero-dot h-2.5 rounded-full transition-all duration-helios', index === 0 ? 'bg-ink-on-dark w-8' : 'bg-ink-on-dark-faint w-2.5']}
            data-index={index}
            aria-label={`Go to slide ${index + 1}`}
          />
        ))}
      </div>
      <button id="hero-next" class="w-10 h-10 rounded-full bg-overlay-glass text-ink-on-dark backdrop-blur-[8px] flex items-center justify-center" aria-label="Next slide">›</button>
    </div>
  </div>
</section>

<script define:vars={{ totalSlides: slides.length }}>
  let current = 0;
  let timer = null;
  const slideEls = document.querySelectorAll('.hero-slide');
  const dotEls = document.querySelectorAll('.hero-dot');
  function goTo(index) {
    slideEls[current]?.classList.replace('opacity-100', 'opacity-0');
    slideEls[current]?.classList.replace('z-10', 'z-0');
    dotEls[current]?.classList.remove('bg-ink-on-dark', 'w-8');
    dotEls[current]?.classList.add('bg-ink-on-dark-faint', 'w-2.5');
    current = (index + totalSlides) % totalSlides;
    slideEls[current]?.classList.replace('opacity-0', 'opacity-100');
    slideEls[current]?.classList.replace('z-0', 'z-10');
    dotEls[current]?.classList.remove('bg-ink-on-dark-faint', 'w-2.5');
    dotEls[current]?.classList.add('bg-ink-on-dark', 'w-8');
  }
  function startAutoPlay() {
    if (timer) clearInterval(timer);
    timer = setInterval(() => goTo(current + 1), 6000);
  }
  document.getElementById('hero-prev')?.addEventListener('click', () => { goTo(current - 1); startAutoPlay(); });
  document.getElementById('hero-next')?.addEventListener('click', () => { goTo(current + 1); startAutoPlay(); });
  dotEls.forEach((dot) => dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); startAutoPlay(); }));
  startAutoPlay();
</script>
