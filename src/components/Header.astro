---
import { navLinks, siteConfig } from '@/data/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;

function isLinkActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---
<header class:list={['z-50 w-full border-b border-white/15 bg-black/60 backdrop-blur-md', overlay ? 'absolute top-0 left-0 right-0' : 'sticky top-0']}>
  <div class="section-container">
    <div class="flex items-center gap-3 sm:gap-4 h-16 sm:h-20 lg:h-24">
      <a href="/" class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1 lg:flex-none lg:max-w-[36%]">
        <img src={siteConfig.logo} alt="" class="h-10 w-auto shrink-0 sm:h-[54px] lg:h-[66px]" width="66" height="66" />
        <span class="text-white font-bold tracking-[0.08em] uppercase leading-tight truncate text-base sm:text-[21px] lg:text-[24px]">{siteConfig.name}</span>
      </a>
      <nav class="hidden xl:flex items-center justify-center gap-4 flex-1 min-w-0" aria-label="Main navigation">
        {navLinks.map((link) => {
          const children = 'children' in link ? link.children : undefined;
          const isActive = children
            ? isLinkActive(link.href) || children.some((child) => isLinkActive(child.href))
            : isLinkActive(link.href);

          if (children) {
            return (
              <div class="relative group shrink-0">
                <a
                  href={link.href}
                  class:list={[
                    'inline-flex items-center gap-1 text-[15px] 2xl:text-[17px] font-medium whitespace-nowrap transition-colors',
                    isActive ? 'text-brand-500' : 'text-white/85 hover:text-white',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                  aria-haspopup="true"
                >
                  {link.label}
                  <svg class="w-3.5 h-3.5 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                  </svg>
                </a>
                <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-opacity duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-3 min-w-[280px] z-50">
                  <div class="rounded-lg border border-white/10 bg-black/95 shadow-xl py-2">
                    {children.map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          'block px-4 py-2.5 text-[14px] 2xl:text-[15px] whitespace-nowrap transition-colors',
                          isLinkActive(child.href) ? 'text-brand-500 bg-white/5' : 'text-white/85 hover:text-white hover:bg-white/10',
                        ]}
                        aria-current={isLinkActive(child.href) ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              class:list={[
                'shrink-0 text-[15px] 2xl:text-[17px] font-medium whitespace-nowrap transition-colors',
                isActive ? 'text-brand-500' : 'text-white/85 hover:text-white',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </nav>
      <button type="button" data-inquiry-open class="hidden lg:inline-flex btn-primary shrink-0 text-[16px] py-2.5 px-5">Get a Factory Quote</button>
      <button id="mobile-menu-btn" class="xl:hidden ml-auto p-2 rounded-lg text-white hover:bg-white/10 shrink-0" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
    <nav id="mobile-menu" class="hidden xl:hidden pb-4 border-t border-white/15 bg-black/70 -mx-4 px-4 sm:-mx-6 sm:px-6" aria-label="Mobile navigation">
      <div class="flex flex-col gap-1 pt-3">
        {navLinks.map((link) => {
          const children = 'children' in link ? link.children : undefined;
          if (children) {
            return (
              <div class="flex flex-col">
                <a href={link.href} class="px-3 py-2.5 rounded-lg text-[18px] font-medium text-white/85 hover:bg-white/10 hover:text-white">{link.label}</a>
                <div class="ml-3 border-l border-white/15 pl-2 flex flex-col">
                  {children.map((child) => (
                    <a href={child.href} class="px-3 py-2 rounded-lg text-[16px] text-white/75 hover:bg-white/10 hover:text-white">{child.label}</a>
                  ))}
                </div>
              </div>
            );
          }
          return (
            <a href={link.href} class="px-3 py-2.5 rounded-lg text-[18px] font-medium text-white/85 hover:bg-white/10 hover:text-white">{link.label}</a>
          );
        })}
        <button type="button" data-inquiry-open class="mt-2 btn-primary text-center text-[18px] w-full">Get a Factory Quote</button>
      </div>
    </nav>
  </div>
</header>
<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    if (!menu || !btn) return;
    btn.setAttribute('aria-expanded', String(menu.classList.toggle('hidden') === false));
  });
  window.addEventListener('resize', () => {
    if (!menu || !btn) return;
    if (window.innerWidth >= 1280 && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
