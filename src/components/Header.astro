---
import { navLinks, siteConfig } from '@/data/site';

interface Props {
  /** Overlay mode: header sits on top of hero at page top */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class:list={[
    'z-50 border-b border-white/10',
    overlay
      ? 'absolute top-0 left-0 right-0 bg-gradient-to-b from-black/50 to-transparent border-transparent'
      : 'sticky top-0 bg-brand-900/95 backdrop-blur',
  ]}
>
  <div class="section-container">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href="/" class="flex items-center gap-3 group min-w-0">
        <img
          src={siteConfig.logo}
          alt=""
          class="h-9 w-auto shrink-0 lg:h-11"
          width="44"
          height="44"
        />
        <span class="text-white font-bold tracking-[0.12em] uppercase leading-tight text-sm sm:text-base lg:text-lg truncate">
          {siteConfig.name}
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
        {
          navLinks.map((link) => {
            const isActive =
              link.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'text-sm font-medium transition-colors',
                  isActive
                    ? 'text-brand-500'
                    : 'text-white/80 hover:text-white',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <a href="/contact" class="hidden md:inline-flex btn-primary text-sm py-2.5 px-5">
        Get in Touch
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg text-white hover:bg-white/10"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-4 border-t border-white/10"
      aria-label="Mobile navigation"
    >
      <div class="flex flex-col gap-1 pt-3">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2.5 rounded-lg text-sm font-medium text-white/80 hover:bg-white/10 hover:text-white"
            >
              {link.label}
            </a>
          ))
        }
        <a href="/contact" class="mt-2 btn-primary text-center text-sm">
          Get in Touch
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
