---
import { navLinks, siteConfig } from '@/data/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;

function isLinkActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---
<header
  id="site-header"
  data-theme="dark"
  class="site-header fixed top-0 left-0 right-0 z-50 w-full pointer-events-none"
>
  <div
    id="site-header-shell"
    class="site-header__shell pointer-events-auto w-full border-b transition-[background-color,border-color,box-shadow] duration-300"
  >
    <div class="site-header__scale-wrap relative w-full h-[44px] sm:h-[56px] lg:h-[65px] overflow-x-clip overflow-y-visible">
      <div
        id="site-header-row"
        class="site-header__row flex items-center gap-3 sm:gap-4 h-full w-max min-w-full px-4 sm:px-6 lg:px-8 origin-left"
      >
          <a href="/" class="flex items-center gap-2 sm:gap-3 shrink-0">
            <img
              src={siteConfig.logo}
              alt=""
              class="site-header__logo h-8 w-auto shrink-0 sm:h-[43px] lg:h-[53px] transition-[filter] duration-300"
              width="53"
              height="53"
            />
            <span class="site-header__brand font-bold tracking-[0.16em] uppercase leading-tight whitespace-nowrap text-sm sm:text-[17px] lg:text-[19px]">{siteConfig.name}</span>
          </a>
          <nav class="hidden xl:flex items-center justify-center gap-8 flex-1 min-w-0" aria-label="Main navigation">
            {navLinks.map((link) => {
              const children = 'children' in link ? link.children : undefined;
              const isActive = children
                ? isLinkActive(link.href) || children.some((child) => isLinkActive(child.href))
                : isLinkActive(link.href);

              if (children) {
                return (
                  <div class="relative group shrink-0">
                    <a
                      href={link.href}
                      class:list={[
                        'site-header__link inline-flex items-center gap-1 text-[15px] 2xl:text-[17px] font-medium tracking-[0.08em] whitespace-nowrap transition-colors',
                        isActive && 'is-active',
                      ]}
                      aria-current={isActive ? 'page' : undefined}
                      aria-haspopup="true"
                    >
                      {link.label}
                      <svg class="w-3.5 h-3.5 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </a>
                    <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-opacity duration-150 absolute left-1/2 -translate-x-1/2 top-full pt-3 min-w-[280px] z-50">
                      <div class="site-header__dropdown rounded-lg border shadow-xl py-2">
                        {children.map((child) => (
                          <a
                            href={child.href}
                            class:list={[
                              'site-header__dropdown-link block px-4 py-2.5 text-[14px] 2xl:text-[15px] tracking-[0.08em] whitespace-nowrap transition-colors',
                              isLinkActive(child.href) && 'is-active',
                            ]}
                            aria-current={isLinkActive(child.href) ? 'page' : undefined}
                          >
                            {child.label}
                          </a>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              }

              return (
                <a
                  href={link.href}
                  class:list={[
                    'site-header__link shrink-0 text-[15px] 2xl:text-[17px] font-medium tracking-[0.08em] whitespace-nowrap transition-colors',
                    isActive && 'is-active',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </nav>
          <button id="mobile-menu-btn" class="site-header__icon xl:hidden ml-auto p-2 rounded-lg shrink-0" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" class="site-header__mobile hidden xl:hidden pb-4 border-t px-4 sm:px-6 lg:px-8" aria-label="Mobile navigation">
        <div class="flex flex-col gap-1 pt-3">
          {navLinks.map((link) => {
            const children = 'children' in link ? link.children : undefined;
            if (children) {
              return (
                <div class="flex flex-col">
                  <a href={link.href} class="site-header__mobile-link px-3 py-2.5 rounded-lg text-[18px] font-medium">{link.label}</a>
                  <div class="ml-3 border-l site-header__mobile-divider pl-2 flex flex-col">
                    {children.map((child) => (
                      <a href={child.href} class="site-header__mobile-link px-3 py-2 rounded-lg text-[16px]">{child.label}</a>
                    ))}
                  </div>
                </div>
              );
            }
            return (
              <a href={link.href} class="site-header__mobile-link px-3 py-2.5 rounded-lg text-[18px] font-medium">{link.label}</a>
            );
          })}
        </div>
      </nav>
  </div>
</header>
{!overlay && <div id="site-header-spacer" class="h-[44px] sm:h-[56px] lg:h-[65px]" aria-hidden="true" />}

<style>
  .site-header__shell {
    border-radius: 0;
    backdrop-filter: blur(18px) saturate(1.35);
    -webkit-backdrop-filter: blur(18px) saturate(1.35);
  }

  .site-header[data-theme='dark'] .site-header__shell {
    background-color: rgb(22 21 20 / 0.72);
    border-color: rgb(255 255 255 / 0.16);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 8px 28px rgb(0 0 0 / 0.18);
  }

  .site-header[data-theme='dark'] .site-header__logo {
    filter: none;
  }

  .site-header[data-theme='dark'] .site-header__brand,
  .site-header[data-theme='dark'] .site-header__icon {
    color: white;
  }

  .site-header[data-theme='dark'] .site-header__link {
    color: rgb(255 255 255 / 0.85);
  }

  .site-header[data-theme='dark'] .site-header__link:hover {
    color: white;
  }

  .site-header[data-theme='dark'] .site-header__link.is-active {
    color: rgb(14 165 233);
  }

  .site-header[data-theme='dark'] .site-header__dropdown {
    background-color: rgb(22 21 20 / 0.72);
    border-color: rgb(255 255 255 / 0.16);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
  }

  .site-header[data-theme='dark'] .site-header__dropdown-link {
    color: rgb(255 255 255 / 0.85);
  }

  .site-header[data-theme='dark'] .site-header__dropdown-link:hover {
    color: white;
    background-color: rgb(255 255 255 / 0.1);
  }

  .site-header[data-theme='dark'] .site-header__dropdown-link.is-active {
    color: rgb(14 165 233);
    background-color: rgb(255 255 255 / 0.05);
  }

  .site-header[data-theme='dark'] .site-header__mobile {
    border-color: rgb(255 255 255 / 0.15);
    background-color: transparent;
  }

  .site-header[data-theme='dark'] .site-header__mobile-divider {
    border-color: rgb(255 255 255 / 0.15);
  }

  .site-header[data-theme='dark'] .site-header__mobile-link {
    color: rgb(255 255 255 / 0.85);
  }

  .site-header[data-theme='dark'] .site-header__mobile-link:hover {
    color: white;
    background-color: rgb(255 255 255 / 0.1);
  }

  .site-header[data-theme='dark'] .site-header__icon:hover {
    background-color: rgb(255 255 255 / 0.1);
  }

  .site-header[data-theme='light'] .site-header__shell {
    background-color: rgb(247 245 240 / 0.92);
    border-color: rgb(22 21 20 / 0.08);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.65),
      0 8px 28px rgb(22 21 20 / 0.08);
  }

  .site-header[data-theme='light'] .site-header__logo {
    filter: brightness(0) saturate(100%);
  }

  .site-header[data-theme='light'] .site-header__brand,
  .site-header[data-theme='light'] .site-header__icon {
    color: rgb(15 23 42);
  }

  .site-header[data-theme='light'] .site-header__link {
    color: rgb(51 65 85);
  }

  .site-header[data-theme='light'] .site-header__link:hover {
    color: rgb(15 23 42);
  }

  .site-header[data-theme='light'] .site-header__link.is-active {
    color: rgb(2 132 199);
  }

  .site-header[data-theme='light'] .site-header__dropdown {
    background-color: rgb(255 255 255 / 0.78);
    border-color: rgb(229 231 235 / 0.8);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 10px 30px rgb(22 21 20 / 0.1);
  }

  .site-header[data-theme='light'] .site-header__dropdown-link {
    color: rgb(51 65 85);
  }

  .site-header[data-theme='light'] .site-header__dropdown-link:hover {
    color: rgb(15 23 42);
    background-color: rgb(241 245 249);
  }

  .site-header[data-theme='light'] .site-header__dropdown-link.is-active {
    color: rgb(2 132 199);
    background-color: rgb(240 249 255);
  }

  .site-header[data-theme='light'] .site-header__mobile {
    border-color: rgb(229 231 235);
    background-color: transparent;
  }

  .site-header[data-theme='light'] .site-header__mobile-divider {
    border-color: rgb(229 231 235);
  }

  .site-header[data-theme='light'] .site-header__mobile-link {
    color: rgb(51 65 85);
  }

  .site-header[data-theme='light'] .site-header__mobile-link:hover {
    color: rgb(15 23 42);
    background-color: rgb(241 245 249);
  }

  .site-header[data-theme='light'] .site-header__icon:hover {
    background-color: rgb(241 245 249);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const shell = document.getElementById('site-header-shell');
  const row = document.getElementById('site-header-row');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    if (!menu || !btn) return;
    btn.setAttribute('aria-expanded', String(menu.classList.toggle('hidden') === false));
  });

  window.addEventListener('resize', () => {
    if (!menu || !btn) return;
    if (window.innerWidth >= 1280 && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });

  function fitHeaderScale() {
    if (!shell || !row) return;

    row.style.transform = 'scale(1)';

    const available = shell.clientWidth;
    const needed = row.scrollWidth;
    const scale = needed > available + 1 ? Math.max(0.55, available / needed) : 1;

    row.style.transform = scale < 1 ? `scale(${scale})` : '';
  }

  function parseRgb(color: string): [number, number, number] | null {
    const match = color.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/i);
    if (!match) return null;
    return [Number(match[1]), Number(match[2]), Number(match[3])];
  }

  function luminance(r: number, g: number, b: number) {
    return (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  }

  function detectThemeFromElement(el: Element | null): 'light' | 'dark' | null {
    let node: Element | null = el;
    while (node && node !== document.documentElement) {
      if (node instanceof HTMLElement) {
        const marked = node.dataset.headerTheme;
        if (marked === 'dark' || marked === 'light') return marked;

        if (node.matches('img, video, canvas, picture')) return 'dark';

        const cls = typeof node.className === 'string' ? node.className : '';
        if (/\bsurface-dark\b|\bbg-surface-dark\b|\bbg-brand-9|\bbg-black\b|\bfrom-surface-dark|\bfrom-brand-9/.test(cls)) {
          return 'dark';
        }
        if (/\bsurface-light\b|\bbg-surface-1\b|\bbg-surface-2\b|\bbg-surface-3\b|\bbg-white\b|\bbg-gray-50\b|\bbg-gray-100\b/.test(cls)) {
          return 'light';
        }
      }

      const bg = getComputedStyle(node).backgroundColor;
      const rgb = parseRgb(bg);
      if (rgb) {
        const alphaMatch = bg.match(/rgba?\([^)]*,\s*([0-9.]+)\s*\)/i);
        const alpha = alphaMatch ? Number(alphaMatch[1]) : 1;
        if (alpha >= 0.45) {
          return luminance(...rgb) >= 0.58 ? 'light' : 'dark';
        }
      }

      node = node.parentElement;
    }
    return null;
  }

  function updateHeaderTheme() {
    if (!header || !shell) return;

    const rect = shell.getBoundingClientRect();
    const sampleY = Math.min(window.innerHeight - 1, rect.bottom + 4);
    const sampleXs = [0.2, 0.5, 0.8].map((ratio) => rect.left + rect.width * ratio);

    shell.style.pointerEvents = 'none';
    let lightVotes = 0;
    let darkVotes = 0;

    for (const x of sampleXs) {
      const el = document.elementFromPoint(x, sampleY);
      const theme = detectThemeFromElement(el);
      if (theme === 'light') lightVotes += 1;
      else if (theme === 'dark') darkVotes += 1;
    }

    shell.style.pointerEvents = '';

    const nextTheme = lightVotes >= darkVotes ? 'light' : 'dark';
    if (header.dataset.theme !== nextTheme) {
      header.dataset.theme = nextTheme;
    }
  }

  let ticking = false;
  function onScrollOrResize() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      fitHeaderScale();
      updateHeaderTheme();
      ticking = false;
    });
  }

  fitHeaderScale();
  updateHeaderTheme();
  window.addEventListener('scroll', onScrollOrResize, { passive: true });
  window.addEventListener('resize', onScrollOrResize);

  if (typeof ResizeObserver !== 'undefined' && shell) {
    new ResizeObserver(() => {
      fitHeaderScale();
    }).observe(shell);
  }
</script>
