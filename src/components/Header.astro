---
import { navLinks, siteConfig } from '@/data/site';

interface Props {
  /** Overlay mode: header sits on top of hero at page top */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class:list={[
    'z-50 w-full border-b border-white/15 bg-black/60 backdrop-blur-md',
    overlay ? 'absolute top-0 left-0 right-0' : 'sticky top-0',
  ]}
>
  <div class="section-container">
    <div class="flex items-center gap-3 sm:gap-4 h-16 sm:h-20 lg:h-24">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2 sm:gap-3 min-w-0 flex-1 lg:flex-none lg:max-w-[42%]">
        <img
          src={siteConfig.logo}
          alt=""
          class="h-10 w-auto shrink-0 sm:h-[54px] lg:h-[66px]"
          width="66"
          height="66"
        />
        <span
          class="text-white font-bold tracking-[0.08em] uppercase leading-tight truncate
                 text-base sm:text-[21px] lg:text-[27px]"
        >
          {siteConfig.name}
        </span>
      </a>

      <!-- Desktop nav: lg+ only to avoid mid-width overlap -->
      <nav
        class="hidden lg:flex items-center justify-center gap-5 xl:gap-8 flex-1 min-w-0"
        aria-label="Main navigation"
      >
        {
          navLinks.map((link) => {
            const isActive =
              link.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'shrink-0 text-[18px] xl:text-[21px] font-medium transition-colors whitespace-nowrap',
                  isActive
                    ? 'text-brand-500'
                    : 'text-white/85 hover:text-white',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
      </nav>

      <!-- CTA: xl+ to keep mid screens clean -->
      <button
        type="button"
        data-inquiry-open
        class="hidden xl:inline-flex btn-primary shrink-0 text-[18px] py-2.5 px-5"
      >
        Get a Factory Quote
      </button>

      <!-- Mobile / tablet menu toggle -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden ml-auto p-2 rounded-lg text-white hover:bg-white/10 shrink-0"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile / tablet panel -->
    <nav
      id="mobile-menu"
      class="hidden lg:hidden pb-4 border-t border-white/15 bg-black/70 -mx-4 px-4 sm:-mx-6 sm:px-6"
      aria-label="Mobile navigation"
    >
      <div class="flex flex-col gap-1 pt-3">
        {
          navLinks.map((link) => {
            const isActive =
              link.href === '/'
                ? currentPath === '/'
                : currentPath.startsWith(link.href);
            return (
              <a
                href={link.href}
                class:list={[
                  'px-3 py-2.5 rounded-lg text-[18px] font-medium transition-colors',
                  isActive
                    ? 'text-brand-500 bg-white/10'
                    : 'text-white/85 hover:bg-white/10 hover:text-white',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })
        }
        <a href="/contact" class="mt-2 btn-primary text-center text-[18px]">
          Contact Us
        </a>
        <button type="button" data-inquiry-open class="mt-2 btn-primary text-center text-[18px] w-full">
          Get a Factory Quote
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    if (!menu || !btn) return;
    const isOpen = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });

  // Close mobile menu when resizing up to desktop
  window.addEventListener('resize', () => {
    if (!menu || !btn) return;
    if (window.innerWidth >= 1024 && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
    }
  });
</script>
