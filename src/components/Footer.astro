---
import { footerLinks, siteConfig, whatsappUrl } from '@/data/site';
const year = new Date().getFullYear();
---
<footer class="bg-brand-900 text-gray-300">
  <div class="section-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img src={siteConfig.logo} alt="" class="h-10 w-auto" width="40" height="40" />
          <span class="text-sm font-bold text-white tracking-[0.12em] uppercase">{siteConfig.name}</span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed">{siteConfig.tagline}</p>
      </div>
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Products</h3>
        <ul class="space-y-2.5">{footerLinks.products.map((l) => <li><a href={l.href} class="text-sm hover:text-brand-500">{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Support</h3>
        <ul class="space-y-2.5">{footerLinks.support.map((l) => <li><a href={l.href} class="text-sm hover:text-brand-500" target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Contact</h3>
        <ul class="space-y-2.5">{footerLinks.contact.map((l) => <li><a href={l.href} class="text-sm hover:text-brand-500">{l.label}</a></li>)}</ul>
        <div class="mt-4 text-sm text-gray-400 space-y-1">
          <p>{siteConfig.email}</p>
          <p>{siteConfig.phone}</p>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-2 text-brand-500">WhatsApp Sales</a>
        </div>
      </div>
    </div>
    <div class="mt-12 pt-8 border-t border-gray-700 text-sm text-gray-500">&copy; {year} {siteConfig.name}. All rights reserved.</div>
  </div>
</footer>
