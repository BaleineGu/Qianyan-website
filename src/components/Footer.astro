---
import { footerLinks, siteConfig } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="bg-brand-900 text-gray-300">
  <div class="section-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <span
            class="w-8 h-8 rounded-lg bg-brand-500 flex items-center justify-center text-white font-bold text-sm"
          >
            N
          </span>
          <span class="text-lg font-bold text-white">{siteConfig.name}</span>
        </div>
        <p class="text-sm leading-relaxed text-gray-400">
          {siteConfig.tagline}
        </p>
      </div>

      <!-- About -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">About</h3>
        <ul class="space-y-2.5">
          {
            footerLinks.company.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-brand-500 transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Support -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Support</h3>
        <ul class="space-y-2.5">
          {
            footerLinks.support.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-brand-500 transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">Contact</h3>
        <ul class="space-y-2.5">
          {
            footerLinks.contact.map((link) => (
              <li>
                <a href={link.href} class="text-sm hover:text-brand-500 transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-4 space-y-1 text-sm text-gray-400">
          <p>{siteConfig.email}</p>
          <p>{siteConfig.phone}</p>
        </div>
      </div>
    </div>

    <div
      class="mt-12 pt-8 border-t border-gray-700 flex flex-col sm:flex-row items-center justify-between gap-4"
    >
      <p class="text-sm text-gray-500">
        &copy; {year} {siteConfig.name}. All rights reserved.
      </p>
      <div class="flex gap-6 text-sm">
        <a href="/about" class="hover:text-brand-500 transition-colors">Privacy Policy</a>
        <a href="/about" class="hover:text-brand-500 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
