---
import { footerLinks, siteConfig, whatsappUrl } from '@/data/site';

interface Props {
  title?: string;
  /** Embed site footer links under the title (homepage CTA). */
  includeSiteLinks?: boolean;
}

const {
  title = 'Need specs, layouts, or a shipping estimate for your project site?',
  includeSiteLinks = false,
} = Astro.props;
---

<section
  class="conversion-cta py-6 sm:py-8 lg:py-10 bg-surface-dark text-ink-on-dark"
  data-header-theme="dark"
>
  <div
    class:list={[
      'section-container grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14',
      'lg:items-center',
    ]}
  >
    <div class:list={['conversion-cta__left', includeSiteLinks && 'conversion-cta__left--with-links']}>
      <h2 class="conversion-cta__title">
        {title}
      </h2>

      {
        includeSiteLinks && (
          <div class="conversion-cta__site-links" aria-label="Site links">
            <div class="conversion-cta__brand">
              <div class="conversion-cta__brand-row">
                <img
                  src={siteConfig.logo}
                  alt=""
                  class="conversion-cta__logo"
                  width="36"
                  height="36"
                />
                <span class="conversion-cta__brand-name">{siteConfig.name}</span>
              </div>
              <p class="conversion-cta__tagline">{siteConfig.tagline}</p>
            </div>

            <div>
              <h3 class="conversion-cta__nav-title">Products</h3>
              <ul class="conversion-cta__nav-list">
                {footerLinks.products.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="conversion-cta__nav-title">Support</h3>
              <ul class="conversion-cta__nav-list">
                {footerLinks.support.map((l) => (
                  <li>
                    <a
                      href={l.href}
                      target={l.href.startsWith('http') ? '_blank' : undefined}
                      rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                    >
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="conversion-cta__nav-title">Contact</h3>
              <ul class="conversion-cta__nav-list">
                {footerLinks.contact.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
              <div class="conversion-cta__contact-meta">
                <p>{siteConfig.email}</p>
                <p>{siteConfig.phone}</p>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                  WhatsApp sales
                </a>
              </div>
            </div>
          </div>
        )
      }
    </div>

    <div class="w-full bg-surface-2 text-ink rounded-helios-md p-5 sm:p-7 lg:p-8">
      <h3 class="heading-h6 text-ink mb-2">Get a factory quote</h3>
      <p class="text-small text-ink-soft mb-5 sm:mb-6">
        Tell us your market, product type, and destination. Our export team will respond with practical options.
      </p>

      <form id="cta-inquiry-form" class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div>
          <label for="cta-inquiry-name" class="block text-small font-medium text-ink mb-1">Name</label>
          <input
            id="cta-inquiry-name"
            name="name"
            type="text"
            required
            class="w-full px-4 py-2.5 rounded-helios-sm border border-ink-hairline bg-surface-1 outline-none focus:ring-2 focus:ring-accent-1"
          />
        </div>
        <div>
          <label for="cta-inquiry-email" class="block text-small font-medium text-ink mb-1">Email</label>
          <input
            id="cta-inquiry-email"
            name="email"
            type="email"
            required
            class="w-full px-4 py-2.5 rounded-helios-sm border border-ink-hairline bg-surface-1 outline-none focus:ring-2 focus:ring-accent-1"
          />
        </div>
        <div>
          <label for="cta-inquiry-country" class="block text-small font-medium text-ink mb-1">Destination country / zip</label>
          <input
            id="cta-inquiry-country"
            name="country"
            type="text"
            required
            class="w-full px-4 py-2.5 rounded-helios-sm border border-ink-hairline bg-surface-1 outline-none focus:ring-2 focus:ring-accent-1"
          />
        </div>
        <div>
          <label for="cta-inquiry-product" class="block text-small font-medium text-ink mb-1">Product interest</label>
          <select
            id="cta-inquiry-product"
            name="product"
            class="w-full px-4 py-2.5 rounded-helios-sm border border-ink-hairline bg-surface-1 outline-none focus:ring-2 focus:ring-accent-1"
          >
            <option>Expandable Container Homes</option>
            <option>Space Capsule Houses</option>
            <option>Flat Pack Container Houses</option>
            <option>Folding Houses</option>
            <option>Container Swimming Pools</option>
            <option>Catalog Download</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="cta-inquiry-message" class="block text-small font-medium text-ink mb-1">Project details</label>
          <textarea
            id="cta-inquiry-message"
            name="message"
            rows="3"
            required
            class="w-full px-4 py-2.5 rounded-helios-sm border border-ink-hairline bg-surface-1 outline-none focus:ring-2 focus:ring-accent-1 resize-none"
          ></textarea>
        </div>
        <div class="sm:col-span-2 space-y-3">
          <button type="submit" class="btn-primary w-full">Submit inquiry</button>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center text-small font-medium text-ink hover:opacity-70"
          >
            Prefer WhatsApp? Chat with sales now
          </a>
          <p id="cta-inquiry-status" class="text-small text-center hidden"></p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .conversion-cta__left {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
    height: 100%;
  }

  .conversion-cta__left--with-links {
    justify-content: center;
  }

  .conversion-cta__title {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.75rem, 3.2vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: #f7f5f0;
  }

  .conversion-cta__site-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.1rem;
    align-items: start;
    width: 100%;
  }

  @media (min-width: 640px) {
    .conversion-cta__site-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .conversion-cta__site-links {
      grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .conversion-cta__site-links > * {
    min-width: 0;
  }

  .conversion-cta__brand-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.45rem;
    min-height: 1.75rem;
  }

  .conversion-cta__logo {
    height: 2rem;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .conversion-cta__brand-name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: #ffffff;
  }

  .conversion-cta__tagline {
    margin: 0;
    max-width: 14rem;
    font-size: 14px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.78);
    white-space: pre-line;
  }

  .conversion-cta__nav-title {
    margin: 0 0 0.55rem;
    min-height: 1.75rem;
    display: flex;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .conversion-cta__nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .conversion-cta__nav-list a {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    color: #ffffff;
    text-decoration: none;
  }

  .conversion-cta__nav-list a:hover {
    opacity: 0.78;
  }

  .conversion-cta__contact-meta {
    margin-top: 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.82);
  }

  .conversion-cta__contact-meta a {
    margin-top: 0.2rem;
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
  }

  .conversion-cta__contact-meta a:hover {
    opacity: 0.78;
  }
</style>

<script>
  const form = document.getElementById('cta-inquiry-form');
  const status = document.getElementById('cta-inquiry-status');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!status) return;
    status.textContent = 'Thanks — your inquiry was captured. Our team will follow up shortly.';
    status.classList.remove('hidden');
    status.classList.add('text-ink');
  });
</script>
