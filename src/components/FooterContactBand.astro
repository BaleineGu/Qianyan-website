---
import { footerLinks, siteConfig, whatsappUrl } from '@/data/site';

interface Props {
  hideBrandMark?: boolean;
}

const { hideBrandMark = false } = Astro.props;
const year = new Date().getFullYear();

const whatsappDisplay = `+${siteConfig.whatsapp.replace(/^(\d{2})(\d+)/, '$1 $2')}`;
---

<section class="footer-contact-band" aria-labelledby="footer-contact-band-heading">
  <div class="footer-contact-band__top">
    <div class="footer-contact-band__intro">
      <h2 id="footer-contact-band-heading" class="footer-contact-band__title">
        Invest in the Future of Housing!
      </h2>
      <p class="footer-contact-band__body">
        Connect with us on WhatsApp for personalized assistance and explore opportunities tailored to
        your business needs.
      </p>
    </div>

    <a
      class="footer-contact-band__whatsapp"
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="footer-contact-band__wa-icon" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M16.02 3.2C9.2 3.2 3.68 8.7 3.68 15.5c0 2.16.57 4.18 1.57 5.94L3.2 28.8l7.58-1.98A12.2 12.2 0 0 0 16.02 27.8c6.82 0 12.34-5.5 12.34-12.3S22.84 3.2 16.02 3.2Zm0 22.5c-1.95 0-3.77-.52-5.35-1.43l-.38-.23-4.5 1.18 1.2-4.38-.25-.4A10.1 10.1 0 0 1 5.9 15.5c0-5.55 4.54-10.06 10.12-10.06 5.58 0 10.12 4.51 10.12 10.06 0 5.55-4.54 10.2-10.12 10.2Zm5.55-7.55c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.96 1.18-.18.2-.35.23-.65.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.14-.14.3-.35.45-.53.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.63-.93-2.23-.24-.58-.5-.5-.68-.5h-.58c-.2 0-.53.08-.8.38-.28.3-1.05 1.03-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.23 5.14 4.53 1.92.83 2.67.9 3.63.76.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"
          />
        </svg>
      </span>
      <span class="footer-contact-band__wa-copy">
        <span class="footer-contact-band__wa-number">{whatsappDisplay}</span>
        <span class="footer-contact-band__wa-label">WhatsApp</span>
      </span>
    </a>
  </div>

  <div class="footer-contact-band__nav">
    <div class="footer-contact-band__brand">
      <div class="footer-contact-band__brand-row">
        {
          !hideBrandMark && (
            <img
              src={siteConfig.logo}
              alt=""
              class="footer-contact-band__logo"
              width="32"
              height="32"
            />
          )
        }
        <span class="footer-contact-band__brand-name">{siteConfig.name}</span>
      </div>
      <p class="footer-contact-band__tagline">{siteConfig.tagline}</p>
      <div class="footer-contact-band__direct">
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <a href={`tel:${siteConfig.phone}`}>{siteConfig.phone}</a>
      </div>
    </div>

    <div>
      <h3 class="footer-contact-band__nav-title">Products</h3>
      <ul class="footer-contact-band__nav-list">
        {
          footerLinks.products.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="footer-contact-band__nav-title">Support</h3>
      <ul class="footer-contact-band__nav-list">
        {
          footerLinks.support.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="footer-contact-band__nav-title">Contact</h3>
      <ul class="footer-contact-band__nav-list">
        {
          footerLinks.contact.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <p class="footer-contact-band__copy">
    &copy; {year} {siteConfig.name}. All rights reserved.
  </p>
</section>

<style>
  .footer-contact-band {
    position: relative;
    z-index: 2;
    background: #1f1d1b;
    color: #f7f5f0;
    border-radius: 0;
    padding: clamp(1.15rem, 2.2vw, 1.6rem) clamp(1rem, 2.5vw, 1.75rem);
    box-shadow: 0 12px 28px rgba(22, 21, 20, 0.22);
  }

  .footer-contact-band__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid rgba(247, 245, 240, 0.14);
  }

  @media (min-width: 800px) {
    .footer-contact-band__top {
      grid-template-columns: minmax(0, 1.5fr) auto;
      gap: 1.5rem;
    }
  }

  .footer-contact-band__title {
    margin: 0 0 0.4rem;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #f7f5f0;
  }

  .footer-contact-band__body {
    margin: 0;
    max-width: 34rem;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(247, 245, 240, 0.72);
  }

  .footer-contact-band__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: #f7f5f0;
    text-decoration: none;
    transition: opacity 200ms ease;
  }

  .footer-contact-band__whatsapp:hover {
    opacity: 0.82;
  }

  .footer-contact-band__wa-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
  }

  .footer-contact-band__wa-icon svg {
    width: 2.1rem;
    height: 2.1rem;
  }

  .footer-contact-band__wa-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    line-height: 1.2;
  }

  .footer-contact-band__wa-number {
    font-size: 16px;
    font-weight: 600;
  }

  .footer-contact-band__wa-label {
    font-size: 12px;
    opacity: 0.72;
  }

  .footer-contact-band__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.25rem;
  }

  @media (min-width: 900px) {
    .footer-contact-band__nav {
      grid-template-columns: minmax(0, 1.25fr) repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  .footer-contact-band__brand-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.4rem;
  }

  .footer-contact-band__logo {
    height: 1.75rem;
    width: auto;
    filter: brightness(0) invert(1);
  }

  .footer-contact-band__brand-name {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    color: #f7f5f0;
  }

  .footer-contact-band__tagline {
    margin: 0;
    max-width: 14rem;
    font-size: 13px;
    line-height: 1.45;
    color: rgba(247, 245, 240, 0.68);
    white-space: pre-line;
  }

  .footer-contact-band__direct {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.55rem;
  }

  .footer-contact-band__direct a {
    font-size: 13px;
    line-height: 1.4;
    color: rgba(247, 245, 240, 0.88);
    text-decoration: none;
    word-break: break-word;
  }

  .footer-contact-band__direct a:hover {
    opacity: 0.8;
  }

  .footer-contact-band__nav-title {
    margin: 0 0 0.55rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(247, 245, 240, 0.55);
  }

  .footer-contact-band__nav-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-contact-band__nav-list a {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
    color: #f7f5f0;
    text-decoration: none;
  }

  .footer-contact-band__nav-list a:hover {
    opacity: 0.78;
  }

  .footer-contact-band__copy {
    margin: 0.9rem 0 0;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(247, 245, 240, 0.14);
    font-size: 12px;
    color: rgba(247, 245, 240, 0.55);
  }
</style>
