---
interface Props {
  theme: string;
  explanation: string;
}

const { theme, explanation } = Astro.props;
---

<section class="py-20 lg:py-28 bg-gray-50">
  <div class="section-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-brand-900 leading-tight">
        {theme}
      </h2>
      <p class="text-lg text-gray-600 leading-relaxed">
        {explanation}
      </p>
    </div>
  </div>
</section>
