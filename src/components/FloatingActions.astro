---
import { whatsappUrl } from '@/data/site';
---

<div
  id="floating-actions"
  class="floating-actions fixed right-4 bottom-4 sm:right-6 sm:bottom-6 z-[60] flex flex-col w-12 sm:w-14 shadow-md"
  aria-label="Quick actions"
>
  <button
    id="back-to-top"
    type="button"
    class="floating-actions__btn floating-actions__btn--top"
    aria-label="Back to top"
    tabindex="-1"
  >
    <svg class="floating-actions__icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path>
    </svg>
  </button>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="floating-actions__btn floating-actions__btn--whatsapp"
    aria-label="Chat on WhatsApp"
  >
    <svg class="floating-actions__icon floating-actions__icon--whatsapp" viewBox="0 0 24 24" aria-hidden="true">
      <path
        fill="currentColor"
        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
      ></path>
    </svg>
  </a>
</div>

<style>
  .floating-actions {
    border: 3px solid #7dd3fc;
    border-radius: 9999px;
    background: #ffffff;
    overflow: hidden;
    transition: box-shadow 200ms ease, border-color 200ms ease;
  }

  .floating-actions:hover {
    box-shadow: 0 10px 24px rgba(14, 116, 144, 0.18);
    border-color: #38bdf8;
  }

  .floating-actions__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 3rem;
    background: #ffffff;
    color: #075985;
    transition: background-color 200ms ease, opacity 200ms ease, max-height 280ms ease;
  }

  @media (min-width: 640px) {
    .floating-actions__btn {
      height: 3.5rem;
    }
  }

  .floating-actions__btn--top {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    overflow: hidden;
    border: 0;
    border-bottom: 1px solid rgba(125, 211, 252, 0.65);
  }

  .floating-actions__btn--whatsapp {
    color: #16a34a;
  }

  .floating-actions__btn--whatsapp:hover {
    background: #f0fdf4;
  }

  .floating-actions__btn--top:hover {
    background: #f0f9ff;
  }

  .floating-actions__icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 640px) {
    .floating-actions__icon {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  .floating-actions.is-expanded .floating-actions__btn--top {
    max-height: 3rem;
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 640px) {
    .floating-actions.is-expanded .floating-actions__btn--top {
      max-height: 3.5rem;
    }
  }
</style>

<script>
  const root = document.getElementById('floating-actions');
  const btn = document.getElementById('back-to-top');

  function updateVisibility() {
    if (!root || !btn) return;
    const expanded = window.scrollY > 320;
    root.classList.toggle('is-expanded', expanded);
    btn.tabIndex = expanded ? 0 : -1;
  }

  btn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('scroll', updateVisibility, { passive: true });
  updateVisibility();
</script>
