---
const panels = [
  {
    title: 'Overview',
    items: [
      { label: 'Company Registration Date', value: '2015-03-16' },
      { label: 'Building Area (㎡)', value: '4000' },
      { label: 'Years of Export Experience', value: '11' },
      { label: 'Years of Industry Experience', value: '11' },
    ],
    icon: 'overview',
  },
  {
    title: 'Production Capacity',
    items: [
      { label: 'Production Lines', value: '40' },
      { label: 'Production Equipment', value: '58' },
      { label: 'Annual Total Output (Units)', value: '900,000' },
    ],
    icon: 'production',
  },
  {
    title: 'Trade Background',
    items: [
      { label: 'Main Market', value: 'Domestic Market (100%)' },
      { label: 'Main Customer Type', value: 'Brand business, Retailer, Engineer, Wholesaler, Manufacturer, For private use' },
      { label: 'Supply Chain Partners', value: '15' },
    ],
    icon: 'trade',
  },
  {
    title: 'R&D Capability',
    items: [
      { label: 'Customization Options', value: 'Sample processing, graphic processing, customized on demand' },
      { label: 'R&D Engineers', value: '1' },
      { label: 'R&D Engineer Education Level', value: '1 graduate' },
    ],
    icon: 'rd',
  },
] as const;
---

<section
  class="feature-cross-section bg-surface-1"
  aria-labelledby="choose-qianyan-heading"
  data-header-theme="light"
>
  <div class="section-container pt-6 sm:pt-8 lg:pt-10 pb-4 sm:pb-5">
    <h2 id="choose-qianyan-heading" class="section-heading text-center">
      Choose Qianyan
    </h2>
  </div>

  <div class="feature-cross-layout">
    <div class="feature-cross-grid">
      {
        panels.map((panel) => (
          <article class="feature-cross-grid__cell">
            <div class="feature-cross-grid__icon" aria-hidden="true">
              {panel.icon === 'overview' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 19V5m0 14h16M8 15V9m4 6V7m4 8v-3" />
                </svg>
              )}
              {panel.icon === 'production' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 19h18M5 19V9l4 2V9l4 2V8l6 3v8" />
                </svg>
              )}
              {panel.icon === 'trade' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.5 17.5 12 4.5l8.5 13H3.5Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v13" />
                </svg>
              )}
              {panel.icon === 'rd' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 3h6v3a3 3 0 0 1-3 3 3 3 0 0 1-3-3V3Z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 9.5 8.5 21h7L14 9.5" />
                </svg>
              )}
            </div>
            <h3 class="feature-cross-grid__title">{panel.title}</h3>
            <dl class="feature-cross-grid__list">
              {panel.items.map((item) => (
                <div class="feature-cross-grid__item">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>

    <figure class="feature-cross-media">
      <img
        src="/images/features/choose-qianyan-factory.png"
        alt="Qianyan factory floor with modular units ready for shipment"
        width="960"
        height="1280"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .feature-cross-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    width: 100%;
    align-items: stretch;
    border-top: 1px solid rgba(22, 21, 20, 0.12);
    border-bottom: 1px solid rgba(22, 21, 20, 0.12);
  }

  .feature-cross-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    min-width: 0;
    background: #ffffff;
  }

  .feature-cross-grid__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.85rem, 1.8vw, 1.35rem);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    min-height: clamp(18rem, 36vw, 26rem);
    text-align: center;
  }

  .feature-cross-grid__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(7.5rem, 28vw, 13.75rem);
    height: clamp(7.5rem, 28vw, 13.75rem);
    flex: none;
    color: inherit;
  }

  .feature-cross-grid__icon svg {
    width: clamp(5rem, 18vw, 8.75rem);
    height: clamp(5rem, 18vw, 8.75rem);
  }

  .feature-cross-grid__title {
    margin: 0;
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
    font-weight: 700;
    line-height: 1.25;
    color: inherit;
  }

  .feature-cross-grid__list {
    margin: 0;
    width: 100%;
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.75rem) clamp(1rem, 2.2vw, 1.75rem);
    align-content: center;
  }

  .feature-cross-grid__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    text-align: center;
  }

  .feature-cross-grid__item dt {
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.4;
    opacity: 0.72;
  }

  .feature-cross-grid__item dd {
    margin: 0;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.35;
    word-break: break-word;
  }

  .feature-cross-media {
    margin: 0;
    overflow: hidden;
    border-radius: 0;
    min-height: 16rem;
    background: #111;
  }

  .feature-cross-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (min-width: 768px) {
    .feature-cross-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-cross-grid__cell:nth-child(1),
    .feature-cross-grid__cell:nth-child(2) {
      border-bottom: 1px solid rgba(22, 21, 20, 0.12);
    }

    .feature-cross-grid__cell:nth-child(odd) {
      border-right: 1px solid rgba(22, 21, 20, 0.12);
    }
  }

  @media (min-width: 1024px) {
    .feature-cross-layout {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    }

    .feature-cross-media {
      min-height: 100%;
      border-left: 1px solid rgba(22, 21, 20, 0.12);
    }
  }

  @media (max-width: 767px) {
    .feature-cross-grid__cell + .feature-cross-grid__cell {
      border-top: 1px solid rgba(22, 21, 20, 0.12);
    }

    .feature-cross-grid__list {
      grid-template-columns: 1fr;
    }
  }
</style>
