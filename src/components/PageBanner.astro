---
interface Props {
  heading: string;
  description: string;
  image?: string;
  /** Tailwind classes for the background image (e.g. object-position) */
  imageClass?: string;
}
const {
  heading,
  description,
  image = '/images/hero/slide-1.png',
  imageClass = '',
} = Astro.props;
---
<section class="page-banner-section bg-surface-1" data-header-theme="dark">
  <div class="section-container py-6 sm:py-8 lg:py-10">
    <div class="page-banner relative overflow-hidden rounded-[12px] text-ink-on-dark">
      <img
        src={image}
        alt=""
        class:list={['absolute inset-0 w-full h-full object-cover', imageClass]}
      />
      <div class="absolute inset-0" style="background: rgba(22, 21, 20, 0.48);"></div>
      <div class="relative max-w-[912px] px-6 sm:px-8 lg:px-10 py-20 sm:py-24 lg:py-28">
        <h1 class="heading-h1 mb-5">{heading}</h1>
        <p class="text-large text-ink-on-dark-soft">{description}</p>
      </div>
    </div>
  </div>
</section>
