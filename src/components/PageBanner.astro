---
interface Props {
  heading: string;
  description: string;
  image?: string;
  /** Tailwind classes for the background image (e.g. object-position) */
  imageClass?: string;
  /** Render supporting copy as h2 when the page needs that hierarchy */
  descriptionAs?: 'p' | 'h2';
  /** Lock banner height to Expandable product-page standard */
  uniformHeight?: boolean;
  /** Prioritize the banner when it is expected to be the page LCP image */
  priority?: boolean;
}
const {
  heading,
  description,
  image = '/images/hero/slide-1.png',
  imageClass = '',
  descriptionAs = 'p',
  uniformHeight = false,
  priority = false,
} = Astro.props;
---
<section
  class:list={[
    'page-banner relative bg-surface-dark text-ink-on-dark overflow-hidden',
    uniformHeight && 'page-hero-uniform',
  ]}
  data-header-theme="dark"
>
  <img
    src={image}
    alt=""
    loading={priority ? 'eager' : undefined}
    fetchpriority={priority ? 'high' : undefined}
    class:list={['absolute inset-0 w-full h-full object-cover', imageClass]}
  />
  <div class="absolute inset-0" style="background: rgba(22, 21, 20, 0.48);"></div>
  <div
    class:list={[
      'relative section-container max-w-[912px]',
      uniformHeight ? 'page-banner__content' : 'py-24 lg:py-32',
    ]}
  >
    <h1 class="heading-h1 mb-5">{heading}</h1>
    {descriptionAs === 'h2' ? (
      <h2 class="page-banner__subheading text-large text-ink-on-dark-soft font-normal !mb-0">
        {description}
      </h2>
    ) : (
      <p class="text-large text-ink-on-dark-soft">{description}</p>
    )}
  </div>
</section>

<style>
  .page-banner__subheading {
    line-height: 1.6;
    letter-spacing: 0;
  }

  .page-banner__content {
    width: 100%;
    padding-block: 1.5rem;
  }
</style>
