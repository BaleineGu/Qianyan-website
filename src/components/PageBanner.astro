---
interface Props {
  heading: string;
  description: string;
  image?: string;
}
const { heading, description, image = '/images/hero/slide-1.jpg' } = Astro.props;
---
<section class="relative bg-brand-900 text-white overflow-hidden">
  <img src={image} alt="" class="absolute inset-0 w-full h-full object-cover opacity-30" />
  <div class="absolute inset-0 bg-brand-900/70"></div>
  <div class="relative section-container py-24 lg:py-32 max-w-4xl">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-5 leading-tight">{heading}</h1>
    <p class="text-lg text-gray-200 leading-relaxed">{description}</p>
  </div>
</section>
