---
const items = [
  {
    image: '/images/features/folding-assembly.png',
    text: 'Easy to assemble—transform your space in just hours instead of months.',
    imageFit: 'cover' as const,
    alt: 'Double-wing container house folding process',
  },
  {
    image: '/images/features/global-logistics.png',
    text: 'Modular products with a compact design that reduce transportation costs.',
    imageFit: 'contain' as const,
    alt: 'Global logistics for modular products',
  },
];
---

<section class="py-16 lg:py-20 bg-gray-50">
  <div class="section-container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {
        items.map((item) => (
          <div class="flex flex-col gap-4">
            <div
              class="feature-media-preview aspect-[16/10] w-full overflow-hidden bg-white border border-gray-200 flex items-center justify-center p-2 sm:p-3 cursor-zoom-in"
              data-preview-src={item.image}
            >
              <img
                src={item.image}
                alt={item.alt}
                class:list={[
                  'w-full h-full',
                  item.imageFit === 'contain' ? 'object-contain' : 'object-cover',
                ]}
                loading="lazy"
              />
            </div>
            <p class="text-base sm:text-lg text-brand-900 font-medium leading-relaxed px-1">
              {item.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<div
  id="feature-media-preview"
  class="feature-media-preview-popup fixed z-[100] pointer-events-none bg-white border border-gray-200 shadow-2xl p-1"
  aria-hidden="true"
>
  <img id="feature-media-preview-img" src="" alt="" class="block max-w-full max-h-full object-contain" />
</div>

<style>
  .feature-media-preview-popup {
    opacity: 0;
    transform: scale(0.72);
    transform-origin: center center;
    visibility: hidden;
    transition:
      opacity 0.28s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.28s;
  }

  .feature-media-preview-popup.is-visible {
    opacity: 1;
    transform: scale(1);
    visibility: visible;
    transition:
      opacity 0.28s ease,
      transform 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-media-preview-popup {
      transition: none;
    }
  }
</style>

<script>
  const preview = document.getElementById('feature-media-preview');
  const previewImg = document.getElementById('feature-media-preview-img') as HTMLImageElement | null;
  const MARGIN = 16;

  function positionPreview(target: HTMLElement) {
    if (!preview) return;
    const rect = target.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Folding process diagram is wide — allow a larger popup.
    const maxW = Math.min(960, vw * 0.72);
    const maxH = vh * 0.86;
    preview.style.maxWidth = `${maxW}px`;
    preview.style.maxHeight = `${maxH}px`;
    if (previewImg) {
      previewImg.style.maxWidth = `${maxW - 8}px`;
      previewImg.style.maxHeight = `${maxH - 8}px`;
    }

    const pw = preview.offsetWidth;
    const ph = preview.offsetHeight;

    let left = rect.right + MARGIN;
    if (left + pw > vw - MARGIN) {
      left = rect.left - MARGIN - pw;
    }
    if (left < MARGIN) {
      left = Math.max(MARGIN, Math.min(vw - pw - MARGIN, rect.right + MARGIN));
    }

    let top = rect.top + rect.height / 2 - ph / 2;
    top = Math.max(MARGIN, Math.min(vh - ph - MARGIN, top));

    preview.style.left = `${left}px`;
    preview.style.top = `${top}px`;
  }

  function showPreview(el: HTMLElement) {
    const src = el.dataset.previewSrc;
    if (!src || !preview || !previewImg) return;

    previewImg.src = src;
    preview.setAttribute('aria-hidden', 'false');

    const placeAndReveal = () => {
      requestAnimationFrame(() => {
        positionPreview(el);
        requestAnimationFrame(() => {
          preview.classList.add('is-visible');
        });
      });
    };

    if (previewImg.complete) {
      placeAndReveal();
    } else {
      previewImg.onload = placeAndReveal;
    }
  }

  function hidePreview() {
    if (!preview) return;
    preview.classList.remove('is-visible');
    preview.setAttribute('aria-hidden', 'true');
  }

  document.querySelectorAll<HTMLElement>('.feature-media-preview').forEach((el) => {
    el.addEventListener('mouseenter', () => showPreview(el));
    el.addEventListener('mouseleave', hidePreview);
  });
</script>
