---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig, whatsappUrl, productCategories } from '@/data/site';
---
<BaseLayout title="About Us" description="Factory-direct prefab modular housing for international B2B buyers.">
  <section class="relative bg-surface-dark text-white overflow-hidden" data-header-theme="dark">
    <img
      src="/images/backgrounds/about-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div class="relative section-container text-center max-w-3xl py-20">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">QIANYAN Metal Manufacturer of Container Houses</h1>
      <p class="text-lg text-gray-300">We specialize in the production of expandable container homes, flat-pack container houses, folding houses, space capsule houses, and container swimming pools, and we offer customization services.</p>
    </div>
  </section>

  <section
    class="about-parallax bg-surface-1"
    data-header-theme="light"
    aria-label="Factory gallery"
  >
    <div class="section-container py-10 sm:py-14 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-2 flex flex-col gap-4 sm:gap-5 lg:gap-6">
          {
            [
              { src: '/images/about/parallax-1.png', alt: 'Integrated House Manufacturing Base exterior' },
              { src: '/images/about/parallax-2.png', alt: 'Container houses lined up inside the factory' },
              { src: '/images/about/parallax-3.png', alt: 'Steel frames for modular container houses' },
            ].map((item, index) => (
              <div class="about-parallax__panel relative overflow-hidden rounded-helios-md border border-ink-hairline bg-surface-2 aspect-[16/10] lg:aspect-auto lg:h-[72vh]">
                <img
                  src={item.src}
                  alt={item.alt}
                  class="about-parallax__image absolute inset-0 w-full h-[120%] max-w-none object-cover object-center will-change-transform"
                  data-parallax-image
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
              </div>
            ))
          }
        </div>

        <aside class="lg:col-span-1 min-h-[12rem] lg:min-h-0">
          <div
            class="about-parallax__copy sticky top-28 lg:top-32 rounded-helios-md border border-dashed border-ink-hairline bg-surface-2/60 px-5 py-6 lg:min-h-[72vh] flex items-start"
            data-parallax-copy
          >
            {/* Text content will be added here */}
            <span class="sr-only">Text content placeholder</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="section-container max-w-3xl space-y-8">
      <div>
        <h2 class="text-2xl font-extrabold text-brand-900 mb-3">Mission</h2>
        <p class="text-lg text-gray-600 leading-relaxed">We help developers, contractors, dealers, and hospitality investors source durable modular housing with clear specifications, customization options, and export-ready delivery support.</p>
      </div>
      <div>
        <h2 class="text-2xl font-extrabold text-brand-900 mb-3">What We Manufacture</h2>
        <ol class="list-decimal pl-5 space-y-2 text-gray-600">
          {productCategories.map((p) => <li><a href={p.href} class="text-brand-600 hover:text-brand-700">{p.name}</a></li>)}
        </ol>
      </div>
      <div>
        <h2 class="text-2xl font-extrabold text-brand-900 mb-3">Brand Values</h2>
        <ul class="list-disc pl-5 space-y-2 text-gray-600">
          <li>Reliable engineering</li>
          <li>Practical project guidance</li>
          <li>Transparent communication</li>
          <li>Flexible customization</li>
          <li>Export-ready delivery support</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-4">
        <button type="button" data-inquiry-open class="btn-primary">Get a Factory Quote</button>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-brand-500 text-brand-600 font-semibold text-sm">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-parallax__image {
    transform: translate3d(0, 0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-parallax__image {
      transform: none !important;
      top: 0 !important;
      height: 100% !important;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const images = Array.from(document.querySelectorAll('[data-parallax-image]'));

  function updateParallax() {
    if (reduceMotion) return;

    images.forEach((img) => {
      const panel = img.parentElement;
      if (!panel) return;

      const rect = panel.getBoundingClientRect();
      const viewH = window.innerHeight || 1;
      const progress = (viewH - rect.top) / (viewH + rect.height);
      const clamped = Math.max(0, Math.min(1, progress));
      const offset = (clamped - 0.5) * -48;
      img.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
    });
  }

  updateParallax();
  window.addEventListener('scroll', updateParallax, { passive: true });
  window.addEventListener('resize', updateParallax);
</script>
