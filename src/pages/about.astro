---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { whatsappUrl } from '@/data/site';

const parallaxSlides = [
  {
    src: '/images/about/parallax-1.png',
    alt: 'Integrated House Manufacturing Base exterior',
    paragraphs: [
      'Our products are widely used in various fields such as engineering construction, temporary office setups, camp dormitories, tourism vacation. We can provide customized solutions according to customer needs. Adhering to the principle of "Quality First, Customer Supreme", we strictly control the production process to ensure that our products are safe, environmentally friendly, and durable.',
      'We undertake large-scale infrastructure, cultural tourism development, and emergency rescue projects, offering a full range of products including dual-wing expandable house, quick-assembly Flat pack prefab house, and folding house. Our standardized production combined with localized installation ensures efficient and hassle-free space setup.',
    ],
  },
  {
    src: '/images/about/parallax-2.png',
    alt: 'Container houses lined up inside the factory',
    paragraphs: [
      'Welcome to our core production base for container homes. These products embody our commitment to quality and design; their modern style and exceptional flexibility perfectly align with contemporary trends, while enabling both standardized manufacturing and personalized customization. Backed by rigorous craftsmanship and efficient processes, we are dedicated to delivering high-quality, mobile housing solutions with rapid turnaround times.',
    ],
  },
  {
    src: '/images/about/parallax-3.png',
    alt: 'Steel frames for modular container houses',
    paragraphs: [
      'Manufacturing craftsmanship determines quality. The structure utilizes galvanized square tubing throughout; even critical connection points feature specialized galvanized hinges, ensuring exceptional stability, smooth operation, and fatigue resistance. To further enhance corrosion and rust resistance, the entire welded frame is finished with an electrostatic powder coating—a process that ensures strong adhesion and results in a highly durable, robust protective layer.',
    ],
  },
];
---
<BaseLayout title="About Us" description="Factory-direct prefab modular housing for international B2B buyers.">
  <section class="relative bg-black text-white overflow-hidden" data-header-theme="dark">
    <img
      src="/images/backgrounds/about-hero.png"
      alt=""
      class="block w-full h-auto"
    />
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="section-container text-center max-w-3xl py-10 sm:py-14">
        <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">QIANYAN Metal Manufacturer of Container Houses</h1>
        <p class="text-lg text-gray-300">We specialize in the production of expandable container homes, flat-pack container houses, folding houses, space capsule houses, and container swimming pools, and we offer customization services.</p>
      </div>
    </div>
  </section>

  <section
    class="about-stack bg-surface-1 px-2 sm:px-3 lg:px-4"
    data-header-theme="light"
    aria-label="Factory gallery"
  >
    {
      parallaxSlides.map((item, index) => (
        <article
          class="about-stack__card sticky top-2 sm:top-3 lg:top-4 grid h-[calc(100svh-1rem)] sm:h-[calc(100svh-1.5rem)] lg:h-[calc(100svh-2rem)] min-h-[600px] grid-rows-[58%_42%] overflow-hidden rounded-helios-lg bg-surface-2 lg:grid-cols-[2fr_1fr] lg:grid-rows-1"
          data-stack-card
          style={`z-index: ${index + 1}`}
        >
          <div class="about-stack__media relative min-h-0 overflow-hidden rounded-helios-md bg-surface-3 m-2 sm:m-3 lg:m-4">
            <img
              src={item.src}
              alt={item.alt}
              class="absolute inset-0 h-full w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>

          <div class="about-stack__copy relative flex min-h-0 items-center bg-surface-2 px-6 py-7 sm:px-10 lg:px-[clamp(2rem,4vw,5rem)] lg:py-16">
            <div class="max-h-full space-y-4 overflow-y-auto text-[clamp(0.9375rem,1.15vw,1.0625rem)] leading-[1.75] text-ink-soft">
              {item.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="py-20 bg-surface-1" data-header-theme="light">
    <div class="section-container max-w-3xl space-y-8 mb-10 sm:mb-12">
      <div>
        <h2 class="text-2xl font-extrabold text-brand-900 mb-3">Trusted quality</h2>
        <p class="text-lg text-gray-600 leading-relaxed">We help developers, contractors, dealers, and hospitality investors source durable modular housing with clear specifications, customization options, and export-ready delivery support.</p>
      </div>
    </div>

    <div
      class="about-quality-grid grid grid-cols-3 grid-rows-2 w-full h-[min(100svh,920px)] min-h-[420px] gap-2 sm:gap-3 lg:gap-4 px-2 sm:px-3 lg:px-4"
      aria-label="Manufacturing quality gallery"
    >
      {
        [
          { src: '/images/about/quality/grid-1.png', alt: 'Factory exterior warehouse' },
          { src: '/images/about/quality/grid-2.png', alt: 'Workers welding steel frames' },
          { src: '/images/about/quality/grid-3.png', alt: 'Modular units on factory floor' },
          { src: '/images/about/quality/grid-4.png', alt: 'Production hall with overhead crane' },
          { src: '/images/about/quality/grid-5.png', alt: 'Finished cabinetry ready for shipment' },
          { src: '/images/about/quality/grid-6.png', alt: 'Workers assembling modular wall panels' },
        ].map((item) => (
          <div class="relative overflow-hidden rounded-helios-sm bg-surface-3">
            <img
              src={item.src}
              alt={item.alt}
              class="absolute inset-0 h-full w-full object-cover object-center"
              loading="lazy"
            />
          </div>
        ))
      }
    </div>

    <div class="section-container max-w-3xl mt-10 sm:mt-12">
      <div class="flex flex-wrap gap-4">
        <button type="button" data-inquiry-open class="btn-primary">Get a Factory Quote</button>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-brand-500 text-brand-600 font-semibold text-sm">Chat on WhatsApp</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-stack__card {
    transform-origin: center top;
    will-change: transform, filter, border-radius;
    box-shadow:
      0 18px 48px rgb(22 21 20 / 0.12),
      0 2px 0 rgb(22 21 20 / 0.04);
    transition:
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 500ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-stack__media {
    isolation: isolate;
  }

  .about-stack__media img {
    transform: scale(1.04);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .about-stack__card.is-current .about-stack__media img {
    transform: scale(1);
  }

  @media (max-width: 1023px) {
    .about-stack__card {
      min-height: calc(100svh - 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-stack__card,
    .about-stack__media img {
      transform: none !important;
      filter: none !important;
      transition: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-card]'));
  let ticking = false;

  function updateStack() {
    const viewportHeight = window.innerHeight || 1;

    cards.forEach((card, index) => {
      const nextCard = cards[index + 1];
      const nextTop = nextCard?.getBoundingClientRect().top ?? viewportHeight;
      const coverProgress = Math.max(0, Math.min(1, (viewportHeight - nextTop) / viewportHeight));

      card.classList.toggle('is-current', nextTop > viewportHeight * 0.5);

      if (!reduceMotion) {
        const scale = 1 - coverProgress * 0.045;
        const brightness = 1 - coverProgress * 0.16;
        card.style.transform = `scale(${scale.toFixed(4)})`;
        card.style.filter = `brightness(${brightness.toFixed(3)})`;
      }
    });
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      updateStack();
      ticking = false;
    });
  }

  updateStack();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
</script>
