---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchPublishedPosts, fetchPostBySlug } from '@/lib/halo';
import {
  fallbackBlogPosts,
  fallbackBlogSlugs,
  type BlogContentBlock,
} from '@/data/blog-fallback';

export async function getStaticPaths() {
  const posts = await fetchPublishedPosts();

  if (posts.length === 0) {
    return fallbackBlogSlugs.map((slug) => ({ params: { slug } }));
  }

  return posts.map((post) => ({
    params: { slug: post.spec.slug },
  }));
}

const { slug } = Astro.params;
const haloPost = await fetchPostBySlug(slug!);
const fallback = fallbackBlogPosts.find((post) => post.slug === slug);

const post: {
  title: string;
  date: string;
  excerpt: string;
  cover: string;
  blocks: BlogContentBlock[];
} = haloPost
  ? {
      title: haloPost.spec.title,
      date: haloPost.spec.publishTime?.split('T')[0] || '',
      excerpt: haloPost.spec.excerpt || '',
      cover: haloPost.spec.cover || '',
      blocks: [],
    }
  : fallback
    ? {
        title: fallback.title,
        date: fallback.date,
        excerpt: fallback.excerpt,
        cover: fallback.cover,
        blocks: fallback.blocks,
      }
    : {
        title: 'Post Not Found',
        date: '',
        excerpt: '',
        cover: '',
        blocks: [{ type: 'text', text: 'This post could not be found.' }],
      };
---

<BaseLayout title={post.title} description={post.excerpt} immersiveBackground>
  <article class="blog-article">
    <section class="blog-article__hero py-20" data-header-theme="light">
      <div class="section-container">
        <div class="blog-article__contrast">
          {post.date && (
            <time class="blog-article__date" datetime={post.date}>
              {post.date}
            </time>
          )}
          <h1 class="blog-article__title">{post.title}</h1>
          {post.excerpt && <p class="blog-article__excerpt">{post.excerpt}</p>}
        </div>
      </div>
    </section>

    {post.cover && (
      <div class="section-container -mt-8 immersive-panel !py-0 overflow-hidden">
        <img
          src={post.cover}
          alt=""
          class="w-full rounded-helios-md aspect-[16/9] object-cover"
        />
      </div>
    )}

    <section class="blog-article__body py-16" data-header-theme="light">
      <div class="section-container">
        <div class="blog-article-body">
          {
            post.blocks.map((block) =>
              block.type === 'image' ? (
                <figure class="blog-article-body__figure">
                  <img
                    src={block.src}
                    alt={block.alt || ''}
                    class="blog-article-body__image"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ) : (
                <p class="blog-article-body__text">{block.text}</p>
              ),
            )
          }
        </div>
        <a href="/blog" class="blog-article__back">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
            ></path>
          </svg>
          Back to Blog
        </a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .blog-article__hero,
  .blog-article__body {
    background: transparent;
  }

  .blog-article__contrast,
  .blog-article-body__text,
  .blog-article__back {
    color: #ffffff;
    mix-blend-mode: difference;
  }

  .blog-article__date {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    opacity: 0.88;
  }

  .blog-article__title {
    margin: 0.75rem 0 1rem;
    font-size: clamp(1.875rem, 4vw, 3rem);
    line-height: 1.15;
    font-weight: 800;
  }

  .blog-article__excerpt {
    margin: 0;
    max-width: 56rem;
    font-size: 1.125rem;
    line-height: 1.7;
    opacity: 0.92;
  }

  .blog-article-body {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .blog-article-body__text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .blog-article-body__figure {
    margin: 0.35rem 0 0.75rem;
    isolation: isolate;
  }

  .blog-article-body__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: #fff;
  }

  .blog-article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .blog-article__back:hover {
    opacity: 0.8;
  }
</style>
