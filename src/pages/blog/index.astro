---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { fetchPublishedPosts, getHaloPostExcerpt, resolveHaloAssetUrl } from '@/lib/halo';
import { fallbackBlogPosts } from '@/data/blog-fallback';

const posts = await fetchPublishedPosts();

const displayPosts =
  posts.length > 0
    ? posts.map((post) => ({
        slug: post.spec.slug,
        title: post.spec.title,
        excerpt: getHaloPostExcerpt(post),
        cover: resolveHaloAssetUrl(post.spec.cover),
        date: post.spec.publishTime?.split('T')[0] || '',
      }))
    : fallbackBlogPosts.map(({ slug, title, excerpt, cover, date }) => ({
        slug,
        title,
        excerpt,
        cover,
        date,
      }));
---

<BaseLayout title="Blog" description="Insights, updates, and engineering stories from HeBei Telaosi Integrated House Co.LTD." immersiveBackground>
  <section class="relative bg-surface-dark text-white overflow-hidden" data-header-theme="dark">
    <img
      src="/images/hero/blog-banner.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0" style="background: rgba(22, 21, 20, 0.42);"></div>
    <div class="relative section-container text-center py-20 lg:py-28">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Blog</h1>
      <p class="text-lg text-white/80 max-w-2xl mx-auto">
        Insights and stories from our engineering team.
      </p>
    </div>
  </section>

  <section class="py-20 bg-surface-1" data-header-theme="light">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          displayPosts.map((post) => (
            <article class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-shadow overflow-hidden border border-gray-100">
              <a href={`/blog/${post.slug}`}>
                {post.cover && (
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={post.cover}
                      alt=""
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </div>
                )}
                <div class="p-6">
                  {post.date && (
                    <time class="text-xs text-gray-400 font-medium" datetime={post.date}>
                      {post.date}
                    </time>
                  )}
                  <h2 class="text-xl font-bold text-brand-900 mt-2 mb-2 group-hover:text-brand-600 transition-colors">
                    {post.title}
                  </h2>
                  <p class="text-sm text-gray-600 leading-relaxed line-clamp-3">{post.excerpt}</p>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
