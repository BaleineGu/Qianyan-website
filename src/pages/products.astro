---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { productCategories } from '@/data/site';
---

<BaseLayout title="Products" description="Explore our full modular housing product lineup.">
  <section class="relative bg-surface-dark text-ink-on-dark overflow-hidden" data-header-theme="dark">
    <img
      src="/images/backgrounds/products-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div class="relative section-container text-center max-w-[680px] py-section-sm lg:py-section-md">
      <h1 class="heading-h1 mb-4">Our products</h1>
      <p class="text-large text-ink-on-dark-soft">
        Factory-direct modular solutions for campsites, hospitality, and project sites.
      </p>
    </div>
  </section>

  <section class="bg-surface-1" data-header-theme="light" aria-label="Product lineup">
    {
      productCategories.map((product, index) => (
        <a
          href={product.href}
          aria-label={product.name}
          class="group block min-h-[100svh] border-b border-ink-hairline last:border-b-0 bg-surface-2 p-3 sm:p-4 lg:p-5"
        >
          <div class="flex h-full min-h-[calc(100svh-1.5rem)] sm:min-h-[calc(100svh-2rem)] lg:min-h-[calc(100svh-2.5rem)] items-center justify-center overflow-hidden rounded-helios-md bg-surface-3 border border-ink-hairline">
            <img
              src={product.image}
              alt={product.name}
              class="max-w-full max-h-[min(88svh,100%)] w-auto h-auto object-contain transition-transform duration-700 group-hover:scale-[1.02]"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          </div>
        </a>
      ))
    }
  </section>
</BaseLayout>
