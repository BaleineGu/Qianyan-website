---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductZigzagList from '@/components/ProductZigzagList.astro';
import ConversionCta from '@/components/ConversionCta.astro';
import { productShowcaseItems } from '@/data/site';
---

<BaseLayout
  title="Products"
  description="Explore our full modular housing product lineup."
  hideFooterBrandMark
  hideFooterGetInTouch
>
  <div class="products-fixed-bg" aria-hidden="true"></div>

  <section class="products-hero relative z-[1]" data-header-theme="light">
    <div class="section-container py-6 sm:py-8 lg:py-10">
      <div class="products-hero__frame relative overflow-hidden rounded-[12px]">
        <img
          src="/images/backgrounds/products-hero.png"
          alt=""
          class="products-hero__bg"
        />
        <div class="products-hero__veil" aria-hidden="true"></div>
        <div class="relative text-center max-w-[680px] mx-auto px-6 sm:px-8 py-section-sm lg:py-section-md">
          <h1 class="heading-h1 mb-4 text-ink">Our products</h1>
          <p class="text-large text-ink-soft">
            Factory-direct modular solutions for campsites, hospitality, and project sites.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="products-page-content relative z-[1]">
    <ProductZigzagList products={[...productShowcaseItems]} />
    <ConversionCta title="Need specs, layouts, or a shipping estimate for your project site?" />
  </div>
</BaseLayout>

<style>
  .products-fixed-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-color: #0d2a36;
    background-image: url('/images/backgrounds/products-page.jpg');
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    image-rendering: -webkit-optimize-contrast;
    filter: contrast(1.08) saturate(1.05);
  }

  .products-hero {
    background: transparent;
    color: #161514;
  }

  .products-hero__frame {
    background: #ffffff;
  }

  .products-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    image-rendering: -webkit-optimize-contrast;
  }

  .products-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(255 255 255 / 0.55) 0%,
      rgb(255 255 255 / 0.72) 55%,
      rgb(255 255 255 / 0.82) 100%
    );
  }

  .products-page-content :global(.product-zigzag) {
    background-color: transparent;
  }
</style>
