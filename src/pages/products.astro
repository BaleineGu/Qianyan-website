---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { products } from '@/data/site';
---

<BaseLayout title="Products" description="Explore HeBei Telaosi Integrated House Co.LTD's full product lineup.">
  <section class="bg-brand-900 text-white py-20">
    <div class="section-container text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Our Products</h1>
      <p class="text-lg text-gray-300 max-w-2xl mx-auto">
        Precision-engineered solutions built for demanding environments and mission-critical operations.
      </p>
    </div>
  </section>

  <section class="py-20">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          products.map((product) => (
            <article class="group bg-white rounded-2xl shadow-sm hover:shadow-lg transition-shadow overflow-hidden border border-gray-100">
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={product.image}
                  alt={product.name}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-8">
                <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider mb-2">
                  {product.tagline}
                </p>
                <h2 class="text-2xl font-bold text-brand-900 mb-3">{product.name}</h2>
                <p class="text-gray-600 leading-relaxed">{product.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
