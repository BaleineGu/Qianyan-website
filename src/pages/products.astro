---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { productCategories } from '@/data/site';
---

<BaseLayout title="Products" description="Explore our full modular housing product lineup.">
  <section class="relative bg-surface-dark text-ink-on-dark overflow-hidden" data-header-theme="dark">
    <img
      src="/images/backgrounds/products-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div class="relative section-container text-center max-w-[680px] py-section-sm lg:py-section-md">
      <h1 class="heading-h1 mb-4">Our products</h1>
      <p class="text-large text-ink-on-dark-soft">
        Factory-direct modular solutions for campsites, hospitality, and project sites.
      </p>
    </div>
  </section>

  <section class="py-section-sm lg:py-section-md bg-surface-1" data-header-theme="light">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {
          productCategories.map((product) => (
            <a
              href={product.href}
              class="group block overflow-hidden rounded-helios-md bg-surface-2 border border-ink-hairline transition-opacity duration-helios hover:opacity-95"
            >
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={product.image}
                  alt={product.name}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                />
              </div>
              <div class="p-6 sm:p-8">
                <h2 class="heading-h5 text-ink mb-3">{product.name}</h2>
                <p class="text-body text-ink-soft">{product.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
