---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { productCategories } from '@/data/site';
---

<BaseLayout title="Products" description="Explore our full modular housing product lineup.">
  <section class="relative bg-surface-dark text-ink-on-dark overflow-hidden" data-header-theme="dark">
    <img
      src="/images/backgrounds/products-hero.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div class="relative section-container text-center max-w-[680px] py-section-sm lg:py-section-md">
      <h1 class="heading-h1 mb-4">Our products</h1>
      <p class="text-large text-ink-on-dark-soft">
        Factory-direct modular solutions for campsites, hospitality, and project sites.
      </p>
    </div>
  </section>

  <section class="bg-surface-1" data-header-theme="light" aria-label="Product lineup">
    {
      productCategories.map((product, index) => {
        const imageLeft = index % 2 === 0;
        return (
          <a
            href={product.href}
            class="group grid min-h-[100svh] lg:h-svh lg:grid-cols-2 overflow-hidden border-b border-ink-hairline last:border-b-0"
          >
            <div
              class:list={[
                'relative min-h-[42svh] lg:min-h-0 lg:h-full overflow-hidden bg-surface-3',
                imageLeft ? 'order-1' : 'order-1 lg:order-2',
              ]}
            >
              <img
                src={product.image}
                alt={product.name}
                class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-[1.03]"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>

            <div
              class:list={[
                'flex flex-col justify-center bg-surface-2 px-6 py-10 sm:px-10 lg:px-[clamp(2.5rem,5vw,5rem)] lg:py-16',
                imageLeft ? 'order-2' : 'order-2 lg:order-1',
              ]}
            >
              <div class="max-w-xl">
                <h2 class="heading-h3 text-ink mb-4 sm:mb-5">{product.name}</h2>
                <p class="text-body text-ink-soft leading-relaxed">{product.description}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-900 group-hover:gap-3 transition-all">
                  View product
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        );
      })
    }
  </section>
</BaseLayout>
