---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCategories from '@/components/ProductCategories.astro';
import { productCategories } from '@/data/site';
---

<BaseLayout
  title="Products"
  description="Factory-direct expandable homes, space capsules, flat pack units, and modular housing systems."
>
  <section class="bg-brand-900 text-white py-20">
    <div class="section-container text-center max-w-3xl">
      <h1 class="text-4xl sm:text-5xl font-extrabold mb-4">Our Products</h1>
      <p class="text-lg text-gray-300">
        Prefab modular housing engineered for developers, contractors, and export buyers.
      </p>
    </div>
  </section>
  <ProductCategories categories={productCategories} />
</BaseLayout>
