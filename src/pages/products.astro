---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductZigzagList from '@/components/ProductZigzagList.astro';
import ConversionCta from '@/components/ConversionCta.astro';
import { productShowcaseItems } from '@/data/site';
---

<BaseLayout
  title="Products"
  description="Explore our full modular housing product lineup."
  hideFooterBrandMark
>
  <section class="products-hero relative overflow-hidden" data-header-theme="dark">
    <img
      src="/images/backgrounds/products-hero.png"
      alt=""
      class="products-hero__bg"
      width="1024"
      height="341"
    />
    <div class="products-hero__veil" aria-hidden="true"></div>
    <div class="products-hero__content section-container text-center max-w-[680px]">
      <h1 class="heading-h1 mb-4 text-ink-on-dark">Our products</h1>
      <p class="text-large text-ink-on-dark-soft">
        Factory-direct modular solutions for campsites, hospitality, and project sites.
      </p>
    </div>
  </section>

  <div class="products-page-content">
    <ProductZigzagList products={[...productShowcaseItems]} />
    <ConversionCta
      title="Need specs, layouts, or a shipping estimate for your project site?"
      includeSiteLinks
    />
  </div>
</BaseLayout>

<style>
  .products-hero {
    background: #0a0a0a;
    color: #f7f5f0;
  }

  /* Height follows banner intrinsic aspect (1024×341 ≈ 3:1) */
  .products-hero__bg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1024 / 341;
    object-fit: cover;
    object-position: center;
    image-rendering: -webkit-optimize-contrast;
  }

  .products-hero__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(0 0 0 / 0.28) 0%,
      rgb(0 0 0 / 0.38) 55%,
      rgb(0 0 0 / 0.48) 100%
    );
    pointer-events: none;
  }

  .products-hero__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-block: clamp(1rem, 3vw, 2.5rem);
  }
</style>
