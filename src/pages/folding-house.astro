---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import { foldingBanner, foldingBenefits, foldingSpecHeaders, foldingSpecs } from '@/data/site';

const foldingActualPhotos = [
  { src: '/images/products/folding-actual/01.png', label: 'Actual product photo 1' },
  { src: '/images/products/folding-actual/02.png', label: 'Actual product photo 2' },
  { src: '/images/products/folding-actual/03.png', label: 'Actual product photo 3' },
  { src: '/images/products/folding-actual/04.png', label: 'Actual product photo 4' },
  { src: '/images/products/folding-actual/05.png', label: 'Actual product photo 5' },
  { src: '/images/products/folding-actual/06.png', label: 'Actual product photo 6' },
  { src: '/images/products/folding-actual/07.png', label: 'Actual product photo 7' },
];

const foldingGridTop = foldingActualPhotos.slice(0, 4);
const foldingGridBottom = foldingActualPhotos.slice(4, 7);
---
<BaseLayout title="Folding House" description={foldingBanner.description}>
  <PageBanner
    heading={foldingBanner.heading}
    description={foldingBanner.description}
    image="/images/hero/folding-banner.png"
  />
  <section class="py-16">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8 text-center">Why Buyers Choose Folding Houses</h2>
      <div class="max-w-xl mx-auto text-center mb-10">
        {foldingBenefits.map((item) => (
          <div class="border-t-2 border-brand-500 pt-6">
            <h3 class="text-lg font-bold text-brand-900 mb-2">{item.title}</h3>
            <p class="text-gray-600">{item.description}</p>
          </div>
        ))}
      </div>
      <div class="folding-advantage-split">
        <div class="folding-advantage-split__video">
          <video autoplay loop muted playsinline preload="metadata" aria-label="Folding house assembly process">
            <source src="/images/features/folding-assembly.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="folding-advantage-split__grid">
          {[
            { src: '/images/products/folding-advantages/01.png', label: 'Folded panel' },
            { src: '/images/products/folding-advantages/02.png', label: 'Unfolding structure' },
            { src: '/images/products/folding-advantages/03.png', label: 'Expanding main body' },
            { src: '/images/products/folding-advantages/04.png', label: 'Final assembled house' },
          ].map((item) => (
            <img
              src={item.src}
              alt={item.label}
              class="folding-advantage-split__image"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="py-16 bg-white">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8 text-center">Actual product photo</h2>
      <div class="folding-photo-grid">
        <div class="folding-photo-grid__row folding-photo-grid__row--top">
          {
            foldingGridTop.map(({ src, label }) => (
              <button
                type="button"
                class="lightbox-trigger folding-photo-grid__item"
                data-lightbox-group="folding-actual"
                data-src={src}
                data-label={label}
                aria-label={`View ${label} full screen`}
              >
                <img src={src} alt={label} class="folding-photo-grid__image" loading="lazy" />
              </button>
            ))
          }
        </div>
        <div class="folding-photo-grid__row folding-photo-grid__row--bottom">
          {
            foldingGridBottom.map(({ src, label }) => (
              <button
                type="button"
                class="lightbox-trigger folding-photo-grid__item"
                data-lightbox-group="folding-actual"
                data-src={src}
                data-label={label}
                aria-label={`View ${label} full screen`}
              >
                <img src={src} alt={label} class="folding-photo-grid__image" loading="lazy" />
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <style>
    .folding-advantage-split {
      display: grid;
      grid-template-columns: 1fr;
      gap: clamp(1rem, 2vw, 1.5rem);
      align-items: stretch;
    }

    .folding-advantage-split__video {
      aspect-ratio: 16 / 9;
      width: 100%;
      overflow: hidden;
      border-radius: 0.5rem;
      border: 1px solid rgb(229 231 235);
      background: #000;
    }

    .folding-advantage-split__video video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .folding-advantage-split__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(0.75rem, 1.5vw, 1.25rem);
    }

    .folding-advantage-split__image {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      object-fit: contain;
      border-radius: 0.5rem;
      border: 1px solid rgb(229 231 235);
      background: #fff;
    }

    @media (min-width: 1024px) {
      .folding-advantage-split {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        align-items: center;
      }

      .folding-advantage-split__video {
        height: 100%;
        min-height: 0;
        aspect-ratio: 16 / 9;
      }
    }

    .folding-photo-grid {
      --folding-grid-gap: clamp(0.75rem, 1.5vw, 1.25rem);
      display: flex;
      flex-direction: column;
      gap: var(--folding-grid-gap);
    }

    .folding-photo-grid__row--top {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--folding-grid-gap);
    }

    .folding-photo-grid__row--bottom {
      display: flex;
      justify-content: center;
      gap: var(--folding-grid-gap);
    }

    .folding-photo-grid__row--bottom .folding-photo-grid__item {
      width: calc((100% - (var(--folding-grid-gap) * 3)) / 4);
    }

    .folding-photo-grid__item {
      margin: 0;
      padding: 0;
      border: 1px solid rgb(229 231 235);
      border-radius: 0.5rem;
      overflow: hidden;
      background: #fff;
      cursor: zoom-in;
    }

    .folding-photo-grid__image {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
    }

    @media (max-width: 767px) {
      .folding-photo-grid__row--top {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .folding-photo-grid__row--bottom {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .folding-photo-grid__row--bottom .folding-photo-grid__item {
        width: auto;
      }

      .folding-photo-grid__row--bottom .folding-photo-grid__item:last-child {
        grid-column: 1 / -1;
        justify-self: center;
        width: calc(50% - (var(--folding-grid-gap) / 2));
      }
    }
  </style>
  <section class="py-16 bg-white">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8">Product Specifications</h2>
      <div class="overflow-x-auto border border-gray-200">
        <table class="w-full min-w-[980px] text-left text-sm">
          <thead class="bg-brand-900 text-white">
            <tr>
              {foldingSpecHeaders.map((h) => (
                <th class="px-3 py-3 whitespace-nowrap">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {foldingSpecs.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-3 py-2.5 font-medium text-brand-900 whitespace-nowrap">{row.category}</td>
                <td class="px-3 py-2.5 text-gray-700 whitespace-nowrap">{row.item}</td>
                <td class="px-3 py-2.5 text-gray-600">{row.material}</td>
                <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap">{row.model}</td>
                <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap">{row.thickness}</td>
                <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap">{row.unit}</td>
                <td class="px-3 py-2.5 text-gray-600 whitespace-nowrap">{row.qty}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Compact horizontal quote strip -->
  <section class="py-8 bg-gray-50 border-t border-gray-200">
    <div class="section-container">
      <form id="folding-quote-form" class="flex flex-col gap-4">
        <div class="flex flex-col lg:flex-row lg:items-end gap-4 lg:gap-3">
          <div class="lg:w-44 shrink-0 lg:pb-0.5">
            <h2 class="text-lg sm:text-xl font-extrabold text-brand-900 leading-tight">Get a Free Quote</h2>
            <p class="text-xs text-gray-500 mt-0.5">Reply within 24h</p>
          </div>
          <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <input
              id="fqf-name"
              name="name"
              type="text"
              required
              placeholder="Full Name *"
              aria-label="Full Name"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fqf-email"
              name="email"
              type="email"
              required
              placeholder="Email *"
              aria-label="Email"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fqf-phone"
              name="phone"
              type="tel"
              placeholder="Phone / WhatsApp"
              aria-label="Phone / WhatsApp"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fqf-qty"
              name="quantity"
              type="number"
              min="1"
              placeholder="Quantity"
              aria-label="Quantity"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fqf-country"
              name="country"
              type="text"
              placeholder="Destination Country"
              aria-label="Destination Country"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
          </div>
          <button
            type="submit"
            class="shrink-0 bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-2.5 rounded transition-colors text-sm tracking-wide whitespace-nowrap"
          >
            Send Request
          </button>
        </div>
        <input
          id="fqf-message"
          name="message"
          type="text"
          placeholder="Additional requirements (optional)"
          aria-label="Additional requirements"
          class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white w-full"
        />
        <p id="fqf-success" class="hidden text-center text-green-600 font-semibold text-sm">Thank you! We'll get back to you within 24 hours.</p>
      </form>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[9999] bg-black/90 hidden items-center justify-center" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl leading-none hover:text-gray-300" aria-label="Close">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Previous">&#8249;</button>
    <button id="lightbox-next" class="absolute right-14 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Next">&#8250;</button>
    <div class="flex flex-col items-center gap-4 max-w-[90vw] max-h-[90vh]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
      <p id="lightbox-label" class="text-white text-sm font-semibold"></p>
    </div>
  </div>
</BaseLayout>

<script>
  type LbItem = { src: string; label: string };
  let groupImages: LbItem[] = [];
  let current = 0;
  const lb = document.getElementById('lightbox') as HTMLDivElement;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbLabel = document.getElementById('lightbox-label') as HTMLParagraphElement;

  function openLightbox(index: number) {
    if (!groupImages.length) return;
    current = ((index % groupImages.length) + groupImages.length) % groupImages.length;
    lbImg.src = groupImages[current].src;
    lbLabel.textContent = groupImages[current].label;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function bindLightbox(btn: HTMLButtonElement) {
    btn.addEventListener('click', () => {
      const group = btn.dataset.lightboxGroup ?? 'default';
      const unique = Array.from(
        document.querySelectorAll<HTMLButtonElement>(`.lightbox-trigger[data-lightbox-group="${group}"]`),
      ).filter((t, _, arr) => arr.findIndex((x) => x.dataset.src === t.dataset.src) === arr.indexOf(t));
      groupImages = unique.map((t) => ({ src: t.dataset.src ?? '', label: t.dataset.label ?? '' }));
      openLightbox(groupImages.findIndex((g) => g.src === btn.dataset.src));
    });
  }

  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach(bindLightbox);
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(current - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(current + 1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(current - 1);
    if (e.key === 'ArrowRight') openLightbox(current + 1);
  });


  const form = document.getElementById('folding-quote-form') as HTMLFormElement | null;
  const success = document.getElementById('fqf-success') as HTMLParagraphElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.querySelectorAll('input,button[type=submit]').forEach((el) => ((el as HTMLInputElement).disabled = true));
    success?.classList.remove('hidden');
  });
</script>
