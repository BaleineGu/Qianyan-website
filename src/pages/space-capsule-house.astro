---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import { capsuleBanner, capsuleModels, capsuleRoi } from '@/data/site';

const roiCards = capsuleRoi.map((item, index) => {
  const images = [
    {
      src: '/images/products/capsule-roi/01.png',
      alt: 'Space capsule unit being lifted by crane',
    },
    {
      src: '/images/products/capsule-roi/02.png',
      alt: 'Space capsule interior living and kitchen space',
    },
    {
      src: '/images/products/capsule-roi/03.png',
      alt: 'Space capsule modular structure exploded diagram',
    },
  ] as const;

  return {
    ...item,
    image: images[index]?.src ?? null,
    imageAlt: images[index]?.alt ?? '',
  };
});
---
<BaseLayout title="Space Capsule House" description={capsuleBanner.description}>
  <PageBanner
    heading={capsuleBanner.heading}
    description={capsuleBanner.description}
    image="/images/hero/capsule-banner.png"
  />

  <section class="py-16 bg-surface-1" data-header-theme="light">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8">B2B Investment & ROI Factors</h2>
      <div class="capsule-roi-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border border-ink-hairline overflow-hidden rounded-helios-md">
        {
          roiCards.map((card, index) => (
            <article class="capsule-roi-card flex flex-col bg-surface-1 min-h-0">
              <div class="relative flex flex-col items-center justify-center text-center px-6 pt-10 pb-6 sm:pt-12 sm:pb-7">
                <span class="capsule-roi-accent" aria-hidden="true" />
                <p class="text-[11px] sm:text-xs tracking-[0.18em] uppercase text-ink-faint mb-3">
                  Product Category
                </p>
                <h3 class="text-xl sm:text-2xl font-bold text-[#9a6b3f] mb-2 leading-tight">
                  {card.title}
                </h3>
                <p class="text-sm sm:text-base text-ink-soft max-w-[18rem] leading-relaxed">
                  {card.description}
                </p>
              </div>

              <div
                class="capsule-roi-media relative mt-auto bg-surface-3 overflow-hidden"
                data-image-slot={`capsule-roi-${index + 1}`}
                aria-label={card.image ? card.imageAlt : `Image placeholder ${index + 1}`}
              >
                {card.image ? (
                  <img
                    src={card.image}
                    alt={card.imageAlt}
                    class="capsule-roi-media__img"
                    loading="lazy"
                  />
                ) : (
                  <div class="min-h-[200px] sm:min-h-[240px]" aria-hidden="true" />
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 bg-gray-50" data-header-theme="light">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8">Product Specification Tiers</h2>
      <div class="capsule-spec-wrap overflow-x-auto rounded-helios-md border border-ink-hairline bg-white">
        <table class="capsule-spec-table w-full min-w-[960px] border-collapse text-sm text-ink">
          <thead>
            <tr class="bg-surface-3 text-left">
              <th scope="col">Model</th>
              <th scope="col">Appearance</th>
              <th scope="col">Floor Plan</th>
              <th scope="col">Product Dimensions</th>
              <th scope="col">Configuration</th>
            </tr>
          </thead>
          <tbody>
            {
              capsuleModels.map((m) => (
                <tr>
                  <td class="capsule-spec-table__model text-center font-semibold">{m.model}</td>
                  <td class="capsule-spec-table__media">
                    {m.appearance ? (
                      <button
                        type="button"
                        class="lightbox-trigger capsule-spec-thumb"
                        data-lightbox-group="capsule-specs"
                        data-src={m.appearance}
                        data-label={`${m.model} Appearance`}
                        aria-label={`View ${m.model} appearance full size`}
                      >
                        <img
                          src={m.appearance}
                          alt={`${m.model} appearance`}
                          class="mx-auto max-h-36 w-auto object-contain"
                          loading="lazy"
                        />
                      </button>
                    ) : (
                      <div class="capsule-spec-placeholder" aria-label={`${m.model} appearance placeholder`} />
                    )}
                  </td>
                  <td class="capsule-spec-table__media">
                    {m.floorPlan ? (
                      <button
                        type="button"
                        class="lightbox-trigger capsule-spec-thumb"
                        data-lightbox-group="capsule-specs"
                        data-src={m.floorPlan}
                        data-label={`${m.model} Floor Plan`}
                        aria-label={`View ${m.model} floor plan full size`}
                      >
                        <img
                          src={m.floorPlan}
                          alt={`${m.model} floor plan`}
                          class="mx-auto max-h-36 w-auto object-contain"
                          loading="lazy"
                        />
                      </button>
                    ) : (
                      <div class="capsule-spec-placeholder" aria-label={`${m.model} floor plan placeholder`} />
                    )}
                  </td>
                  <td class="capsule-spec-table__dims whitespace-pre-line">
                    {`Length: ${m.length}\nWidth: ${m.width}\nHeight: ${m.height}\nArea: ${m.area}`}
                  </td>
                  <td class="capsule-spec-table__config text-ink-soft leading-relaxed">{m.configuration}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[9999] bg-black/90 hidden items-center justify-center" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl leading-none hover:text-gray-300" aria-label="Close">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Previous">&#8249;</button>
    <button id="lightbox-next" class="absolute right-14 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Next">&#8250;</button>
    <div class="flex flex-col items-center gap-4 max-w-[90vw] max-h-[90vh]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
      <p id="lightbox-label" class="text-white text-sm font-semibold"></p>
    </div>
  </div>
</BaseLayout>

<style>
  .capsule-roi-grid > .capsule-roi-card {
    border-bottom: 1px solid rgba(22, 21, 20, 0.12);
  }

  @media (min-width: 640px) {
    .capsule-roi-grid > .capsule-roi-card:nth-child(odd) {
      border-right: 1px solid rgba(22, 21, 20, 0.12);
    }
  }

  @media (min-width: 1024px) {
    .capsule-roi-grid > .capsule-roi-card {
      border-right: 1px solid rgba(22, 21, 20, 0.12);
      border-bottom: none;
    }

    .capsule-roi-grid > .capsule-roi-card:nth-child(3n) {
      border-right: none;
    }
  }

  .capsule-roi-accent {
    position: absolute;
    top: 0;
    left: 50%;
    width: 1px;
    height: 2.25rem;
    transform: translateX(-50%);
    background: #c45c4a;
  }

  /* Match media height to the rightmost diagram (1536×1024) */
  .capsule-roi-media {
    aspect-ratio: 1536 / 1024;
  }

  .capsule-roi-media__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .capsule-spec-table th,
  .capsule-spec-table td {
    border: 1px solid rgba(22, 21, 20, 0.16);
    padding: 0.75rem 0.85rem;
    vertical-align: middle;
  }

  .capsule-spec-table th {
    font-weight: 600;
    white-space: nowrap;
  }

  .capsule-spec-table__model {
    width: 4.5rem;
  }

  .capsule-spec-table__media {
    width: 12rem;
    text-align: center;
  }

  .capsule-spec-table__dims {
    width: 9.5rem;
    white-space: pre-line;
  }

  .capsule-spec-placeholder {
    width: 100%;
    min-height: 5.5rem;
    border-radius: 6px;
    background: rgba(22, 21, 20, 0.04);
  }

  .capsule-spec-thumb {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .capsule-spec-thumb:focus-visible {
    outline: 2px solid #9a6b3f;
    outline-offset: 2px;
  }
</style>

<script>
  type LbItem = { src: string; label: string };
  let groupImages: LbItem[] = [];
  let current = 0;
  const lb = document.getElementById('lightbox') as HTMLDivElement;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbLabel = document.getElementById('lightbox-label') as HTMLParagraphElement;

  function openLightbox(index: number) {
    if (!groupImages.length) return;
    current = (index + groupImages.length) % groupImages.length;
    lbImg.src = groupImages[current].src;
    lbImg.alt = groupImages[current].label;
    lbLabel.textContent = groupImages[current].label;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.lightboxGroup ?? 'default';
      const triggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>(`.lightbox-trigger[data-lightbox-group="${group}"]`),
      );
      groupImages = triggers.map((t) => ({ src: t.dataset.src ?? '', label: t.dataset.label ?? '' }));
      openLightbox(triggers.indexOf(btn));
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(current - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(current + 1));
  lb?.addEventListener('click', (e) => {
    if (e.target === lb) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(current - 1);
    if (e.key === 'ArrowRight') openLightbox(current + 1);
  });
</script>
