---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroCarousel from '@/components/HeroCarousel.astro';
import ProductCategories from '@/components/ProductCategories.astro';
import TrustCapabilities from '@/components/TrustCapabilities.astro';
import { heroSlides, productCategories, trustItems } from '@/data/site';
---

<BaseLayout overlayHeader>
  <HeroCarousel slides={heroSlides} />
  <ProductCategories categories={productCategories} />
  <TrustCapabilities items={trustItems} />
</BaseLayout>
