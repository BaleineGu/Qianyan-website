---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroCarousel from '@/components/HeroCarousel.astro';
import ProductCategories from '@/components/ProductCategories.astro';
import FeatureCrossGrid from '@/components/FeatureCrossGrid.astro';
import CertificateMarquee from '@/components/CertificateMarquee.astro';
import CompanyProfileBanner from '@/components/CompanyProfileBanner.astro';
import LatestBlogPosts from '@/components/LatestBlogPosts.astro';
import ConversionCta from '@/components/ConversionCta.astro';
import {
  heroSlides,
  productCategories,
} from '@/data/site';

const homeProductCategories = productCategories.map((category) => {
  if (category.id === 'expandable') {
    return {
      ...category,
      image: '/images/products/homepage-expandable-container-home.webp',
      imageAlt: 'Expandable container homes with modern modular design and large glass doors',
    };
  }

  if (category.id === 'capsule') {
    return {
      ...category,
      image: '/images/products/homepage-capsule-house.webp',
      imageAlt: 'Capsule House resort in snowy mountain landscape with panoramic glass windows',
    };
  }

  if (category.id === 'flat-pack') {
    return {
      ...category,
      image: '/images/products/homepage-flat-pack-container-house.webp',
      imageAlt: 'Modern prefab container house for residential living and vacation accommodation by a lakeside forest',
    };
  }

  if (category.id === 'folding') {
    return {
      ...category,
      image: '/images/products/homepage-folding-house.webp',
      imageAlt: 'Foldable housing for temporary living and office use',
    };
  }

  if (category.id === 'pools') {
    return {
      ...category,
      image: '/images/products/homepage-container-swimming-pool.webp',
      imageAlt: 'Container swimming pool with wooden deck for backyard outdoor use',
    };
  }

  return category;
});
---
<BaseLayout overlayHeader homePage>
  <HeroCarousel slides={heroSlides} />
  <ProductCategories categories={homeProductCategories} />
  <FeatureCrossGrid />
  <CompanyProfileBanner />
  <CertificateMarquee />
  <LatestBlogPosts />
  <ConversionCta title="Need specs, layouts, or a shipping estimate for your project site?" />
</BaseLayout>
