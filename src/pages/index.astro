---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroCarousel from '@/components/HeroCarousel.astro';
import ProductCategories from '@/components/ProductCategories.astro';
import InteriorSpaceDisplay from '@/components/InteriorSpaceDisplay.astro';
import ManufacturingProcess from '@/components/ManufacturingProcess.astro';
import FeatureCrossGrid from '@/components/FeatureCrossGrid.astro';
import TransportCostReduction from '@/components/TransportCostReduction.astro';
import CertificateMarquee from '@/components/CertificateMarquee.astro';
import CompanyProfileBanner from '@/components/CompanyProfileBanner.astro';
import LatestBlogPosts from '@/components/LatestBlogPosts.astro';
import ConversionCta from '@/components/ConversionCta.astro';
import {
  heroSlides,
  productCategories,
} from '@/data/site';
---
<BaseLayout overlayHeader immersiveBackground>
  <HeroCarousel slides={heroSlides} />
  <ProductCategories categories={productCategories} />
  <InteriorSpaceDisplay />
  <ManufacturingProcess />
  <FeatureCrossGrid />
  <TransportCostReduction />
  <CompanyProfileBanner />
  <CertificateMarquee />
  <LatestBlogPosts />
  <ConversionCta title="Need specs, layouts, or a shipping estimate for your project site?" />
</BaseLayout>
