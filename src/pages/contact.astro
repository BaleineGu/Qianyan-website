---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig, whatsappUrl } from '@/data/site';
---
<BaseLayout title="Contact Us" description="Request a factory quote, WhatsApp consultation, or catalog for your modular housing project." immersiveBackground>
  <section class="bg-surface-dark text-ink-on-dark py-section-sm lg:py-section-md" data-header-theme="dark">
    <div class="section-container text-center max-w-[680px]">
      <h1 class="heading-h1 mb-4">Contact export sales</h1>
      <p class="text-large text-ink-on-dark-soft">Request a factory quote, WhatsApp consultation, or catalog for your modular housing project.</p>
    </div>
  </section>
  <section class="py-section-sm lg:py-section-md bg-surface-1" data-header-theme="light">
    <div class="section-container grid lg:grid-cols-2 gap-12 lg:gap-16">
      <div class="space-y-6">
        <h2 class="heading-h4 text-ink">Contact channels</h2>
        <p class="text-body text-ink-soft">Inquiry first, then WhatsApp, form, or catalog — built for B2B export buyers in US/Canada, Australia/NZ, Middle East, Southeast Asia, and Europe.</p>
        <div>
          <h3 class="label-small text-ink-faint mb-2">Email</h3>
          <a href={`mailto:${siteConfig.email}`} class="text-large font-medium text-ink hover:opacity-70">{siteConfig.email}</a>
        </div>
        <div>
          <h3 class="label-small text-ink-faint mb-2">Phone</h3>
          <a href={`tel:${siteConfig.phone}`} class="text-large font-medium text-ink hover:opacity-70">{siteConfig.phone}</a>
        </div>
        <div class="flex flex-wrap gap-3">
          <button type="button" data-inquiry-open class="btn-primary !bg-ink !text-ink-on-dark">Get a factory quote</button>
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary-light">Chat on WhatsApp</a>
        </div>
      </div>
      <form id="contact-form" class="bg-surface-3 rounded-helios-md p-6 sm:p-8 space-y-5">
        <h2 class="heading-h6 text-ink">Project inquiry form</h2>
        <div>
          <label for="name" class="block text-small font-medium text-ink mb-1">Name</label>
          <input id="name" name="name" required class="w-full px-4 py-3 rounded-helios-sm border border-ink-hairline bg-surface-2 outline-none focus:ring-2 focus:ring-accent-1" />
        </div>
        <div>
          <label for="email" class="block text-small font-medium text-ink mb-1">Email</label>
          <input id="email" name="email" type="email" required class="w-full px-4 py-3 rounded-helios-sm border border-ink-hairline bg-surface-2 outline-none focus:ring-2 focus:ring-accent-1" />
        </div>
        <div>
          <label for="country" class="block text-small font-medium text-ink mb-1">Destination country / zip</label>
          <input id="country" name="country" required class="w-full px-4 py-3 rounded-helios-sm border border-ink-hairline bg-surface-2 outline-none focus:ring-2 focus:ring-accent-1" />
        </div>
        <div>
          <label for="product" class="block text-small font-medium text-ink mb-1">Product interest</label>
          <select id="product" name="product" class="w-full px-4 py-3 rounded-helios-sm border border-ink-hairline bg-surface-2 outline-none focus:ring-2 focus:ring-accent-1">
            <option>Expandable Container Homes</option>
            <option>Space Capsule Houses</option>
            <option>Flat Pack Container Houses</option>
            <option>Folding Houses</option>
            <option>Container Swimming Pools</option>
            <option>Catalog Download</option>
          </select>
        </div>
        <div>
          <label for="message" class="block text-small font-medium text-ink mb-1">Project details</label>
          <textarea id="message" name="message" rows="5" required class="w-full px-4 py-3 rounded-helios-sm border border-ink-hairline bg-surface-2 outline-none focus:ring-2 focus:ring-accent-1 resize-none"></textarea>
        </div>
        <button type="submit" class="btn-primary w-full !bg-ink !text-ink-on-dark">Submit inquiry</button>
        <p id="form-status" class="text-small text-center hidden"></p>
      </form>
    </div>
  </section>
</BaseLayout>
<script>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!status) return;
    status.textContent = 'Thank you. Your inquiry has been received. For faster response, continue on WhatsApp.';
    status.classList.remove('hidden');
    status.classList.add('text-ink');
    form.reset();
  });
</script>
