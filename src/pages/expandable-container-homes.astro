---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import {
  expandableBanner,
  expandableEngineering,
  expandableFaqs,
  expandableSpecHeaders,
  expandableSpecs,
} from '@/data/site';

const actualProductPhotos = Array.from({ length: 13 }, (_, i) => ({
  src: `/images/products/actual/${String(i + 1).padStart(2, '0')}.png`,
  label: `Actual product photo ${i + 1}`,
}));
---
<BaseLayout title="Expandable Container Homes" description={expandableBanner.description}>
  <PageBanner heading={expandableBanner.heading} description={expandableBanner.description} />
  <section class="py-16">
    <div class="section-container max-w-4xl">
      <h2 class="text-2xl font-extrabold text-brand-900 mb-4">Product Advantages</h2>
      <ul class="list-disc pl-5 space-y-2 text-gray-600">
        <li>Fast onsite setup with limited crew</li>
        <li>Expandable living area from a compact shipping footprint</li>
        <li>Factory customization for bedrooms, bathrooms, and finishes</li>
      </ul>
    </div>
  </section>
  <section class="py-16 bg-gray-50">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8">Double-Wing Expandable House Selection Matrix</h2>
      <div class="overflow-x-auto border border-gray-200">
        <table class="w-full min-w-[1080px] text-left text-sm">
          <thead class="bg-brand-900 text-white"><tr>{expandableSpecHeaders.map((h) => <th class="px-4 py-3 whitespace-nowrap">{h}</th>)}</tr></thead>
          <tbody>
            <tr class="bg-white border-b border-gray-200">
              <td class="px-4 py-3 font-medium text-brand-900 whitespace-nowrap">Photo</td>
              {[
                { src: '/images/products/expandable-10ft.png', label: '10ft Double-Wing' },
                { src: '/images/products/expandable-20ft.png', label: '20ft Double-Wing' },
                { src: '/images/products/expandable-20ft-720.png', label: '20ft 720 Twin Wings' },
                { src: '/images/products/expandable-30ft.png', label: '30ft Double-Wing' },
                { src: '/images/products/expandable-40ft.png', label: '40ft Double-Wing' },
              ].map(({ src, label }) => (
                <td class="px-4 py-3">
                  <button class="lightbox-trigger block w-full" data-lightbox-group="specs" data-src={src} data-label={label} aria-label={`View ${label} full screen`}>
                    <img src={src} alt={label} class="w-full max-w-[220px] h-[140px] object-cover rounded hover:opacity-90 transition-opacity cursor-zoom-in" loading="lazy" />
                  </button>
                </td>
              ))}
            </tr>
            {expandableSpecs.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 font-medium text-brand-900 whitespace-nowrap">{row.label}</td>
                {row.values.map((v) => <td class="px-4 py-3 text-gray-600">{v}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Actual Product Photos Carousel -->
  <section class="py-16 bg-white">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8 text-center">Actual Product Photos</h2>
      <div class="relative">
        <button
          id="actual-prev"
          class="absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-gray-300 text-brand-900 shadow hover:bg-gray-50 flex items-center justify-center -ml-2 sm:ml-0"
          aria-label="Previous photos"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>
        <div class="overflow-hidden px-1">
          <div id="actual-track" class="flex gap-4 will-change-transform">
            {actualProductPhotos.map(({ src, label }) => (
              <button
                type="button"
                class="lightbox-trigger flex-shrink-0 w-[260px] sm:w-[300px]"
                data-lightbox-group="actual"
                data-src={src}
                data-label={label}
                aria-label={`View ${label} full screen`}
              >
                <img
                  src={src}
                  alt={label}
                  class="w-full h-[180px] sm:h-[200px] object-cover rounded-lg border border-gray-200 hover:opacity-90 transition-opacity cursor-zoom-in"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        </div>
        <button
          id="actual-next"
          class="absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-10 rounded-full bg-white border border-gray-300 text-brand-900 shadow hover:bg-gray-50 flex items-center justify-center -mr-2 sm:mr-0"
          aria-label="Next photos"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Quote Request Section -->
  <section class="py-20 bg-gray-50">
    <div class="section-container max-w-3xl">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-3">Get a Free Quote</h2>
        <p class="text-gray-500">Tell us your requirements and we'll respond within 24 hours with pricing and availability.</p>
      </div>
      <form id="quote-form" class="grid sm:grid-cols-2 gap-5">
        <div class="flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-name">Full Name <span class="text-red-500">*</span></label>
          <input id="qf-name" name="name" type="text" required placeholder="John Smith" class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-email">Email <span class="text-red-500">*</span></label>
          <input id="qf-email" name="email" type="email" required placeholder="you@company.com" class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-phone">Phone / WhatsApp</label>
          <input id="qf-phone" name="phone" type="tel" placeholder="+1 234 567 8900" class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-model">Product Model</label>
          <select id="qf-model" name="model" class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white">
            <option value="">-- Select Model --</option>
            <option>10ft Double-Wing</option>
            <option>20ft Double-Wing</option>
            <option>20ft 720 Twin Wings</option>
            <option>30ft Double-Wing</option>
            <option>40ft Double-Wing</option>
            <option>Other / Not sure</option>
          </select>
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-qty">Quantity</label>
          <input id="qf-qty" name="quantity" type="number" min="1" placeholder="e.g. 5" class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-country">Destination Country</label>
          <input id="qf-country" name="country" type="text" placeholder="e.g. United States" class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500" />
        </div>
        <div class="sm:col-span-2 flex flex-col gap-1">
          <label class="text-sm font-semibold text-brand-900" for="qf-message">Additional Requirements</label>
          <textarea id="qf-message" name="message" rows="4" placeholder="Describe customization needs, delivery timeline, use case, etc." class="border border-gray-300 rounded px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"></textarea>
        </div>
        <div class="sm:col-span-2">
          <button type="submit" class="w-full bg-brand-900 hover:bg-brand-800 text-white font-bold py-3 rounded transition-colors text-sm tracking-wide">
            Send Quote Request
          </button>
          <p id="qf-success" class="hidden text-center text-green-600 font-semibold mt-4">Thank you! We'll get back to you within 24 hours.</p>
        </div>
      </form>
    </div>
  </section>

  <section class="py-16">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8">Engineering Details & Customization</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {expandableEngineering.map((item) => (
          <div><h3 class="text-lg font-bold text-brand-900 mb-2">{item.title}</h3><p class="text-gray-600">{item.description}</p></div>
        ))}
      </div>
    </div>
  </section>
  <section class="py-16 bg-gray-50">
    <div class="section-container max-w-4xl space-y-4">
      <h2 class="text-2xl font-extrabold text-brand-900 mb-6">FAQ</h2>
      {expandableFaqs.map((item) => (
        <details class="border border-gray-200 bg-white">
          <summary class="px-5 py-4 font-bold text-brand-900 cursor-pointer">{item.q}</summary>
          <p class="px-5 pb-4 text-gray-600 border-t border-gray-100 pt-3">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- Lightbox overlay -->
  <div id="lightbox" class="fixed inset-0 z-[9999] bg-black/90 hidden items-center justify-center" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl leading-none hover:text-gray-300" aria-label="Close">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Previous">&#8249;</button>
    <button id="lightbox-next" class="absolute right-14 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Next">&#8250;</button>
    <div class="flex flex-col items-center gap-4 max-w-[90vw] max-h-[90vh]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
      <p id="lightbox-label" class="text-white text-sm font-semibold"></p>
    </div>
  </div>

</BaseLayout>

<script>
  // Lightbox (grouped)
  type LbItem = { src: string; label: string };
  let groupImages: LbItem[] = [];
  let current = 0;
  const lb = document.getElementById('lightbox') as HTMLDivElement;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbLabel = document.getElementById('lightbox-label') as HTMLParagraphElement;

  function openLightbox(index: number) {
    if (!groupImages.length) return;
    current = (index + groupImages.length) % groupImages.length;
    lbImg.src = groupImages[current].src;
    lbLabel.textContent = groupImages[current].label;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function bindLightbox(btn: HTMLButtonElement) {
    btn.addEventListener('click', () => {
      const group = btn.dataset.lightboxGroup ?? 'default';
      const triggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>(`.lightbox-trigger[data-lightbox-group="${group}"]`),
      ).filter((t, _, arr) => arr.findIndex((x) => x.dataset.src === t.dataset.src) === arr.indexOf(t));
      groupImages = triggers.map((t) => ({ src: t.dataset.src ?? '', label: t.dataset.label ?? '' }));
      openLightbox(groupImages.findIndex((g) => g.src === btn.dataset.src));
    });
  }

  // Clone carousel slides first so lightbox binds to originals + clones once
  const track = document.getElementById('actual-track') as HTMLDivElement | null;
  let setCount = 0;
  if (track) {
    const originals = Array.from(track.children);
    setCount = originals.length;
    originals.forEach((node) => track.appendChild(node.cloneNode(true)));
  }

  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach(bindLightbox);
  document.getElementById('lightbox-close')!.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')!.addEventListener('click', () => openLightbox(current - 1));
  document.getElementById('lightbox-next')!.addEventListener('click', () => openLightbox(current + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') openLightbox(current - 1);
      if (e.key === 'ArrowRight') openLightbox(current + 1);
    }
  });

  // Infinite loop carousel for Actual Product Photos (CSS transform)
  if (track && setCount > 0) {
    const gap = () => {
      const style = getComputedStyle(track);
      return parseFloat(style.columnGap || style.gap || '16') || 16;
    };
    const step = () => {
      const first = track.children[0] as HTMLElement | undefined;
      return first ? first.offsetWidth + gap() : 300;
    };
    let index = 0;
    let animating = false;

    const apply = (animate: boolean) => {
      track.style.transition = animate ? 'transform 0.45s ease' : 'none';
      track.style.transform = `translateX(${-index * step()}px)`;
    };

    const normalize = () => {
      if (index >= setCount) {
        index -= setCount;
        apply(false);
      }
    };

    const go = (dir: number) => {
      if (animating) return;
      animating = true;
      // Jump into the cloned half before animating left from the first slide
      if (dir < 0 && index === 0) {
        index = setCount;
        apply(false);
        void track.offsetWidth;
      }
      index += dir;
      apply(true);
      window.setTimeout(() => {
        normalize();
        animating = false;
      }, 480);
    };

    let timer: ReturnType<typeof setInterval> | null = null;
    const stopAuto = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };
    const startAuto = () => {
      stopAuto();
      timer = setInterval(() => go(1), 3500);
    };

    document.getElementById('actual-prev')?.addEventListener('click', () => {
      go(-1);
      startAuto();
    });
    document.getElementById('actual-next')?.addEventListener('click', () => {
      go(1);
      startAuto();
    });

    const shell = track.parentElement;
    shell?.addEventListener('mouseenter', stopAuto);
    shell?.addEventListener('mouseleave', startAuto);
    window.addEventListener('resize', () => apply(false));
    apply(false);
    startAuto();
  }

  // Quote form mock submit
  const form = document.getElementById('quote-form') as HTMLFormElement;
  const success = document.getElementById('qf-success') as HTMLParagraphElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    form.querySelectorAll('input,select,textarea,button[type=submit]').forEach((el) => ((el as HTMLInputElement).disabled = true));
    success.classList.remove('hidden');
  });
</script>
