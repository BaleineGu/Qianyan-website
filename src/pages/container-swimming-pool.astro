---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import { poolBanner, poolConfigHeaders, poolConfigRows } from '@/data/site';
---
<BaseLayout title="Container Swimming Pool" description={poolBanner.description} immersiveBackground>
  <PageBanner
    heading={poolBanner.heading}
    description={poolBanner.description}
    image="/images/hero/pool-banner.png"
    imageClass="object-center"
  />
  <section class="py-16 bg-gray-50">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-10 text-center">Use Cases</h2>
      <div class="pool-usecase-stack grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto md:pb-12">
        {[
          { src: '/images/products/pool-usecases/01.png', label: 'Rooftop hotel terrace' },
          { src: '/images/products/pool-usecases/02.png', label: 'Garden leisure pool' },
          { src: '/images/products/pool-usecases/03.png', label: 'Villa courtyard pool' },
          { src: '/images/products/pool-usecases/04.png', label: 'Backyard spa pool' },
        ].map((item, i) => (
          <article
            class:list={[
              'pool-usecase-card relative overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg',
              i % 2 === 1 && 'md:translate-y-12',
              i >= 2 && 'md:-mt-6',
            ]}
          >
            <button
              type="button"
              class="lightbox-trigger block w-full"
              data-lightbox-group="usecases"
              data-src={item.src}
              data-label={item.label}
              aria-label={`View ${item.label} full screen`}
            >
              <img
                src={item.src}
                alt={item.label}
                class="w-full aspect-[16/10] object-cover hover:opacity-90 transition-opacity cursor-zoom-in"
                loading="lazy"
              />
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="py-16 bg-white">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8">Swimming Pool Configuration List</h2>
      <div class="overflow-x-auto border border-gray-200">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead class="bg-brand-900 text-white">
            <tr>
              {poolConfigHeaders.map((h) => (
                <th class="px-4 py-3 whitespace-nowrap">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {poolConfigRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-4 py-3 font-medium text-brand-900 whitespace-nowrap">{row.category}</td>
                <td class="px-4 py-3 text-gray-700 whitespace-nowrap">{row.component}</td>
                <td class="px-4 py-3 text-gray-600">{row.specification}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="py-16 bg-gray-50">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-10 text-center">Actual photos of the factory swimming pool</h2>
      <div class="pool-factory-stack grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 max-w-5xl mx-auto md:pb-12">
        {[
          { src: '/images/products/pool-factory/01.png', label: 'Factory pool — orange panel finish' },
          { src: '/images/products/pool-factory/02.png', label: 'Factory pool — black container with viewing window' },
          { src: '/images/products/pool-factory/03.png', label: 'Factory pool — interior liner view' },
          { src: '/images/products/pool-factory/04.png', label: 'Factory pool — black slat exterior' },
        ].map((item, i) => (
          <article
            class:list={[
              'pool-factory-card relative overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg',
              i % 2 === 1 && 'md:translate-y-12',
              i >= 2 && 'md:-mt-6',
            ]}
          >
            <button
              type="button"
              class="lightbox-trigger block w-full"
              data-lightbox-group="factory"
              data-src={item.src}
              data-label={item.label}
              aria-label={`View ${item.label} full screen`}
            >
              <img
                src={item.src}
                alt={item.label}
                class="w-full aspect-[16/10] object-cover hover:opacity-90 transition-opacity cursor-zoom-in"
                loading="lazy"
              />
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="py-16 bg-white">
    <div class="section-container">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-stretch">
        <div class="flex flex-col justify-center items-center text-center h-full min-h-[280px] lg:min-h-full lg:self-stretch">
          <h2 class="text-2xl font-extrabold text-brand-900 mb-4">Planning Notes for Buyers</h2>
          <ul class="list-disc pl-5 space-y-2 text-gray-600 text-left inline-block">
            <li>Pool size and depth options</li>
            <li>Filtration and maintenance requirements</li>
            <li>Installation interface with decks and landscaping</li>
            <li>Shipping cost to destination port / site</li>
          </ul>
        </div>
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 sm:p-8">
          <div class="text-center mb-6">
            <h2 class="text-2xl font-extrabold text-brand-900 mb-2">Get a Free Quote</h2>
            <p class="text-sm text-gray-500">Tell us your requirements and we'll respond within 24 hours with pricing and availability.</p>
          </div>
          <form id="pool-quote-form" class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-name">Full Name <span class="text-red-500">*</span></label>
              <input id="pqf-name" name="name" type="text" required placeholder="John Smith" class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-email">Email <span class="text-red-500">*</span></label>
              <input id="pqf-email" name="email" type="email" required placeholder="you@company.com" class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-phone">Phone / WhatsApp</label>
              <input id="pqf-phone" name="phone" type="tel" placeholder="+1 234 567 8900" class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-model">Product Model</label>
              <select id="pqf-model" name="model" class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white">
                <option value="">-- Select Model --</option>
                <option>Container Swimming Pool</option>
                <option>Custom Pool Size</option>
                <option>Other / Not sure</option>
              </select>
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-qty">Quantity</label>
              <input id="pqf-qty" name="quantity" type="number" min="1" placeholder="e.g. 5" class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            </div>
            <div class="flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-country">Destination Country</label>
              <input id="pqf-country" name="country" type="text" placeholder="e.g. United States" class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white" />
            </div>
            <div class="sm:col-span-2 flex flex-col gap-1">
              <label class="text-sm font-semibold text-brand-900" for="pqf-message">Additional Requirements</label>
              <textarea id="pqf-message" name="message" rows="3" placeholder="Describe customization needs, delivery timeline, use case, etc." class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none bg-white"></textarea>
            </div>
            <div class="sm:col-span-2">
              <button type="submit" class="w-full bg-brand-900 hover:bg-brand-800 text-white font-bold py-3 rounded transition-colors text-sm tracking-wide">
                Send Quote Request
              </button>
              <p id="pqf-success" class="hidden text-center text-green-600 font-semibold mt-3 text-sm">Thank you! We'll get back to you within 24 hours.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[9999] bg-black/90 hidden items-center justify-center" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl leading-none hover:text-gray-300" aria-label="Close">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Previous">&#8249;</button>
    <button id="lightbox-next" class="absolute right-14 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Next">&#8250;</button>
    <div class="flex flex-col items-center gap-4 max-w-[90vw] max-h-[90vh]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
      <p id="lightbox-label" class="text-white text-sm font-semibold"></p>
    </div>
  </div>
</BaseLayout>

<script>
  type LbItem = { src: string; label: string };
  let groupImages: LbItem[] = [];
  let current = 0;
  const lb = document.getElementById('lightbox') as HTMLDivElement;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbLabel = document.getElementById('lightbox-label') as HTMLParagraphElement;

  function openLightbox(index: number) {
    if (!groupImages.length) return;
    current = (index + groupImages.length) % groupImages.length;
    lbImg.src = groupImages[current].src;
    lbLabel.textContent = groupImages[current].label;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.lightboxGroup ?? 'default';
      const triggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>(`.lightbox-trigger[data-lightbox-group="${group}"]`),
      );
      groupImages = triggers.map((t) => ({ src: t.dataset.src ?? '', label: t.dataset.label ?? '' }));
      openLightbox(triggers.indexOf(btn));
    });
  });
  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(current - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(current + 1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(current - 1);
    if (e.key === 'ArrowRight') openLightbox(current + 1);
  });

  const form = document.getElementById('pool-quote-form') as HTMLFormElement | null;
  const success = document.getElementById('pqf-success') as HTMLParagraphElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.querySelectorAll('input,select,textarea,button[type=submit]').forEach((el) => {
      (el as HTMLInputElement).disabled = true;
    });
    success?.classList.remove('hidden');
  });
</script>
