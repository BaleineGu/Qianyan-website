---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import TransportCostReduction from '@/components/TransportCostReduction.astro';
import {
  flatPackAdvantageGallery,
  flatPackAdvantages,
  flatPackBanner,
  flatPackProductRows,
  flatPackStandardBox,
} from '@/data/site';
---
<BaseLayout title="Flat Pack Container House" description={flatPackBanner.description} immersiveBackground>
  <PageBanner
    heading={flatPackBanner.heading}
    description={flatPackBanner.description}
    image="/images/hero/flatpack-banner.png"
    imageClass="object-center"
  />
  <section class="py-16">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8 text-center max-w-4xl mx-auto">
        It is not enough to simply choose the right option; one must also choose the good one.
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        {flatPackAdvantages.map((item) => (
          <div class="border-t-2 border-brand-500 pt-6">
            <h3 class="text-lg font-bold text-brand-900 mb-2">{item.title}</h3>
            <p class="text-gray-600">{item.description}</p>
            {item.image && (
              <img
                src={item.image}
                alt={item.title}
                class="mt-4 w-full h-44 object-cover rounded-lg border border-gray-200"
                loading="lazy"
              />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="py-16 bg-gray-50">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8 text-center">
        Practical application cases
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        {flatPackAdvantageGallery.map((item) => (
          <div class="border-t-2 border-brand-500 pt-6">
            {item.title ? <h3 class="text-lg font-bold text-brand-900 mb-2">{item.title}</h3> : null}
            {item.description ? <p class="text-gray-600 mb-4">{item.description}</p> : null}
            <button
              type="button"
              class="lightbox-trigger block w-full text-left"
              data-lightbox-group="cases"
              data-src={item.image}
              data-label={item.alt}
              aria-label={`View ${item.alt} full screen`}
            >
              <span class="block w-full aspect-[4/3] overflow-hidden rounded-lg border border-gray-200 bg-white">
                <img
                  src={item.image}
                  alt={item.alt}
                  class="w-full h-full object-cover hover:opacity-90 transition-opacity cursor-zoom-in"
                  loading="lazy"
                />
              </span>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TransportCostReduction />

  <section class="py-16 bg-white">
    <div class="section-container">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-900 mb-4 text-center">Product Description</h2>
      <p class="text-base sm:text-lg text-gray-700 text-center max-w-4xl mx-auto mb-8 leading-relaxed">
        <span class="font-semibold text-brand-900">Standard box — </span>{flatPackStandardBox}
      </p>
      <div class="overflow-x-auto border border-gray-200">
        <table class="w-full min-w-[720px] text-left text-sm">
          <thead class="bg-brand-900 text-white">
            <tr>
              <th class="px-3 py-3 whitespace-nowrap">Category</th>
              <th class="px-3 py-3 whitespace-nowrap">Item</th>
              <th class="px-3 py-3">Specification</th>
            </tr>
          </thead>
          <tbody>
            {flatPackProductRows.map((row, i) => (
              <tr class={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                <td class="px-3 py-2.5 font-medium text-brand-900 whitespace-nowrap align-top">{row.category}</td>
                <td class="px-3 py-2.5 text-gray-700 whitespace-nowrap align-top">{row.item}</td>
                <td class="px-3 py-2.5 text-gray-600 align-top">{row.detail}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Compact horizontal quote strip -->
  <section class="py-8 bg-gray-50 border-t border-gray-200">
    <div class="section-container">
      <form id="flatpack-quote-form" class="flex flex-col gap-4">
        <div class="flex flex-col lg:flex-row lg:items-end gap-4 lg:gap-3">
          <div class="lg:w-44 shrink-0 lg:pb-0.5">
            <h2 class="text-lg sm:text-xl font-extrabold text-brand-900 leading-tight">Get a Free Quote</h2>
            <p class="text-xs text-gray-500 mt-0.5">Reply within 24h</p>
          </div>
          <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <input
              id="fpqf-name"
              name="name"
              type="text"
              required
              placeholder="Full Name *"
              aria-label="Full Name"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fpqf-email"
              name="email"
              type="email"
              required
              placeholder="Email *"
              aria-label="Email"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fpqf-phone"
              name="phone"
              type="tel"
              placeholder="Phone / WhatsApp"
              aria-label="Phone / WhatsApp"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fpqf-qty"
              name="quantity"
              type="number"
              min="1"
              placeholder="Quantity"
              aria-label="Quantity"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
            <input
              id="fpqf-country"
              name="country"
              type="text"
              placeholder="Destination Country"
              aria-label="Destination Country"
              class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white"
            />
          </div>
          <button
            type="submit"
            class="shrink-0 bg-brand-900 hover:bg-brand-800 text-white font-bold px-6 py-2.5 rounded transition-colors text-sm tracking-wide whitespace-nowrap"
          >
            Send Request
          </button>
        </div>
        <input
          id="fpqf-message"
          name="message"
          type="text"
          placeholder="Additional requirements (optional)"
          aria-label="Additional requirements"
          class="border border-gray-300 rounded px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-500 bg-white w-full"
        />
        <p id="fpqf-success" class="hidden text-center text-green-600 font-semibold text-sm">Thank you! We'll get back to you within 24 hours.</p>
      </form>
    </div>
  </section>

  <div id="lightbox" class="fixed inset-0 z-[9999] bg-black/90 hidden items-center justify-center" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl leading-none hover:text-gray-300" aria-label="Close">&times;</button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Previous">&#8249;</button>
    <button id="lightbox-next" class="absolute right-14 top-1/2 -translate-y-1/2 text-white text-4xl leading-none hover:text-gray-300 px-2" aria-label="Next">&#8250;</button>
    <div class="flex flex-col items-center gap-4 max-w-[90vw] max-h-[90vh]">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
      <p id="lightbox-label" class="text-white text-sm font-semibold"></p>
    </div>
  </div>
</BaseLayout>

<script>
  type LbItem = { src: string; label: string };
  let groupImages: LbItem[] = [];
  let current = 0;
  const lb = document.getElementById('lightbox') as HTMLDivElement;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbLabel = document.getElementById('lightbox-label') as HTMLParagraphElement;

  function openLightbox(index: number) {
    if (!groupImages.length) return;
    current = ((index % groupImages.length) + groupImages.length) % groupImages.length;
    lbImg.src = groupImages[current].src;
    lbImg.alt = groupImages[current].label;
    lbLabel.textContent = groupImages[current].label;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeLightbox() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.lightboxGroup ?? 'default';
      const triggers = Array.from(
        document.querySelectorAll<HTMLButtonElement>(`.lightbox-trigger[data-lightbox-group="${group}"]`),
      );
      groupImages = triggers.map((t) => ({ src: t.dataset.src ?? '', label: t.dataset.label ?? '' }));
      openLightbox(triggers.indexOf(btn));
    });
  });

  document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => openLightbox(current - 1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => openLightbox(current + 1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLightbox(); });
  document.addEventListener('keydown', (e) => {
    if (!lb || lb.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') openLightbox(current - 1);
    if (e.key === 'ArrowRight') openLightbox(current + 1);
  });

  const form = document.getElementById('flatpack-quote-form') as HTMLFormElement | null;
  const success = document.getElementById('fpqf-success') as HTMLParagraphElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.querySelectorAll('input,button[type=submit]').forEach((el) => ((el as HTMLInputElement).disabled = true));
    success?.classList.remove('hidden');
  });

  const transportForm = document.getElementById('transport-quote-form') as HTMLFormElement | null;
  const transportSuccess = document.getElementById('tqf-success') as HTMLParagraphElement | null;
  transportForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    transportForm
      .querySelectorAll('input,select,textarea,button[type=submit]')
      .forEach((el) => ((el as HTMLInputElement).disabled = true));
    transportSuccess?.classList.remove('hidden');
  });
</script>
