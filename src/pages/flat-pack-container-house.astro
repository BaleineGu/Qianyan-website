---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageBanner from '@/components/PageBanner.astro';
import {
  flatPackAdvantageGallery,
  flatPackAdvantages,
  flatPackBanner,
} from '@/data/site';
---
<BaseLayout title="Flat Pack Container House" description={flatPackBanner.description}>
  <PageBanner heading={flatPackBanner.heading} description={flatPackBanner.description} />
  <section class="py-16">
    <div class="section-container">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-900 mb-8 text-center max-w-4xl mx-auto">
        It is not enough to simply choose the right option; one must also choose the good one.
      </h2>
      <div class="grid md:grid-cols-3 gap-8">
        {flatPackAdvantages.map((item) => (
          <div class="border-t-2 border-brand-500 pt-6">
            <h3 class="text-lg font-bold text-brand-900 mb-2">{item.title}</h3>
            <p class="text-gray-600">{item.description}</p>
            {item.image && (
              <img
                src={item.image}
                alt={item.title}
                class="mt-4 w-full h-44 object-cover rounded-lg border border-gray-200"
                loading="lazy"
              />
            )}
          </div>
        ))}
      </div>
      <div class="grid md:grid-cols-3 gap-8 mt-8">
        {flatPackAdvantageGallery.map((item) => (
          <div class="border-t-2 border-brand-500 pt-6">
            {item.title ? <h3 class="text-lg font-bold text-brand-900 mb-2">{item.title}</h3> : null}
            {item.description ? <p class="text-gray-600">{item.description}</p> : null}
            <img
              src={item.image}
              alt={item.alt}
              class={`w-full h-44 object-cover rounded-lg border border-gray-200 ${item.title || item.description ? 'mt-4' : ''}`}
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
