# Halo Headless CMS (build-time only).
# Leave empty for local development with the built-in fallback posts.
# Example: HALO_API_URL=http://localhost:8090
HALO_API_URL=
# Optional: public posts do not require a token.
HALO_API_TOKEN=

# Public site URL (used for sitemap and meta)
SITE_URL=https://example.com
